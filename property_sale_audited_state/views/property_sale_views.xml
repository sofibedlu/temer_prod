<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_sale_form_inherit_audited" model="ir.ui.view">
        <field name="name">property.sale.form.inherit.audited</field>
        <field name="model">property.sale</field>
        <field name="inherit_id" ref="advanced_property_management.property_sale_view_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//header" position="inside">
            
                <button name="action_mark_as_audited" 
                        string="Mark as Audited" 
                        type="object" 
                        class="btn-info"
                        icon="fa-archive"
                        invisible="state != 'approve'"
                        groups="property_sale_audited_state.group_property_sale_auditor"
                        confirm="Are you sure you want to mark this contract as audited?"/>
            </xpath>

            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="statusbar_visible">draft,request_for_confirm,confirm,check,approve,audited,done,void</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_property_sale_tree_inherit_audit" model="ir.ui.view">
        <field name="name">property.sale.tree.inherit.audit</field>
        <field name="model">property.sale</field>
        <field name="inherit_id" ref="advanced_property_management.property_sale_view_tree"/>
        <field name="arch" type="xml">

            <xpath expr="//tree" position="attributes">
                <attribute name="decoration-success">state in ['audited', 'approve']</attribute>
            </xpath>

            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="decoration-success">state in ['audited', 'approve']</attribute>
            </xpath>

        </field>
    </record>
</odoo>
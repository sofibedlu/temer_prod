<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Main Menu - Visible to all users -->
    <menuitem id="menu_sales_plan_root"
              name="Sales Planning"
              sequence="100"
              groups="base.group_user"/>

    <menuitem id="menu_sales_plan"
              name="Sales Plans"
              parent="menu_sales_plan_root"
              action="action_sales_plan"
              sequence="10"
              groups="base.group_user"/>

    <!-- Quick Create Action -->
    <record id="action_sales_plan_quick_create" model="ir.actions.act_window">
        <field name="name">Create Sales Plan</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sales.plan</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_sales_plan_form"/>
        <field name="target">current</field>
        <field name="context">{'default_name': 'New Sales Plan'}</field>
    </record>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ========== VIEWS ========== -->
    <!-- Tree View for Plans -->
    <record id="view_sales_plan_tree" model="ir.ui.view">
        <field name="name">sales.plan.tree</field>
        <field name="model">sales.plan</field>
        <field name="arch" type="xml">
            <tree string="Sales Plans">
                <field name="name"/>
                <field name="plan_type"/>
                <field name="period_display"/>
                <field name="state" widget="badge"/>
                <field name="supervisor_id"/>
                <field name="wing_id"/>
                <field name="create_uid" string="Created By"/>
            </tree>
        </field>
    </record>
    
    <!-- Search View for Plans -->
    <record id="view_sales_plan_search" model="ir.ui.view">
        <field name="name">sales.plan.search</field>
        <field name="model">sales.plan</field>
        <field name="arch" type="xml">
            <search string="Sales Plans">
                <field name="name"/>
                <field name="plan_type"/>
                <field name="supervisor_id"/>
                <field name="wing_id"/>
                <field name="create_uid" string="Created By"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                <filter string="Past Due" name="past_due" domain="[('end_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Active" name="active" domain="[('end_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Plan Type" name="group_by_plan_type" context="{'group_by': 'plan_type'}"/>
                    <filter string="Supervisor" name="group_by_supervisor" context="{'group_by': 'supervisor_id'}"/>
                    <filter string="Wing" name="group_by_wing" context="{'group_by': 'wing_id'}"/>
                    <filter string="Created By" name="group_by_creator" context="{'group_by': 'create_uid'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <!-- Plan Document View for Managers and CRM Admin (Table view with filtering) -->
    <record id="view_sales_plan_document_tree" model="ir.ui.view">
        <field name="name">sales.plan.document.tree</field>
        <field name="model">sales.plan</field>
        <field name="arch" type="xml">
            <tree string="Plan Document" decoration-muted="end_date &lt; context_today().strftime('%Y-%m-%d')">
                <field name="name" string="Plan Name"/>
                <field name="plan_type" string="Plan Type"/>
                <field name="start_date" string="From Date"/>
                <field name="end_date" string="To Date"/>
                <field name="supervisor_id" string="Planned By"/>
                <field name="wing_id" string="Wing"/>
                <field name="create_uid" string="Created By"/>
                <field name="state" widget="badge"/>
                <field name="prospect_plan"/>
                <field name="followup_plan"/>
                <field name="site_visit_plan"/>
                <field name="office_visit_plan"/>
                <field name="total_visit_plan"/>
                <field name="unit_reservation_plan"/>
                <field name="deals_closed_plan"/>
                <field name="cash_collected_plan"/>
                <field name="total_deal_value_plan"/>
                <field name="conversion_plan"/>
                <field name="iar_plan"/>
            </tree>
        </field>
    </record>
    
    <!-- Search View for Plan Document -->
    <record id="view_sales_plan_document_search" model="ir.ui.view">
        <field name="name">sales.plan.document.search</field>
        <field name="model">sales.plan</field>
        <field name="arch" type="xml">
            <search string="Plan Document">
                <field name="name" string="Plan Name"/>
                <field name="plan_type"/>
                <field name="supervisor_id" string="Planned By"/>
                <field name="wing_id"/>
                <field name="create_uid" string="Created By"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <filter string="Today" name="today" domain="[('start_date', '&lt;=', context_today().strftime('%Y-%m-%d')), ('end_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="This Week" name="this_week" domain="[('start_date', '&lt;=', (context_today() + datetime.timedelta(days=7)).strftime('%Y-%m-%d')), ('end_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="This Month" name="this_month" domain="[('start_date', '&lt;=', (context_today() + datetime.timedelta(days=30)).strftime('%Y-%m-%d')), ('end_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="This Year" name="this_year" domain="[('start_date', '&lt;=', (context_today() + datetime.timedelta(days=365)).strftime('%Y-%m-%d')), ('end_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="Daily" name="daily" domain="[('plan_type', '=', 'weekly')]"/>
                <filter string="Monthly" name="monthly" domain="[('plan_type', '=', 'monthly')]"/>
                <filter string="Yearly" name="yearly" domain="[('plan_type', '=', 'quarterly')]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Plan Type" name="group_by_plan_type" context="{'group_by': 'plan_type'}"/>
                    <filter string="Planned By" name="group_by_supervisor" context="{'group_by': 'supervisor_id'}"/>
                    <filter string="Created By" name="group_by_creator" context="{'group_by': 'create_uid'}"/>
                    <filter string="Wing" name="group_by_wing" context="{'group_by': 'wing_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Main Form View -->
    <record id="view_sales_plan_form" model="ir.ui.view">
        <field name="name">sales.plan.form</field>
        <field name="model">sales.plan</field>
        <field name="arch" type="xml">
            <form string="Sales Plan">
                <header>
                    <!-- Buttons for 2-state workflow: Draft and Completed -->
                    <button name="action_complete" string="Complete" type="object" class="btn-primary" 
                            invisible="state == 'completed'"/>
                    <button name="action_draft" string="Reset to Draft" type="object" class="btn-secondary"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,completed"/>
                </header>
                <sheet>
                    <!-- Warning message for past due plans -->
                    <div class="alert alert-warning" role="alert" invisible="not is_past_due" style="margin-bottom: 20px;">
                        <strong>⚠️ This plan is past due!</strong> The end date has already passed. 
                        You cannot edit the dates or plan values. Please create a new plan for future dates.
                    </div>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                        <h2>
                            <field name="period_display"/>
                        </h2>
                    </div>

                    <!-- Top Section -->
                    <group>
                        <group string="Time Period">
                            <field name="start_date" readonly="is_past_due"/>
                            <field name="end_date" readonly="is_past_due"/>
                            <field name="plan_type" widget="radio" readonly="is_past_due"/>
                            <field name="is_past_due" invisible="1"/>
                        </group>
                        <group string="Plan Info">
                            <field name="supervisor_id" readonly="1"/>
                            <field name="wing_id" readonly="1"/>
                            <field name="state"/>
                            <field name="create_uid" readonly="1" string="Created By"/>
                        </group>
                    </group>

                    <!-- Plan Targets Table -->
                    <!-- Replace the quarterly section in the main form with: -->
<div class="row mt32">
    <div class="col-8">
        <h3>Sales Plan Targets</h3>
        <table class="table table-bordered">

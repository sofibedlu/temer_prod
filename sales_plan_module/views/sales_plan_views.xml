                </tr>
                <tr>
                    <td><strong>Total unit reservations</strong></td>
                    <td><field name="unit_reservation_plan" readonly="is_past_due"/></td>
                    <td><field name="unit_reservation_remark" nolabel="1" readonly="is_past_due"/></td>
                </tr>
                <tr>
                    <td><strong>Deals Closed (QTY)</strong></td>
                    <td><field name="deals_closed_plan" readonly="is_past_due"/></td>
                    <td><field name="deals_closed_remark" nolabel="1" readonly="is_past_due"/></td>
                </tr>
                <tr>
                    <td><strong>Cash Collected (Birr)</strong></td>
                    <td><field name="cash_collected_plan" readonly="is_past_due"/></td>
                    <td><field name="cash_collected_remark" nolabel="1" readonly="is_past_due"/></td>
                </tr>
                <tr>
                    <td><strong>Total Deal Value (Birr)</strong></td>
                    <td><field name="total_deal_value_plan" readonly="is_past_due"/></td>
                    <td><field name="total_deal_value_remark" nolabel="1" readonly="is_past_due"/></td>
                </tr>
                <tr>
                    <td><strong>Conversion (sales/leads)</strong></td>
                    <td><field name="conversion_plan" readonly="is_past_due"/></td>

                </tr>
                <tr>
                    <td><strong>Follow-ups</strong></td>
                    <td><field name="followup_plan" readonly="is_past_due"/></td>
                    <td><field name="followup_remark" nolabel="1" readonly="is_past_due"/></td>
                </tr>
                <tr>
                    <td><strong>Site Visits</strong></td>
                    <td><field name="site_visit_plan" readonly="is_past_due"/></td>
                    <td><field name="site_visit_remark" nolabel="1" readonly="is_past_due"/></td>
                </tr>
                <tr>
                    <td><strong>Office Visits</strong></td>
                    <td><field name="office_visit_plan" readonly="is_past_due"/></td>

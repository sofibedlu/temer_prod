        </table>
    </div>
    <div class="col-4">
        <h3>Opening Stock (Plan)</h3>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th width="30%">Type</th>
                    <th width="20%">QTY</th>
                    <th width="50%">Estimated Value (Birr)</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><strong>Residence</strong></td>
                    <td><field name="opening_stock_residence_qty_plan" readonly="is_past_due"/></td>
                    <td><field name="opening_stock_residence_value_plan" readonly="is_past_due"/></td>
                </tr>
                <tr>
                    <td><strong>Shops</strong></td>
                    <td><field name="opening_stock_shops_qty_plan" readonly="is_past_due"/></td>
                    <td><field name="opening_stock_shops_value_plan" readonly="is_past_due"/></td>
                </tr>
                <tr>
                    <td><strong>Total</strong></td>
                    <td><field name="opening_stock_total_qty_plan" readonly="1"/></td>
                    <td><field name="opening_stock_total_value_plan" readonly="1"/></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Report Form View -->
    <record id="view_sales_plan_report_form" model="ir.ui.view">
        <field name="name">sales.plan.report.form</field>
        <field name="model">sales.plan</field>
        <field name="arch" type="xml">
            <form string="Sales Plan Report" create="false" edit="false">
                <header>
                    <button name="action_refresh_metrics" string="Refresh Report" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <!-- Report Header -->
                    <div class="oe_title text-center">
                        <h1>
                            <field name="plan_type"/> Plan Report
                        </h1>
                        <h2>
                            Period: <field name="period_display"/>
                        </h2>
                        <h3>
                            Supervisor: <field name="supervisor_id"/> | Wing: <field name="wing_id"/>
                        </h3>
                    </div>

                    <!-- Report Table -->
                    <div class="mt32">
                        <table class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th width="15%">Metric</th>
                                    <th width="10%">Previous Week</th>
                                    <th width="10%">Plan</th>
                                    <th width="10%">Actual</th>
                                    <th width="10%">Difference</th>
                                    <th width="10%">%</th>
                                    <th width="35%">Remark</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Prospects Row -->
                                <tr>
                                    <td><strong>Prospects (Leads)</strong></td>
                                    <td class="text-center"><field name="previous_prospects" readonly="1"/></td>
                                    <td class="text-center"><field name="prospect_plan" readonly="1"/></td>
                                    <td class="text-center"><field name="actual_prospects" readonly="1"/></td>
                                    <td class="text-center"><field name="prospect_difference" readonly="1"/></td>
                                    <td class="text-center"><field name="prospect_percentage" widget="progressbar" readonly="1"/></td>
                                    <td><field name="prospect_remark" readonly="1"/></td>
                                </tr>
                                <!-- Follow-ups Row -->
                                <tr>
                                    <td><strong>Follow-ups</strong></td>
                                    <td class="text-center"><field name="previous_followups" readonly="1"/></td>
                                    <td class="text-center"><field name="followup_plan" readonly="1"/></td>
                                    <td class="text-center"><field name="actual_followups" readonly="1"/></td>
                                    <td class="text-center"><field name="followup_difference" readonly="1"/></td>
                                    <td class="text-center"><field name="followup_percentage" widget="progressbar" readonly="1"/></td>
                                    <td><field name="followup_remark" readonly="1"/></td>
                                </tr>
                                <!-- Site Visits Row -->
                                <tr>
                                    <td><strong>Site Visits</strong></td>
                                    <td class="text-center"><field name="previous_site_visits" readonly="1"/></td>
                                    <td class="text-center"><field name="site_visit_plan" readonly="1"/></td>
                                    <td class="text-center"><field name="actual_site_visits" readonly="1"/></td>
                                    <td class="text-center"><field name="site_visit_difference" readonly="1"/></td>
                                    <td class="text-center"><field name="site_visit_percentage" widget="progressbar" readonly="1"/></td>
                                    <td><field name="site_visit_remark" readonly="1"/></td>
                                </tr>
                                <!-- Office Visits Row -->
                                <tr>
                                    <td><strong>Office Visits</strong></td>
                                    <td class="text-center"><field name="previous_office_visits" readonly="1"/></td>
                                    <td class="text-center"><field name="office_visit_plan" readonly="1"/></td>
                                    <td class="text-center"><field name="actual_office_visits" readonly="1"/></td>
                                    <td class="text-center"><field name="office_visit_difference" readonly="1"/></td>
                                    <td class="text-center"><field name="office_visit_percentage" widget="progressbar" readonly="1"/></td>
                                    <td><field name="office_visit_remark" readonly="1"/></td>
                                </tr>
                                <!-- Total Visits Row -->
                                <tr>
                                    <td><strong>Total Visits (Site + Office)</strong></td>
                                    <td class="text-center"><field name="previous_total_visits" readonly="1"/></td>
                                    <td class="text-center"><field name="total_visit_plan" readonly="1"/></td>
                                    <td class="text-center"><field name="actual_total_visits" readonly="1"/></td>
                                    <td class="text-center"><field name="total_visit_difference" readonly="1"/></td>
                                    <td class="text-center"><field name="total_visit_percentage" widget="progressbar" readonly="1"/></td>
                                    <td><field name="total_visit_remark" readonly="1"/></td>
                                </tr>
                                <!-- Quarterly Report Rows -->
                                <tr>
                                    <td><strong>Unit Reservations</strong></td>
                                    <td class="text-center"><field name="previous_unit_reservations" readonly="1"/></td>
                                    <td class="text-center"><field name="unit_reservation_plan" readonly="1"/></td>
                                    <td class="text-center"><field name="actual_unit_reservations" readonly="1"/></td>
                                    <td class="text-center"><field name="unit_reservation_difference" readonly="1"/></td>
                                    <td class="text-center"><field name="unit_reservation_percentage" widget="progressbar" readonly="1"/></td>
                                    <td><field name="unit_reservation_remark" readonly="1"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Deals Closed (QTY)</strong></td>
                                    <td class="text-center"><field name="previous_deals_closed" readonly="1"/></td>
                                    <td class="text-center"><field name="deals_closed_plan" readonly="1"/></td>
                                    <td class="text-center"><field name="actual_deals_closed" readonly="1"/></td>
                                    <td class="text-center"><field name="deals_closed_difference" readonly="1"/></td>
                                    <td class="text-center"><field name="deals_closed_percentage" widget="progressbar" readonly="1"/></td>
                                    <td><field name="deals_closed_remark" readonly="1"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Cash Collected (Birr)</strong></td>
                                    <td class="text-center"><field name="previous_cash_collected" readonly="1"/></td>
                                    <td class="text-center"><field name="cash_collected_plan" readonly="1"/></td>
                                    <td class="text-center"><field name="actual_cash_collected" readonly="1"/></td>
                                    <td class="text-center"><field name="cash_collected_difference" readonly="1"/></td>
                                    <td class="text-center"><field name="cash_collected_percentage" widget="progressbar" readonly="1"/></td>
                                    <td><field name="cash_collected_remark" readonly="1"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Total Deal Value (Birr)</strong></td>
                                    <td class="text-center"><field name="previous_total_deal_value" readonly="1"/></td>
                                    <td class="text-center"><field name="total_deal_value_plan" readonly="1"/></td>
                                    <td class="text-center"><field name="actual_total_deal_value" readonly="1"/></td>
                                    <td class="text-center"><field name="total_deal_value_difference" readonly="1"/></td>
                                    <td class="text-center"><field name="total_deal_value_percentage" widget="progressbar" readonly="1"/></td>
                                    <td><field name="total_deal_value_remark" readonly="1"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Conversion</strong></td>
                                    <td class="text-center">-</td>
                                    <td class="text-center"><field name="conversion_plan" readonly="1"/></td>
                                    <td class="text-center"><field name="actual_conversion" readonly="1"/></td>
                                    <td class="text-center">-</td>
                                    <td class="text-center"><field name="conversion_percentage" widget="progressbar" readonly="1"/></td>
                                    <td><field name="conversion_remark" readonly="1"/></td>
                                </tr>
                                <tr>
                                    <td><strong>IAR (%)</strong></td>
                                    <td class="text-center">-</td>
                                    <td class="text-center"><field name="iar_plan" readonly="1"/></td>
                                    <td class="text-center"><field name="actual_iar" readonly="1"/></td>
                                    <td class="text-center">-</td>
                                    <td class="text-center"><field name="iar_percentage" widget="progressbar" readonly="1"/></td>
                                    <td><field name="iar_remark" readonly="1"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="mt32">
                        <h3>Opening Stock</h3>
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th width="30%">Type</th>
                                    <th width="20%">QTY</th>
                                    <th width="50%">Estimated Value (Birr)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><strong>Residence</strong></td>
                                    <td class="text-center"><field name="actual_opening_stock_residence_qty" readonly="1"/></td>
                                    <td class="text-center"><field name="actual_opening_stock_residence_value" readonly="1"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Shops</strong></td>
                                    <td class="text-center"><field name="actual_opening_stock_shops_qty" readonly="1"/></td>
                                    <td class="text-center"><field name="actual_opening_stock_shops_value" readonly="1"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Total</strong></td>
                                    <td class="text-center"><field name="actual_opening_stock_total_qty" readonly="1"/></td>
                                    <td class="text-center"><field name="actual_opening_stock_total_value" readonly="1"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Wing Plan Report Wizard Form -->
    <record id="view_wing_plan_report_wizard_form" model="ir.ui.view">
        <field name="name">wing.plan.report.wizard.form</field>
        <field name="model">wing.plan.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Wing Plan Report">
                <sheet>
                    <div class="oe_title">
                        <h1>Wing Plan Report</h1>
                    </div>
                    <group>
                        <group>
                            <field name="wing_id" required="1"/>
                        </group>
                        <group>
                            <field name="start_date" required="1"/>
                            <field name="end_date" required="1"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_generate_report" string="Generate Report" type="object" class="btn-primary"/>
                        <button string="Cancel" special="cancel" class="btn-secondary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Supervisor Plan Report Wizard Form -->
    <record id="view_supervisor_plan_report_wizard_form" model="ir.ui.view">
        <field name="name">supervisor.plan.report.wizard.form</field>
        <field name="model">supervisor.plan.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Supervisor Plan Report">
                <sheet>
                    <div class="oe_title">
                        <h1>Supervisor Plan Report</h1>
                    </div>
                    <group>
                        <group>
                            <field name="supervisor_id" required="1"/>
                        </group>
                        <group>
                            <field name="start_date" required="1"/>
                            <field name="end_date" required="1"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_generate_report" string="Generate Report" type="object" class="btn-primary"/>
                        <button string="Cancel" special="cancel" class="btn-secondary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ========== ACTIONS ========== -->
    <record id="action_sales_plan" model="ir.actions.act_window">
        <field name="name">Sales Plans</field>
        <field name="res_model">sales.plan</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_sales_plan_search"/>
        <field name="context">{'create': True}</field>
        <field name="domain">[]</field>
        <!-- Visible to all users - role checking done in model access methods -->
        <field name="groups_id" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Sales Plan!
            </p>
            <p>
                Sales plans help you track and manage your sales targets and performance.
            </p>
        </field>
    </record>
    
    <!-- Plan Document Action for Managers and CRM Admin -->
    <!-- Delete old action if it exists (act_window) -->
    <delete id="action_sales_plan_document" model="ir.actions.act_window"/>
    
    <!-- Plan Document Client Action -->
    <record id="action_sales_plan_document" model="ir.actions.client">
        <field name="name">Plan Document</field>
        <field name="tag">sales_plan_module.plan_document</field>
        <field name="context">{}</field>
    </record>

    <record id="action_wing_plan_report" model="ir.actions.act_window">
        <field name="name">Wing Plan Report</field>
        <field name="res_model">wing.plan.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_supervisor_plan_report" model="ir.actions.act_window">
        <field name="name">Supervisor Plan Report</field>
        <field name="res_model">supervisor.plan.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ========== MENUS ========== -->
    <!-- Sales Plans Menu - ONLY for supervisors (NOT for managers) -->
    <menuitem id="menu_sales_plan_root" name="Sales Plan" sequence="100"/>
    
    <!-- Sales Plans Submenu - ONLY for supervisors -->
    <menuitem id="menu_sales_plan"
              name="Sales Plans"
              parent="menu_sales_plan_root"
              action="action_sales_plan"
              sequence="10"/>
    
    <!-- Plan Document Submenu - For managers and CRM Admin (under Sales Plan menu) -->
    <menuitem id="menu_plan_document"
              name="Plan Document"
              parent="menu_sales_plan_root"
              action="action_sales_plan_document"
              sequence="20"/>
    
    <!-- Sales Plan Root menu: Visible to supervisors and managers (role-based groups) -->
    <record id="menu_sales_plan_root" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('base.group_system'), ref('sales_plan_module.group_sales_plan_manager'), ref('sales_plan_module.group_sales_plan_supervisor_only')])]"/>
        <!-- Root menu visible to managers and supervisors - assigned via post_init_hook based on role -->
    </record>
    
    <!-- Sales Plans menu: ONLY for supervisors (NOT managers) -->
    <record id="menu_sales_plan" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('base.group_system'), ref('sales_plan_module.group_sales_plan_supervisor_only')])]"/>
        <!-- Only supervisors who are NOT managers can see this menu -->
    </record>
    
    <!-- Plan Document menu: ONLY for managers (Sales Manager/Wing Manager) and CRM Admin -->
    <record id="menu_plan_document" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('base.group_system'), ref('sales_plan_module.group_sales_plan_manager'), ref('temer_structure.access_property_crm_admin_group')])]"/>
        <!-- Only managers (assigned via post_init_hook) and CRM Admin can see this menu -->
    </record>

    <!-- Plan Reports Submenu - Admin only -->
    <menuitem id="menu_plan_reports"
              name="Plan Reports"
              parent="menu_sales_plan_root"
              sequence="20"
              groups="base.group_system"/>


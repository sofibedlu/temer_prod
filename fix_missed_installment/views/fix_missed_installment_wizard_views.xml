<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_fix_missed_installment_wizard" model="ir.actions.act_window">
        <field name="name">Fix Missed Installment</field>
        <field name="res_model">fix.missed.installment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_fix_missed_installment_wizard_form" model="ir.ui.view">
        <field name="name">fix.missed.installment.wizard.form</field>
        <field name="model">fix.missed.installment.wizard</field>
        <field name="arch" type="xml">
            <form string="Fix Missed Installment">

                <group string="Select Log Entry">
                    <field name="log_id"
                           options="{'no_create': True, 'no_open': True}"/>
                </group>

                <group string="Substitution Details">
                    <field name="site_id"/>
                    <field name="old_installment"/>
                    <field name="new_installment"/>
                </group>

                <!-- Counts appear as soon as a log is selected -->
                <group string="Matching Records">
                    <field name="payment_line_count" readonly="1"
                           string="Property Payment Lines"/>
                    <field name="collection_count"   readonly="1"
                           string="Collection Installments"/>
                </group>

                <footer>
                    <button name="action_fix_installments"
                            string="Execute Fix"
                            type="object"
                            class="btn-primary"/>
                    <button string="Close"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>

            </form>
        </field>
    </record>

</odoo>

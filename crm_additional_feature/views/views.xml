<odoo>

<record id="view_crm_lead_form_custom_save" model="ir.ui.view">
        <field name="name">crm.lead.form.custom.save</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            
            <!-- Position after source_id field -->
            <field name="source_id" position="after">
                <!-- Custom Save Button -->
                <div class="oe_button_box" name="button_box">
                    <button name="action_save_crm_records" 
                            type="object" 
                            string="Save Record" 
                            class="btn-success"
                            invisible =" id != False"/>
                    
                    
                </div>
            </field>


        </field>
    </record>
 
 
   
    <record id="action_crm_lead_my_pipline" model="ir.actions.act_window">
        <field name="name">My Pipeline</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[('create_uid', '=', uid)]</field>
        <field name="context">{'search_default_filter_default': 1}</field>
    </record>

    
    <record id="crm.crm_menu_root" model="ir.ui.menu">
        <field name="action" ref="action_crm_lead_my_pipline"/>
    </record>

    
    <menuitem id="menu_crm_my_pipeline"
              name="My Pipeline"
              action="action_crm_lead_my_pipline"
              parent="crm.crm_menu_sales" sequence="1"/>

</odoo>
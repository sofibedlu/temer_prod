<?xml version="1.0"?>
<odoo>
    <!--Sh complain Object views and action -->
    <record id="sh_complain_form_view" model="ir.ui.view">
        <field name="name">sh.complain.form</field>
        <field name="model">sh.complain</field>
        <field name="arch" type="xml">
            <form string="Complain">
                <header>
                    <button name="new_complain_button" type="object" string="Post Complain"
                        class="oe_highlight" invisible="state != 'new'" />

                    <button name="resolve_button" type="object" string="Resolve"
                        class="oe_highlight"
                        invisible="is_resolve or state != 'waiting'" />
                        <!-- invisible="['|',('is_resolve','=',True),('state','!=','waiting')]"  -->
    
                    <button name="refuse_button" type="object" string="Refuse"
                        class="oe_highlight"
                        invisible="is_resolve or state != 'waiting'" />
                        <!-- invisible="['|',('is_resolve','=',True),('state','!=','waiting')]" -->

                    <button name="close_button" type="object" string="Close"
                        class="oe_highlight" invisible="state != 'resolve'" />

                    <button name="reset_to_draft_button" type="object" string="Reset To Draft"
                        class="oe_highlight" invisible="state not in ['refused', 'closed']" />

                    <field name="state" widget="statusbar"
                        statusbar_visible="new,waiting,resolve,refused,closed" readonly="1" />
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="subject" required="True" invisible="state != 'new'" />
                            <field name="complain_category" required="True"
                                options="{'no_create': True, 'no_open': True,'no_create_edit': True}"
                                invisible="state != 'new'" />
                            <field name="create_date" invisible="state != 'new'" />
                        </group>
                        <group>
                            <field name="created_by" readonly="1" required="True" />
                            <field name="resp_persons" widget="many2many_tags" readonly="1"
                                required="True" />
                            <field name="has_effect_on" widget="many2many_tags" required="True"
                                invisible="state != 'new'" />
                            <field name="is_resolve" invisible="1" />
                            <field name="company_id" options="{'no_create': True}"
                                groups="base.group_multi_company" invisible="state != 'new'" />
                        </group>
                    </group>
                    <group>
                        <field name="description" string="Description"
                            invisible="state != 'new'" />
                    </group>
                    <notebook>
                        <page string="Resolve Comment" name="resolved_page"
                            invisible="state not in ['resolve', 'closed']">
                            <group>
                                <group>
                                    <field name="rating" widget="priority" readonly="1" />
                                    <field name="resolved_by" readonly="1" />
                                    <field name="resolved_comment" readonly="1" />
                                </group>
                            </group>
                        </page>
                        <page string="Refused Comment" name="refused_page"
                            invisible="state != 'refused'">
                            <group>
                                <group>
                                    <field name="rating" widget="priority" readonly="1" />
                                    <field name="refused_by" readonly="1" />
                                    <field name="refused_comment" readonly="1" />
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>


                <div class="o_attachment_preview" />
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="activity_ids" widget="mail_activity" />
                    <field name="message_ids" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>

    <record id="sh_complain_tree_view" model="ir.ui.view">
        <field name="name">sh.complain.tree</field>
        <field name="model">sh.complain</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" string="Sequence" />
                <field name="subject" />
                <field name="complain_category" />
                <field name="create_date" />
                <field name="created_by" />
                <field name="state" />
            </tree>
        </field>
    </record>

    <record id="sh_complain_search_views" model="ir.ui.view">
        <field name="name">sh.complain.search</field>
        <field name="model">sh.complain</field>
        <field name="arch" type="xml">
            <search string="Complain">
                <field name="name" />
                <filter string="To resolve Complain" name="to_app_complain"
                    domain="[('state', '=', 'waiting')]" />
                <filter string="Resolved Complain" name="app_complain"
                    domain="[('state','=','resolve')]" />
                <filter string="Refused Complain" name="refused" domain="[('state','=','refused')]" />
                <separator />
                <group expand="0" string="Group by...">
                    <filter string="Sequence" name="name" context="{'group_by': 'name'}" />
                    <filter string="Subject" name="subject" context="{'group_by': 'subject'}" />
                    <filter string="Complain Categories" name="complain_category"
                        context="{'group_by': 'complain_category'}" />
                    <filter string="Created Date" name="create_date"
                        context="{'group_by': 'create_date'}" />
                    <filter string="Created By" name="created_by"
                        context="{'group_by': 'created_by'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="sh_complain_view_actions" model="ir.actions.act_window">
        <field name="name">Complain</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sh.complain</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
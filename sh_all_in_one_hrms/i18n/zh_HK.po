"                                        <td>${line.approved_by.name}</td>\n"
"                                        <td>${line.status}</td>\n"
"                                    </tr>\n"
"                                </tbody>\n"
"                            % endfor\n"
"                        </table>\n"
"                        <br/>\n"
"                        <br/>\n"
"                        if you are authorize approver as per approval level.<br/>\n"
"                        You can use the following link and approve the payslip<br/><br/>\n"
"\n"
"                        <div style=\"display: inline-block; margin: 15px; text-align: center\">\n"
"                            <a href=\"/mail/view?model=hr.payslip&amp;res_id = ${object.id}\" target=\"_blank\" style=\"padding: 5px 10px; color: #FFFFFF; text-decoration: none; background-color: #875A7B; border: 1px solid #875A7B; border-radius: 3px\">Payslip Ref: #${object.number}</a>\n"
"                        </div><br/>\n"
"                        Thanks.\n"
"                    </p>\n"
"                </div>\n"
"            "

#. module: sh_all_in_one_hrms
#: model:mail.template,body_html:sh_all_in_one_hrms.email_template_for_approve_hr_payslip
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        <h2>\n"
"                            <b>Submit for Approval: ${object.name}</b>\n"
"                        </h2>\n"
"                        <br/>\n"
"                        <br/>\n"
"                        <p>\n"
"                            Dear Approver,\n"
"                            <br/>\n"
"                            <br/>\n"
"                            This is inform you that payslip is submitted for approval.\n"
"                            <br/>\n"
"                            <b>User:</b>\n"
"                            ${object.user_id.name}\n"
"                            <br/>\n"
"                            <b>Total Payslip Amount:</b>\n"
"                            ${format_amount(object.net_amount, object.contract_id.currency_id)}\n"
"                            <br/>\n"
"                            <b>Approval Level:</b>\n"
"                            ${object.approval_level_id.name}\n"
"                            <br/>\n"
"                            <b>Minimum Amount:</b>\n"
"                            ${format_amount(object.approval_level_id.min_amount, object.contract_id.currency_id)}\n"
"                            <br/>\n"
"                            <br/>\n"
"                            Payslip Approval information as below\n"
"                        </p>\n"
"                        <br/>\n"
"                        <br/>\n"
"                        \n"
"                        <table class=\"table table-bordered\">\n"
"                            <thead>\n"
"                                <tr>\n"
"                                    <th scope=\"col\">Level</th>\n"
"                                    <th scope=\"col\">Approvers</th>\n"
"                                    <th scope=\"col\">Approved Date</th>\n"
"                                    <th scope=\"col\">Approved By</th>\n"
"                                    <th scope=\"col\">Status</th>\n"
"                                </tr>\n"
"                            </thead>\n"
"                            % for line in object.approval_info_line:\n"
"                                <tbody>\n"
"                                    <tr>\n"
"                                        <th>${line.level}</th>\n"
"                                        <td>\n"
"                                            % if line.user_ids:\n"
"                                                % for user in line.user_ids:\n"
"                                                    <i>${user.name},</i>\n"
"                                                % endfor\n"
"\n"
"                                            % else:\n"
"                                                % for group in line.group_ids:\n"
"                                                    <i>${group.name},</i>\n"
"                                                % endfor\n"
"                                                \n"
"                                            % endif\n"
"                                        </td>\n"
"                                        <td>${line.approval_date}</td>\n"
"                                        <td>${line.approved_by.name}</td>\n"
"                                        <td>${line.status}</td>\n"
"                                    </tr>\n"
"                                </tbody>\n"
"                            % endfor\n"
"                        </table>\n"
"                        <br/>\n"
"                        <br/>\n"
"                        if you are authorize approver as per approval level.<br/>\n"
"                        You can use the following link and approve the payslip<br/><br/>\n"
"\n"
"                        <div style=\"display: inline-block; margin: 15px; text-align: center\">\n"
"                            <a href=\"/mail/view?model=hr.payslip&amp;res_id = ${object.id}\" target=\"_blank\" style=\"padding: 5px 10px; color: #FFFFFF; text-decoration: none; background-color: #875A7B; border: 1px solid #875A7B; border-radius: 3px\">Payslip Ref: #${object.number}</a>\n"
"                        </div><br/>\n"
"                        Thanks.\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        <h2>\n"
"                            <b>Zur Genehmigung einreichen: ${object.name}</b>\n"
"                        </h2>\n"
"                        <br/>\n"
"                        <br/>\n"
"                        <p>\n"
"                            Sehr geehrter Genehmiger,\n"
"                            <br/>\n"
"                            <br/>\n"
"                            Dies ist darüber informiert, dass PaySlip zur Genehmigung übermittelt wird.\n"
"                            <br/>\n"
"                            <b>Benutzer:</b>\n"
"                            ${object.user_id.name}\n"
"                            <br/>\n"
"                            <b>Total Payslip-Betrag:</b>\n"
"                            ${format_amount(object.net_amount, object.contract_id.currency_id)}\n"
"                            <br/>\n"
"                            <b>Genehmigungsstufe:</b>\n"
"                            ${object.approval_level_id.name}\n"
"                            <br/>\n"
"                            <b>Mindestbetrag:</b>\n"
"                            ${format_amount(object.approval_level_id.min_amount, object.contract_id.currency_id)}\n"
"                            <br/>\n"
"                            <br/>\n"
"                            PaySlip-Zulassungsinformationen wie folgt\n"
"                        </p>\n"
"                        <br/>\n"
"                        <br/>\n"
"                        \n"
"                        <table class=\"table table-bordered\">\n"
"                            <thead>\n"
"                                <tr>\n"
"                                    <th scope=\"col\">Niveau</th>\n"
"                                    <th scope=\"col\">Angenehm</th>\n"
"                                    <th scope=\"col\">Genehmigter Datum</th>\n"
"                                    <th scope=\"col\">Genehmigt durch</th>\n"
"                                    <th scope=\"col\">Status</th>\n"
"                                </tr>\n"
"                            </thead>\n"
"                            % for line in object.approval_info_line:\n"
"                                <tbody>\n"
"                                    <tr>\n"
"                                        <th>${line.level}</th>\n"
"                                        <td>\n"
"                                            % if line.user_ids:\n"
"                                                % for user in line.user_ids:\n"
"                                                    <i>${user.name},</i>\n"
"                                                % endfor\n"
"\n"
"                                            % else:\n"
"                                                % for group in line.group_ids:\n"
"                                                    <i>${group.name},</i>\n"
"                                                % endfor\n"
"                                                \n"
"                                            % endif\n"
"                                        </td>\n"
"                                        <td>${line.approval_date}</td>\n"
"                                        <td>${line.approved_by.name}</td>\n"
"                                        <td>${line.status}</td>\n"
"                                    </tr>\n"
"                                </tbody>\n"
"                            % endfor\n"
"                        </table>\n"
"                        <br/>\n"
"                        <br/>\n"
"                        Wenn Sie genehmigt, genehmigen Sie den Genehmigungsniveau.<br/>\n"
"                        Sie können den folgenden Link verwenden und den PaySlip genehmigen<br/><br/>\n"
"\n"
"                        <div style=\"display: inline-block; margin: 15px; text-align: center\">\n"
"                            <a href=\"/mail/view?model=hr.payslip&amp;res_id = ${object.id}\" target=\"_blank\" style=\"padding: 5px 10px; color: #FFFFFF; text-decoration: none; background-color: #875A7B; border: 1px solid #875A7B; border-radius: 3px\">Payslip Ref.: #${object.number}</a>\n"
"                        </div><br/>\n"
"                        Vielen Dank.\n"
"                    </p>\n"
"                </div>\n"
"            "

#. module: sh_all_in_one_hrms

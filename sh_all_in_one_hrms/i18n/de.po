msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                    <strong>Notification to expire Employee Medical Examination</strong>\n"
"                    <br/>\n"
"                    <br/>\n"
"                </p>\n"
"                <table style=\"font-family: 'Trebuchet MS', Arial, Helvetica, sans-serif; border-collapse: collapse; width: 100%;\">\n"
"                    <tr>\n"
"                        <th style=\"border: 1px solid #ddd; padding: 8px; padding-top: 12px; padding-bottom: 12px; text-align: left; background-color: #875a7b; color: white;\">Employee Name</th>\n"
"                        <th style=\"border: 1px solid #ddd; padding: 8px; padding-top: 12px; padding-bottom: 12px; text-align: left; background-color: #875a7b; color: white;\">Description</th>\n"

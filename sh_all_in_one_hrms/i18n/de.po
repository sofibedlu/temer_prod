"                            <span>${line.sh_description}</span>\n"
"                        </td>\n"
"                        <td style=\"border: 1px solid #ddd; padding: 8px; padding-top: 12px; padding-bottom: 12px; text-align: left;\">\n"
"                            <span>${line.sh_medical_type_id.name}</span>\n"
"                        </td>\n"
"                        <td style=\"border: 1px solid #ddd; padding: 8px; padding-top: 12px; padding-bottom: 12px; text-align: left;\">\n"
"                            <span>${line.sh_issue_date}</span>\n"
"                        </td>\n"
"                        <td style=\"border: 1px solid #ddd; padding: 8px; padding-top: 12px; padding-bottom: 12px; text-align: left;\">\n"
"                            <span>${line.sh_expiry_month}</span>\n"
"                        </td>\n"
"                        <td style=\"border: 1px solid #ddd; padding: 8px; padding-top: 12px; padding-bottom: 12px; text-align: left;\">\n"
"                            <span>${line.sh_expiry_date}</span>\n"
"                        </td>\n"
"                    </tr>\n"
"                    % endfor\n"
"                </table>\n"
"            </div>\n"
"        "
msgstr ""

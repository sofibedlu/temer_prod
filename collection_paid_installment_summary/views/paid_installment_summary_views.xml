<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_collection_paid_installment_summary_form" model="ir.ui.view">
        <field name="name">collection.paid.installment.summary.form</field>
        <field name="model">collection.paid.installment.summary</field>
        <field name="arch" type="xml">
            <form string="Paid Installments Summary" create="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h2>Paid Installments Summary Dashboard</h2>
                        <span class="text-muted">Select a Site and/or an Installment milestone to filter paid amounts.</span>
                    </div>

                    <group>
                        <group>
                            <field name="site_id" options="{'no_create': True}" placeholder="Select Site to filter..."/>
                            <field name="site_payment_structure_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="payment_term_line_id" 
                                   options="{'no_create': True}" 
                                   domain="[('payment_term_id', '=', site_payment_structure_id)]"
                                   placeholder="Select Milestone/Installment..."/>
                        </group>
                    </group>

                    <div class="alert alert-success text-center mt-3 mb-3" role="alert" style="border: 2px solid #28a745;">
                        <h3 style="margin-bottom: 0px; color: #155724;">
                            <strong>Total Paid For Selection: </strong>
                            <field name="total_paid_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </h3>
                        <field name="currency_id" invisible="1"/>
                    </div>

                    <notebook>
                        <page string="Paid Installments List">
                            <field name="installment_ids" readonly="1">
                                <tree string="Paid Installments" create="0" delete="0" edit="0">
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="name" string="Installment"/>
                                    <!-- <field name="state" widget="badge" decoration-success="state == 'paid'"/> -->
                                    <field name="amount_paid" string="Amount" widget="monetary" sum="Page Subtotal"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_open_paid_installment_summary_server" model="ir.actions.server">
        <field name="name">Paid Installments Summary</field>
        <field name="model_id" ref="model_collection_paid_installment_summary"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_summary()</field>
    </record>

    <menuitem id="menu_collection_paid_installment_summary"
              name="Paid Installments Summary"
              parent="collection_management.menu_collection_root"
              action="action_open_paid_installment_summary_server"
              groups="collection_paid_installment_summary.group_collection_paid_summary"
              sequence="20"/>
</odoo>
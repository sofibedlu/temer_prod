<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record model="ir.module.category" id="my_team_category">
            <field name="name">MY Team</field>
            <field name="description">Access control for the MY Team module.</field>
        </record>

        <record id="group_my_team_user" model="res.groups">
            <field name="name">MY Team User</field>
            <field name="category_id" ref="my_team_category"/>
            <field name="implied_ids" eval="[
                (4, ref('temer_structure.access_property_wing_manager_group')),
                (4, ref('temer_structure.access_property_sales_team_manager_group'))
            ]"/>
        </record>

        <record id="group_my_team_admin" model="res.groups">
            <field name="name">MY Team Admin</field>
            <field name="category_id" ref="my_team_category"/>
            <field name="implied_ids" eval="[(4, ref('my_team.group_my_team_user'))]"/>
        </record>

    </data>
</odoo>

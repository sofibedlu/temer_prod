<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════
         LIST VIEW  (tag must be <tree> so ir.ui.view.type = 'tree')
    ═══════════════════════════════════════════════════════════════ -->
    <record id="view_my_team_member_list" model="ir.ui.view">
        <field name="name">my.team.member.list</field>
        <field name="model">my.team.member</field>
        <field name="arch" type="xml">
            <tree string="My Team" create="false" edit="false" delete="false">

                <field name="user_image" widget="image"
                       options="{'size': [32, 32]}" optional="show"/>
                <field name="user_name" string="Name"/>
                <field name="user_login" string="Username"/>

                <!-- owner_id kept for domain filtering only, never displayed -->
                <field name="owner_id" invisible="1" optional="hide"/>
                <button name="action_ban_user"
                        string="Ban"
                        type="object"
                        icon="fa-ban"
                        class="btn-danger btn-sm"
                        confirm="Remove this user from the team and disable their account?"/>
            </tree>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         FORM VIEW
    ═══════════════════════════════════════════════════════════════ -->
    <record id="view_my_team_member_form" model="ir.ui.view">
        <field name="name">my.team.member.form</field>
        <field name="model">my.team.member</field>
        <field name="arch" type="xml">
            <form string="Team Member" create="false" edit="false" delete="false">
                <header>
                    <button name="action_ban_user"
                            string="Ban User"
                            type="object"
                            class="btn-danger"
                            confirm="This will remove the user from the team structure and disable their account. Are you sure?"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <field name="user_image" widget="image"
                               options="{'size': [90, 90]}" class="oe_avatar"/>
                        <h1><field name="user_name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Contact">
                            <field name="user_id"    readonly="1" string="User"/>
                            <field name="user_login" readonly="1" string="Username"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         KANBAN VIEW
    ═══════════════════════════════════════════════════════════════ -->
    <record id="view_my_team_member_kanban" model="ir.ui.view">
        <field name="name">my.team.member.kanban</field>
        <field name="model">my.team.member</field>
        <field name="arch" type="xml">
            <kanban create="false" edit="false" delete="false">
                <field name="user_name"/>
                <field name="user_login"/>
                <field name="user_image"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record">
                            <div class="o_kanban_image">
                                <img t-att-src="kanban_image('my.team.member', 'user_image', record.id.raw_value)"
                                     alt="Photo" class="o_image_64_cover"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="user_name"/>
                                </strong>
                                <ul>
                                    <li t-if="record.user_login.raw_value">
                                        Username: <field name="user_login"/>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         SEARCH VIEW
    ═══════════════════════════════════════════════════════════════ -->
    <record id="view_my_team_member_search" model="ir.ui.view">
        <field name="name">my.team.member.search</field>
        <field name="model">my.team.member</field>
        <field name="arch" type="xml">
            <search string="Search My Team">
                <field name="user_name"         string="Name"/>
                <field name="user_login"         string="Username"/>
                <field name="team_manager_name"  string="Sales Manager"/>

                <filter string="Sales Managers" name="filter_sales_manager"
                        domain="[('role','=','sales_manager')]"/>
                <filter string="Supervisors"    name="filter_supervisor"
                        domain="[('role','=','supervisor')]"/>
                <filter string="Salespersons"   name="filter_salesperson"
                        domain="[('role','=','salesperson')]"/>

                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Sales Manager" name="group_sales_manager"
                            context="{'group_by': 'team_manager_name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         ACTION  – refresh snapshot then open list
    ═══════════════════════════════════════════════════════════════ -->
    <record id="action_my_team_refresh" model="ir.actions.server">
        <field name="name">My Team – Refresh &amp; Open</field>
        <field name="model_id" ref="model_my_team_member"/>
        <field name="binding_model_id" ref="model_my_team_member"/>
        <field name="state">code</field>
        <field name="code">
action = model.action_refresh_my_team()
        </field>
    </record>

    <!-- Direct window action (used by the menu) -->
    <record id="action_my_team_view" model="ir.actions.act_window">
        <field name="name">My Team</field>
        <field name="res_model">my.team.member</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[('owner_id', '=', uid)]</field>
        <field name="context">{'search_default_group_role': 1}</field>
        <field name="search_view_id" ref="view_my_team_member_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No team data yet.
            </p>
            <p>
                Click <strong>Refresh My Team</strong> to load your hierarchy.
            </p>
        </field>
    </record>

</odoo>

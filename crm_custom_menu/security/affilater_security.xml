<odoo>
    <data noupdate="1">
        <!-- Define a New Category -->
        <record id="module_category_affilater" model="ir.module.category">
            <field name="name">Affilater</field>
            <field name="sequence">10</field>
        </record>

        <!-- Define the Affilater Group -->
        <record id="group_affilater" model="res.groups">
            <field name="name">Affilater</field>
            <field name="category_id" ref="crm_custom_menu.module_category_affilater"/>
            <field name="comment">This group is for Affilater users.</field>
        </record>

        <!-- Optional: Assign Access Rights to the Affilater Group -->
        <record id="crm_affilater_access" model="ir.model.access">
            <field name="name">crm.affilater.access</field>
            <field name="model_id" ref="model_crm_affilater"/>
            <field name="group_id" ref="crm_custom_menu.group_affilater"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>
        <!-- record rule-->
        <record id="crm_callcenter_user_rule" model="ir.rule">
            <field name="name">Website Records: Only Creator Can See</field>
            <field name="model_id" ref="model_crm_callcenter"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
     
    </data>
</odoo>
<odoo>
 <record id="view_crm_affilater_form" model="ir.ui.view">
        <field name="name">crm.affilater.form</field>
        <field name="model">crm.affilater</field>
        <field name="arch" type="xml">
            <form string="Referral Lead">
                <header>
                    <field name="state_crm" widget="statusbar" statusbar_visible="draft,sent"/>
                    <button name="action_send_sms_to_existing_customer" 
                        string="Send SMS to Existing Sales Team"
                        type="object" 
                        class="btn-warning"
                        invisible="not phone_number_message"/>
                <!-- <button name="action_create_temer_lead" 
                        string="Create New Lead" 
                        type="object" 
                        class="btn-primary"
                        invisible="phone_number_message"/> -->
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="customer_name" string="👤 Customer Name"/>
                            <field name="email_address" string="📧 Email Address"/>
                            <field name="affilater_name" string="👤 Affilater Name"/>
                            <field name="country_id" string="🌍 Country"/>
                            <label for="phone_prefix" string="📞 Phone"/>
                            <div>
                                <field name="phone_prefix"/>
                                <field name="phone_no"/>
                            </div>
                           
                        </group>
                        <group>
                         <field name="source_id" string="🎯 Source" readonly="1"/>
                            <field name="site_ids" widget="many2many_tags" string="📍 Sites"/>
                           <!--
                            <field name="sales_person" string="🧑‍💼 Responsible person" readonly="1"/>
                            <field name="nominated_wing_id" string="🏅 Wing" readonly="1" />
                             <field name="nominated_salesperson_id" string="👤 Nominee Person" readonly="1" invisible="1"/>
                              <field name="assigned_salesperson_id" string="👤 Assigned Person." readonly="1" invisible="state_crm != 'sent'"/>
                                
                            <field name="create_date" string="🗓️ Created On" readonly="1"/> -->
                            <field name="phone_number_message" string="✉️ Message" readonly="1"
                                invisible="not phone_number_message"/>
                        </group>
                         <group string="Duplicate Phone Information" >
                    
                        <field name="phone_number_message" widget="text" nolabel="1" invisible="1"/>
                        <field name="existing_temer_lead_id" readonly="1" invisible="1"/>
                        <field name="existing_lead_state" readonly="1" invisible="1"/>
                        <field name="existing_lead_create_date" readonly="1" invisible="1"/>
                         <field name="existing_salesperson_id" readonly="1"/>
                        <field name="existing_supervisor_id" readonly="1"/>
                   

                </group>
                    </group>

                    <field name="phone_prefix" invisible="1"/>
                    <field name="phone_number" invisible="1"/>
                    <field name="full_phone" invisible="1"/>
                    <field name="full_phone_ids" invisible="1"/>
                    <field name="phone_number_message" invisible="1"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_crm_affilater_tree" model="ir.ui.view">
        <field name="name">crm.affilater.tree</field>
        <field name="model">crm.affilater</field>
        <field name="arch" type="xml">
            <tree string="Referral Lead">
                <field name="name"/>
                <field name="country_id"/>
                <field name="phone_no"/>
                <field name="source_id" widget="badge"/>
                <field name="state_crm" widget="badge"/>
                <field name="assigned_salesperson_id"/>
                <field name="create_date" string="Created On"/>
            </tree>
        </field>
    </record>
    <record id="view_crm_affilater_search" model="ir.ui.view">
        <field name="name">crm.affilater.search</field>
        <field name="model">crm.affilater</field>
        <field name="arch" type="xml">
            <search string="Referral Leads">
                <field name="customer_name"/>
                <field name="country_id"/>
                <field name="site_ids"/>
                <field name="assigned_salesperson_id"/>
                <field name="phone_no"/>
                <filter name="month" string="Created Month" context="{'group_by':'create_date:month'}"/>
            </search>
        </field>
    </record>
</odoo>

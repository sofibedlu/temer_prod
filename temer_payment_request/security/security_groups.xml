<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_temer_payment_request" model="ir.module.category">
            <field name="name">Temer Payment Request</field>
            <field name="sequence">50</field>
        </record>
    </data>

    <data noupdate="0">
        <record id="group_payment_request_creator" model="res.groups">
            <field name="name">Payment Request Creator</field>
            <field name="category_id" ref="module_category_temer_payment_request"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_payment_request_checker" model="res.groups">
            <field name="name">Payment Request Checker</field>
            <field name="category_id" ref="module_category_temer_payment_request"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_payment_request_approver" model="res.groups">
            <field name="name">Payment Request Approver</field>
            <field name="category_id" ref="module_category_temer_payment_request"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_payment_order_confirmer" model="res.groups">
            <field name="name">Payment Order Confirmer</field>
            <field name="category_id" ref="module_category_temer_payment_request"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_account_payment_handler" model="res.groups">
            <field name="name">Account Payment Handler</field>
            <field name="category_id" ref="module_category_temer_payment_request"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_payment_viewer" model="res.groups">
            <field name="name">Payment Viewer</field>
            <field name="category_id" ref="module_category_temer_payment_request"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_payment_request_manager" model="res.groups">
            <field name="name">Payment Request Manager</field>
            <field name="category_id" ref="module_category_temer_payment_request"/>
            <field name="implied_ids" eval="[
                (4, ref('base.group_user')),
                (4, ref('account.group_account_invoice')),
                (4, ref('group_payment_request_creator')),
                (4, ref('group_payment_request_checker')),
                (4, ref('group_payment_request_approver')),
                (4, ref('group_payment_order_confirmer')),
                (4, ref('group_account_payment_handler')),
                (4, ref('group_payment_viewer'))
            ]"/>
        </record>
    </data>
</odoo>
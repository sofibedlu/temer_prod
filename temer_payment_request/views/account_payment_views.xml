<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_tree_inherit_temer" model="ir.ui.view">
        <field name="name">account.payment.tree.inherit.temer</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="create">0</attribute>
                <attribute name="edit">0</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_form_inherit_temer" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.temer</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <!-- Form editable only when user is Handler (PO-generated payments) -->
            <xpath expr="//form" position="attributes">
                <attribute name="create">0</attribute>
                <attribute name="edit">is_editable_by_user</attribute>
            </xpath>
            <xpath expr="//button[@name='action_draft']" position="replace">
            </xpath>
            <xpath expr="//button[@name='action_post']" position="attributes">
                <attribute name="confirm">Are you sure you want to post this payment?</attribute>
                <attribute name="groups">temer_payment_request.group_account_payment_handler,temer_payment_request.group_payment_request_manager</attribute>
            </xpath>
            <xpath expr="//button[@name='action_cancel']" position="attributes">
                <attribute name="name">action_open_cancel_wizard</attribute>
                <attribute name="confirm"></attribute>
                <attribute name="groups">temer_payment_request.group_account_payment_handler,temer_payment_request.group_payment_request_manager</attribute>
            </xpath>
            <xpath expr="//field[@name='ref']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='ref']" position="after">
                <field name="payment_order_id" readonly="1"/>
                <field name="payment_request_id" readonly="1"/>
                <field name="is_editable_by_user" invisible="1"/>
            </xpath>
            <xpath expr="//notebook[@name='payment_notebook']" position="inside">
                <page string="Payment Request Reason" invisible="not payment_request_id">
                    <field name="payment_request_reason" readonly="1"/>
                </page>
            </xpath>
            <xpath expr='//field[@name="partner_id"][@invisible="partner_type != &#39;customer&#39; or is_internal_transfer"]' position="attributes">
                <attribute name="domain">[('customer_rank', '>', 0)]</attribute>
                <attribute name="readonly">state in ('posted', 'sent', 'cancelled', 'reconciled')</attribute>
            </xpath>
            <xpath expr='//field[@name="partner_id"][@invisible="partner_type != &#39;supplier&#39; or is_internal_transfer"]' position="attributes">
                <attribute name="domain">[('supplier_rank', '>', 0)]</attribute>
                <attribute name="readonly">state in ('posted', 'sent', 'cancelled', 'reconciled')</attribute>
            </xpath>
        </field>
    </record>
</odoo>
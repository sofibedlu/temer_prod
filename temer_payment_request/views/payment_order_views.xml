<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payment_order_form" model="ir.ui.view">
        <field name="name">payment.order.form</field>
        <field name="model">payment.order</field>
        <field name="arch" type="xml">
            <form string="Payment Order">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="oe_highlight" invisible="state != 'draft'"
                            groups="temer_payment_request.group_payment_order_confirmer"
                            confirm="This will create an Account Payment and post it. Are you sure you want to confirm?"/>
                    <button name="action_open_cancel_wizard" string="Cancel" type="object"
                            invisible="state != 'draft'"
                            groups="temer_payment_request.group_payment_order_confirmer,temer_payment_request.group_payment_request_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,canceled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="po_number" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="pr_number" readonly="1"/>
                            <field name="pay_to" readonly="state != 'draft'"/>
                            
                            <field name="partner_id" 
                                   string="Payee Name"
                                   options="{'no_create_edit': False, 'no_quick_create': False}"
                                   context="{'default_supplier_rank': 1, 'res_partner_search_mode': 'supplier'}"
                                   domain="[('supplier_rank', '>', 0)]"
                                   readonly="state != 'draft'"
                                   invisible="pay_to == 'customer'"/>
                            
                            <field name="partner_id" 
                                   string="Payee Name"
                                   options="{'no_create_edit': False, 'no_quick_create': False}"
                                   context="{'default_customer_rank': 1, 'res_partner_search_mode': 'customer'}"
                                   domain="[('customer_rank', '>', 0)]"
                                   readonly="state != 'draft'"
                                   invisible="pay_to == 'vendor'"/>
                            
                            <field name="amount" widget="monetary" 
                                   options="{'currency_field': 'currency_id'}" 
                                   readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="confirmed_by" readonly="1" invisible="state != 'confirmed'"/>
                            <field name="confirmed_date" readonly="1" invisible="state != 'confirmed'"/>
                            <field name="canceled_by" readonly="1" invisible="state != 'canceled'"/>
                            <field name="canceled_date" readonly="1" invisible="state != 'canceled'"/>
                            <field name="cancel_reason" readonly="1" invisible="state != 'canceled'"/>
                            <field name="account_payment_id" readonly="1" 
                                   invisible="not account_payment_id"/>
                            <field name="payment_request_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Reason">
                            <field name="reason" readonly="state != 'draft'"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_payment_order_tree" model="ir.ui.view">
        <field name="name">payment.order.tree</field>
        <field name="model">payment.order</field>
        <field name="arch" type="xml">
            <tree string="Payment Orders" 
                  decoration-success="state == 'confirmed'" 
                  decoration-info="state == 'draft'"
                  decoration-danger="state == 'canceled'">
                <field name="po_number"/>
                <field name="pr_number"/>
                <field name="pay_to"/>
                <field name="partner_id"/>
                <field name="amount"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state"/>
                <field name="confirmed_by"/>
                <field name="confirmed_date"/>
                <field name="canceled_by"/>
                <field name="canceled_date"/>
            </tree>
        </field>
    </record>

    <record id="view_payment_order_kanban" model="ir.ui.view">
        <field name="name">payment.order.kanban</field>
        <field name="model">payment.order</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="po_number"/>
                <field name="pr_number"/>
                <field name="pay_to"/>
                <field name="partner_id"/>
                <field name="amount"/>
                <field name="currency_id"/>
                <field name="state"/>
                <field name="reason"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_detail">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <span><t t-esc="record.po_number.value"/></span>
                                        </strong>
                                    </div>
                                    <div class="o_kanban_record_body">
                                        <span class="oe_kanban_list_many2many">
                                            <field name="state" widget="label_selection" 
                                                   options="{'classes': {
                                                       'draft': 'default',
                                                       'confirmed': 'success',
                                                       'canceled': 'danger'
                                                   }}"/>
                                        </span>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div>
                                        <strong>PR:</strong> <t t-esc="record.pr_number.value"/><br/>
                                        <strong>Pay To:</strong> <t t-esc="record.pay_to.value"/><br/>
                                        <strong>Payee:</strong> <t t-esc="record.partner_id.value"/><br/>
                                        <strong>Amount:</strong> 
                                        <field name="amount" widget="monetary" 
                                               options="{'currency_field': 'currency_id'}"/><br/>
                                        <strong>Reason:</strong> 
                                        <t t-esc="record.reason.value" 
                                           style="white-space: pre-wrap; word-wrap: break-word;"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_payment_order_search" model="ir.ui.view">
        <field name="name">payment.order.search</field>
        <field name="model">payment.order</field>
        <field name="arch" type="xml">
            <search string="Payment Orders">
                <field name="po_number"/>
                <field name="pr_number"/>
                <field name="partner_id"/>
                <field name="pay_to"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Canceled" name="canceled" domain="[('state', '=', 'canceled')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_by_state" 
                            domain="[]" context="{'group_by': 'state'}"/>
                    <filter string="Pay To" name="group_by_pay_to" 
                            domain="[]" context="{'group_by': 'pay_to'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_payment_order" model="ir.actions.act_window">
        <field name="name">Payment Orders</field>
        <field name="res_model">payment.order</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="view_payment_order_search"/>
        <field name="groups_id" eval="[(4, ref('temer_payment_request.group_payment_request_creator')), (4, ref('temer_payment_request.group_payment_request_checker')), (4, ref('temer_payment_request.group_payment_request_approver')), (4, ref('temer_payment_request.group_payment_order_confirmer')), (4, ref('temer_payment_request.group_account_payment_handler')), (4, ref('temer_payment_request.group_payment_viewer')), (4, ref('temer_payment_request.group_payment_request_manager'))]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Payment Orders will appear here after Payment Requests are approved!
            </p>
        </field>
    </record>
</odoo>
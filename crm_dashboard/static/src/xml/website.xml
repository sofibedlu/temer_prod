<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="crm_dashboard.website_leads_dashboard">
        <div class="container-fluid" style="max-height: 100vh;">
            <!-- Error Message -->
            <t t-if="stats.errorMessage">
                <div class="alert alert-warning" role="alert">
                    <t t-esc="stats.errorMessage"/>
                </div>
            </t>

            <!-- Charts Section -->
            <div class="card mb-4">
                <div class="card-header">
                    <h3 class="card-title">Website Leads Analysis</h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <!-- Bar Chart -->
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header">
                                    <h4 class="card-title">Leads by Stage (Bar)</h4>
                                </div>
                                <div class="card-body">
                                    <canvas t-ref="websiteChartRef" class="chart-container" style="height: 400px; width: 100%;"/>
                                </div>
                            </div>
                        </div>

                        <!-- Pie Chart -->
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header">
                                    <h4 class="card-title">Leads by Stage (Pie)</h4>
                                </div>
                                <div class="card-body">
                                    <canvas t-ref="websiteChartPieRef" class="chart-container" style="height: 400px; width: 100%;"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <style>
            .chart-container {
                position: relative;
                margin: auto;
            }
            .card {
                box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
                margin-bottom: 1rem;
                overflow: hidden;
            }
            .card-header {
                background-color: #f8f9fa;
                border-bottom: 1px solid rgba(0, 0, 0, 0.125);
            }
            .card-title {
                margin-bottom: 0;
                color: #495057;
            }
            .container-fluid {
                padding-right: 15px;
                padding-left: 15px;
            }
        </style>
    </t>
</templates>
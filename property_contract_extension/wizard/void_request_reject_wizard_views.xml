<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_void_request_reject_wizard_form" model="ir.ui.view">
        <field name="name">void.request.reject.wizard.form</field>
        <field name="model">void.request.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Void Request">
                <group>
                    <field name="void_request_id" invisible="1"/>
                    <field name="reason" placeholder="Enter the reason for rejecting this request..."/>
                </group>
                <footer>
                    <button name="action_confirm_reject" string="Reject Request" type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_void_request_tree" model="ir.ui.view">
        <field name="name">property.contract.void.request.tree</field>
        <field name="model">property.contract.void.request</field>
        <field name="arch" type="xml">
            <tree string="Void Requests" create="0" delete="0" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'">
                <field name="name"/>
                <field name="sale_id"/>
                <field name="property_id"/>
                <field name="partner_id"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'"/>
            </tree>
        </field>
    </record>

    <record id="view_void_request_form" model="ir.ui.view">
        <field name="name">property.contract.void.request.form</field>
        <field name="model">property.contract.void.request</field>
        <field name="arch" type="xml">
            <form string="Void Request" create="0" delete="0">
                <header>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_reject" string="Reject" type="object" class="btn-danger" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,rejected"/>
                </header>
                <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_sale" 
                                    type="object" 
                                    class="oe_stat_button" 
                                    icon="fa-home">
                                <div class="o_stat_info">
                                    <span class="o_stat_text">View Sale</span>
                                </div>
                            </button>
                        </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="property_id"/>
                            <field name="contract_number"/>                          
                        </group>
                        <group>
                            <field name="reason" readonly="1"/>
                            <field name="rejection_reason" invisible="state != 'rejected'"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_void_request" model="ir.actions.act_window">
        <field name="name">Void Contract Requests</field>
        <field name="res_model">property.contract.void.request</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Root Menu for Void Requests -->
    <menuitem id="menu_void_request_root" 
              name="Void Requests"
              sequence="50"
              groups="property_contract_extension.group_property_void_request_menu"/>

    <menuitem id="menu_void_request_action" 
              name="Contract Void Requests" 
              parent="menu_void_request_root" 
              action="action_void_request" 
              sequence="10"
              groups="property_contract_extension.group_property_void_request_menu"/>
</odoo>
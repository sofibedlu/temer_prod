<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_sale_form_inherit_override" model="ir.ui.view">
        <field name="name">property.sale.form.inherit.override</field>
        <field name="model">property.sale</field>
        <field name="inherit_id" ref="advanced_property_management.property_sale_view_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//header" position="inside">
                <button name="%(action_contract_override_wizard)d" 
                        string="Manual Edit Override" 
                        type="action" 
                        class="btn-warning"
                        icon="fa-unlock"
                        groups="property_contract_manual_override.group_contract_manual_overrider"
                        invisible="state not in ['approve', 'done']"/>
            </xpath>

        </field>
    </record>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_sale_form_inherit_payment_lock" model="ir.ui.view">
        <field name="name">property.sale.form.inherit.payment.lock</field>
        <field name="model">property.sale</field>
        <field name="inherit_id" ref="advanced_property_management.property_sale_view_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//field[@name='property_payment_term']" position="after">
                <field name="is_payment_locked" widget="boolean_toggle"/>
            </xpath>

        </field>
    </record>
</odoo>
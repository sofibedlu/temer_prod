<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_site_construction_progress_form_inherit_custom_date" model="ir.ui.view">
        <field name="name">property.site.construction.progress.form.inherit.custom.date</field>
        <field name="model">property.site.construction.progress</field>
        <field name="inherit_id" ref="collection_progress_integration.view_property_site_construction_progress_form_inherit_workflow"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='date']" position="attributes">
                <attribute name="invisible">state == 'draft'</attribute>
                <attribute name="required">state == 'checked'</attribute>
                <attribute name="readonly">state == 'done'</attribute>
            </xpath>

        </field>
    </record>
</odoo>
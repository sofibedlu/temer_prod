<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_discount_request_wizard_form" model="ir.ui.view">
        <field name="name">discount.request.wizard.form</field>
        <field name="model">discount.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Request Discount">
                <group>
                    <field name="collection_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="installment_id"/>
                    <field name="installment_residual"/>
                    <field name="discount_percentage" required="1"/>
                    <field name="discount_amount"/>
                    <field name="remaining_amount"/>
                    <field name="reason"/>
                    <field name="attachment_ids" widget="many2many_binary"/>
                </group>
                <footer>
                    <button name="action_submit_request" string="Submit Request" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_discount_request_tree" model="ir.ui.view">
        <field name="name">discount.request.tree</field>
        <field name="model">discount.request</field>
        <field name="arch" type="xml">
            <tree decoration-warning="state=='pending'" decoration-success="state=='approved'" decoration-danger="state=='rejected'" create="0" delete="0">
                <field name="name"/>
                <field name="collection_id"/>
                <field name="installment_id"/>
                <field name="discount_percentage"/>
                <field name="discount_amount"/>
                <field name="remaining_amount"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-warning="state == 'pending'" decoration-danger="state == 'rejected'"/>
            </tree>
        </field>
    </record>

    <record id="view_discount_request_form" model="ir.ui.view">
        <field name="name">discount.request.form</field>
        <field name="model">discount.request</field>
        <field name="arch" type="xml">
            <form string="Discount Request" create="0" delete="0">
                <header>
                    <button name="action_submit" string="Submit" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-success" invisible="state != 'pending'" groups="collection_discount_request.group_collection_discount_approver"/>
                    <button name="action_reject" string="Reject" type="object" class="btn-danger" invisible="state != 'pending'" groups="collection_discount_request.group_collection_discount_approver"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="collection_id"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="installment_id"/>
                        <field name="discount_percentage"/>
                        <field name="discount_amount"/>
                        <field name="remaining_amount"/>
                        <field name="reason"/>
                        <field name="rejection_reason" invisible="state != 'rejected'"/>
                        <field name="attachment_ids" widget="many2many_binary"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <record id="action_discount_request" model="ir.actions.act_window">
        <field name="name">Discount Requests</field>
        <field name="res_model">discount.request</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_discount_request_root" 
              name="Discount Requests"
              sequence="70"
              groups="collection_discount_request.group_collection_discount_approver"/>
    
    <menuitem id="menu_discount_request_action" 
              name="Partial Settlement Requests" 
              parent="menu_discount_request_root" 
              action="action_discount_request" 
              sequence="10"/>
</odoo>
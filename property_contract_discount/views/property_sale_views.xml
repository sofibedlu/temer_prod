<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_sale_form_inherit_discount" model="ir.ui.view">
        <field name="name">property.sale.form.inherit.discount</field>
        <field name="model">property.sale</field>
        <field name="inherit_id" ref="advanced_property_management.property_sale_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_custom_discount_wizard" 
                        string="Apply Discount" 
                        type="object" 
                        class="oe_highlight"
                        invisible="state not in ['confirm']" />
            </xpath>

            <xpath expr="//field[@name='payment_installment_line_ids']/tree//field[@name='discount']" position="attributes">
                <attribute name="sum">Total Discount</attribute>
                <attribute name="readonly">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
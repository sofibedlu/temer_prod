<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_apply_discount_wizard_form" model="ir.ui.view">
        <field name="name">property.apply.discount.wizard.form</field>
        <field name="model">property.apply.discount.wizard</field>
        <field name="arch" type="xml">
            <form string="Apply Discount">
                <sheet>
                    <group>
                        <group>
                            <field name="sale_id" readonly="1" options="{'no_open': True}"/>
                            <field name="discount_percentage" widget="percentage"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Target Installments">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="payment_line_id" 
                                            options="{'no_create': True, 'no_open': True}"
                                           context="{'tree_view_ref': 'property_contract_discount.view_property_payment_line_tree_discount'}"/>
                                    <field name="previous_amount" readonly="1" force_save="1"/>
                                    <field name="discount_amount"/>
                                    <field name="new_amount" readonly="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_apply_discount" string="Apply" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Module Category -->
        <record model="ir.module.category" id="module_category_installment_update">
            <field name="name">Installment Update</field>
            <field name="sequence">20</field>
        </record>


        <record id="group_installment_update_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_installment_update"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record> 

        <!-- Manager Group: full access, includes User rights -->
        <record id="group_installment_update_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_installment_update"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="implied_ids" eval="[(4, ref('installment_update.group_installment_update_user'))]"/>
        </record>

    </data>
</odoo>

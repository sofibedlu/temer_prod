<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Search View
         ================================================================ -->
    <record id="view_installment_update_log_search" model="ir.ui.view">
        <field name="name">installment.update.log.search</field>
        <field name="model">installment.update.log</field>
        <field name="arch" type="xml">
            <search string="Search Substitution Log">
                <field name="site_id" string="Site / Project"/>
                <field name="old_installment" string="Old Installment"/>
                <field name="new_installment" string="New Installment"/>
                <field name="performed_by" string="Performed By"/>
                <separator/>
                <filter name="filter_today" string="Today"
                        domain="[('substitution_date', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0))),
                                 ('substitution_date', '&lt;=', datetime.datetime.combine(context_today(), datetime.time(23,59,59)))]"/>
                <filter name="filter_this_month" string="This Month"
                        domain="[('substitution_date', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d')),
                                 ('substitution_date', '&lt;=', (context_today() + relativedelta(day=31)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <group expand="1" string="Group By">
                    <filter name="group_site" string="Site"
                            context="{'group_by': 'site_id'}"/>
                    <filter name="group_date" string="Date"
                            context="{'group_by': 'substitution_date:day'}"/>
                    <filter name="group_user" string="Performed By"
                            context="{'group_by': 'performed_by'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================================================================
         Tree View
         ================================================================ -->
    <record id="view_installment_update_log_tree" model="ir.ui.view">
        <field name="name">installment.update.log.tree</field>
        <field name="model">installment.update.log</field>
        <field name="arch" type="xml">
            <tree string="Substitution Log" create="0" edit="0" delete="0"
                  decoration-info="True">
                <field name="substitution_date" string="Date &amp; Time"/>
                <field name="site_id" string="Site / Project"/>
                <field name="old_installment" string="Old Installment"/>
                <field name="new_installment" string="New Installment"/>
                <field name="collection_installment_id" string="Collection Installment" readonly="1"/>
                <field name="collection_count" string="Collections Updated"/>
                <field name="sale_line_count" string="Sale Lines Updated"/>
                <field name="legacy_line_count" string="Legacy Lines Updated"/>
                <field name="performed_by" string="Performed By"/>
            </tree>
        </field>
    </record>

    <!-- ================================================================
         Form View (read-only detail)
         ================================================================ -->
    <record id="view_installment_update_log_form" model="ir.ui.view">
        <field name="name">installment.update.log.form</field>
        <field name="model">installment.update.log</field>
        <field name="arch" type="xml">
            <form string="Substitution Log Entry" create="0" edit="0">
                <sheet>
                    <group>
                        <group string="Substitution Details">
                            <field name="site_id" readonly="1"/>
                            <field name="old_installment" readonly="1"/>
                            <field name="new_installment" readonly="1"/>
                            <field name="substitution_date" readonly="1"/>
                            <field name="performed_by" readonly="1"/>
                        </group>
                        <group string="Records Updated">
                            <field name="collection_count" readonly="1"/>
                            <field name="sale_line_count" readonly="1"/>
                            <field name="legacy_line_count" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ================================================================
         Action
         ================================================================ -->
    <record id="action_installment_update_log" model="ir.actions.act_window">
        <field name="name">Substitution Log</field>
        <field name="res_model">installment.update.log</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_installment_update_log_search"/>
        <field name="context">{'search_default_group_site': 1}</field>
        <field name="target">current</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No substitutions recorded yet.</p>
            <p>Every time an installment is substituted, a log entry is created here.</p>
        </field>
    </record>

    <!-- ================================================================
         Menu (sibling of Update Installment)
         ================================================================ -->
    

    <menuitem
        id="menu_installment_update_log"
        name="Substitution Log"
        parent="advanced_property_management.property_configuration_menu"
        action="action_installment_update_log"
        groups="installment_update.group_installment_update_manager"
        sequence="91"/>

</odoo>

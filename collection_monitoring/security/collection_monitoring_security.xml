<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="group_collection_monitoring" model="res.groups">
            <field name="name">Collection Monitoring</field>
            <field name="category_id" ref="collection_management.module_category_collection_management"/>
            <field name="comment">Users with this group can access the Collection Monitoring menu to view payments sent to the Payment Dashboard.</field>
        </record>
        <!-- Do NOT add Collection Monitoring to Manager - keep it as separate privilege so it can be unchecked -->
        <record id="collection_management.group_collection_manager" model="res.groups">
            <field name="implied_ids" eval="[(3, ref('group_collection_monitoring'))]"/>
        </record>
    </data>
</odoo>

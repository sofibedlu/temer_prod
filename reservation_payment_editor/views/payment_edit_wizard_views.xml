<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_reservation_payment_edit_wizard_form" model="ir.ui.view">
        <field name="name">reservation.payment.edit.wizard.form</field>
        <field name="model">reservation.payment.edit.wizard</field>
        <field name="arch" type="xml">
            <form string="Edit Payment Details">
                <sheet>
                    <!-- Read-only context -->
                    <group string="Payment Info">
                        <group>
                            <field name="payment_id" readonly="1"/>
                            <field name="reservation_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="property_id" readonly="1"/>
                            <field name="customer_id" readonly="1"/>
                        </group>
                    </group>

                    <!-- Editable fields -->
                    <group string="Payment Details">
                        <group>
                            <field name="ref_number" string="Reference Number" required="1"/>
                            <field name="bank_id" string="Bank" required="1"/>
                            <field name="document_type_id" string="Document Type" required="1"/>
                        </group>
                        <group>
                            <field name="amount" string="Amount" required="1"/>
                            <field name="transaction_date" string="Transaction Date" required="1"/>
                            <field name="payment_status" string="Payment Status"/>
                        </group>
                    </group>

                    <group string="Payment Receipt">
                        <field name="payment_receipt_filename" invisible="1"/>
                        <field name="payment_receipt"
                               widget="binary"
                               filename="payment_receipt_filename"
                               string="Payment Receipt"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_save"
                            string="Save Changes"
                            type="object"
                            class="btn-primary"/>
                    <button string="Discard"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

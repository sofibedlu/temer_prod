<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_automated_sms_reminders" model="ir.cron">
        <field name="name">Collection: Send Automated SMS Reminders (2nd and 3rd)</field>
        <field name="model_id" ref="collection_management.model_collection_installment"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_automated_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_property_distribution_location_tree" model="ir.ui.view">
        <field name="name">property.distribution.location.tree</field>
        <field name="model">property.distribution.location</field>
        <field name="arch" type="xml">
            <tree string="Locations" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_property_distribution_location_form" model="ir.ui.view">
        <field name="name">property.distribution.location.form</field>
        <field name="model">property.distribution.location</field>
        <field name="arch" type="xml">
            <form string="Location">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_property_distribution_location_search" model="ir.ui.view">
        <field name="name">property.distribution.location.search</field>
        <field name="model">property.distribution.location</field>
        <field name="arch" type="xml">
            <search string="Locations">
                <field name="name"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_property_distribution_location" model="ir.actions.act_window">
        <field name="name">Locations</field>
        <field name="res_model">property.distribution.location</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <menuitem id="menu_property_distribution_location"
        name="Locations"
        parent="advanced_property_management.property_configuration_menu"
        action="action_property_distribution_location"
        sequence="11"/>

</odoo>

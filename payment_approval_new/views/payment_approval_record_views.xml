<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Payment Approval Record Tree View -->
    <record id="view_payment_approval_record_tree" model="ir.ui.view">
        <field name="name">payment.approval.record.tree</field>
        <field name="model">payment.approval.record</field>
        <field name="arch" type="xml">
            <tree string="Payment Records" decoration-muted="state == 'draft'" decoration-success="state == 'approved'" decoration-danger="state == 'denied'" create="0" delete="0" multi_edit="1">
                <header>
                    <button name="do_bulk_approve" string="Approve" type="object" class="oe_highlight approve-btn" disabled="1"/>
                    <button name="do_bulk_deny" string="Deny" type="object" class="deny-btn" disabled="1"/>
                </header>
                <field name="customer_name" string="Customer Name"/>
                <field name="approved_bank_id" string="Bank"/>
                <field name="reference_number" string="Reference Number"/>
                <field name="amount" sum="Total Amount"/>
                <field name="payment_date"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-danger="state == 'denied'" decoration-muted="state == 'draft'"/>
                <field name="payment_receipt" widget="binary_preview" string="Receipt"/>
            </tree>
        </field>
    </record>

    <!-- Payment Approval Record Form View -->
    <record id="view_payment_approval_record_form" model="ir.ui.view">
        <field name="name">payment.approval.record.form</field>
        <field name="model">payment.approval.record</field>
        <field name="arch" type="xml">
            <form string="Payment Approval">
                <header>
                    <button name="do_approve_payment" string="Approve" type="object" class="oe_highlight" invisible="state == 'approved' or state == 'denied'"/>
                    <button name="do_deny" string="Deny" type="object" invisible="state == 'approved' or state == 'denied'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="open_invoice_record" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="not invoice_id">
                            <field name="invoice_id" widget="statinfo" string="Invoice"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="installment_id" readonly="1"/>
                            <field name="collection_id" readonly="1" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="partner_id" string="Customer" readonly="1"/>
                            <field name="customer_name" readonly="1"/>
                        </group>
                        <group>
                            <field name="amount" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="payment_date" readonly="1"/>
                            <field name="journal_type" readonly="1"/>
                            <field name="bank_id" readonly="1" invisible="state == 'approved'"/>
                            <field name="approved_bank_id" string="Bank" invisible="state != 'approved'"/>
                            <field name="document_type_id" readonly="1"/>
                            <field name="reference_number" string="Reference Number" readonly="1"/>
                        </group>
                    </group>
                    <group string="Attachments">
                        <group string="Payment Receipt">
                            <!-- Show approved_receipt for approved payments if it exists -->
                            <div invisible="state != 'approved' or not approved_receipt">
                                <field name="approved_receipt" widget="binary_preview" readonly="1"/>
                            </div>
                            <!-- Fallback to payment_receipt for approved if approved_receipt is empty, or for draft/denied -->
                            <div invisible="(state == 'approved' and approved_receipt) or (state != 'approved' and not payment_receipt)">
                                <field name="payment_receipt" widget="binary_preview" readonly="1"/>
                            </div>
                        </group>
                    </group>
                    <group string="Discount" invisible="not apply_discount">
                        <field name="apply_discount" invisible="1"/>
                        <field name="discount_percentage" readonly="1"/>
                        <field name="discount_amount" readonly="1"/>
                    </group>
                    <group string="Approval Information" invisible="state == 'draft'">
                        <field name="approved_by" invisible="state != 'approved'"/>
                        <field name="approved_date" invisible="state != 'approved'"/>
                        <field name="denied_by" invisible="state != 'denied'"/>
                        <field name="denied_date" invisible="state != 'denied'"/>
                        <field name="deny_reason" invisible="state != 'denied'"/>
                    </group>
                    <group string="Invoice Information" invisible="not invoice_id">
                        <field name="invoice_id" readonly="1" options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Payment Approval Record Search View -->
    <record id="view_payment_approval_record_search" model="ir.ui.view">
        <field name="name">payment.approval.record.search</field>
        <field name="model">payment.approval.record</field>
        <field name="arch" type="xml">
            <search string="Payment Records">
                <field name="customer_name"/>
                <field name="reference_number"/>
                <field name="partner_id"/>
                <field name="installment_id"/>
                <field name="collection_id"/>
                <field name="payment_date" filter_domain="['|', ('payment_date', '&lt;=', self), ('payment_date', '&gt;=', self)]"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Denied" name="denied" domain="[('state', '=', 'denied')]"/>
                <separator/>
                <filter string="Today" name="today" domain="[('payment_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="This Month" name="this_month" domain="[('payment_date', '&gt;=', (context_today().replace(day=1)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Payment Date" name="group_payment_date" context="{'group_by': 'payment_date'}"/>
                    <filter string="Customer" name="group_customer" context="{'group_by': 'partner_id'}"/>
                    <filter string="Journal Type" name="group_journal_type" context="{'group_by': 'journal_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Incoming Payment Action -->
    <record id="action_payment_approval_incoming" model="ir.actions.act_window">
        <field name="name">Incoming Payment</field>
        <field name="res_model">payment.approval.record</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{'search_default_draft': 1, 'default_state': 'draft'}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_payment_approval_record_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_payment_approval_record_form')})]"/>
        <field name="search_view_id" ref="view_payment_approval_record_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No payment records found
            </p>
            <p>
                Payment records will appear here after being registered from collection orders.
            </p>
        </field>
    </record>

    <!-- Outgoing Payment Action - Shows Vendor Bills (in_invoice) -->
    <record id="action_payment_approval_outgoing" model="ir.actions.act_window">
        <field name="name">Outgoing Payment</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('move_type', '=', 'in_invoice'), ('state', '=', 'draft')]</field>
        <field name="context">{'default_move_type': 'in_invoice', 'search_default_draft': 1, 'create': False}</field>
        <!-- Explicitly clear any view_ids to use default account.move views -->
        <field name="view_ids" eval="[(5, 0, 0)]"/>
        <!-- Explicitly clear search_view_id to use default account.move search view -->
        <field name="search_view_id" eval="False"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No vendor bills found
            </p>
            <p>
                Vendor bills (outgoing payments) will appear here when they are created and need approval.
            </p>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_payment_approval_system"
              name="Payment Dashboard"
              sequence="100"
              groups="payment_approval_new.group_payment_dashboard_user_new"/>
    
    <menuitem id="menu_payment_approval_incoming"
              name="Incoming Payment"
              parent="menu_payment_approval_system"
              action="action_payment_approval_incoming"
              groups="payment_approval_new.group_payment_dashboard_user_new"
              sequence="10"/>
    
    <menuitem id="menu_payment_approval_outgoing"
              name="Outgoing Payment"
              parent="menu_payment_approval_system"
              action="action_payment_approval_outgoing"
              groups="payment_approval_new.group_payment_dashboard_user_new"
              sequence="20"/>
</odoo>


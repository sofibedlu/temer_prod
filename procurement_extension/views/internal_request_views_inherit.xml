<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_internal_request_form_inherit_split" model="ir.ui.view">
        <field name="name">internal.request.form.inherit.split</field>
        <field name="model">internal.request</field>
        <field name="inherit_id" ref="procurement_management.view_internal_request_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//field[@name='responsible_department_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//page[@name='products']/field[@name='line_ids']/tree/field[@name='product_id']" position="after">
                <field name="responsible_department_id" options="{'no_create': True}"/>
            </xpath>

            <!-- Add Security to the Approve Button -->
            <xpath expr="//button[@name='action_approve']" position="attributes">
                <attribute name="groups">procurement_extension.group_internal_request_approver</attribute>
            </xpath>

        </field>
    </record>

    <!-- hide Responsible Department -->
    <record id="view_internal_request_tree_inherit_hide_dept" model="ir.ui.view">
        <field name="name">internal.request.tree.inherit.hide.dept</field>
        <field name="model">internal.request</field>
        <field name="inherit_id" ref="procurement_management.view_internal_request_tree"/>
        <field name="arch" type="xml">
            
            <xpath expr="//field[@name='responsible_department_id']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>

        </field>
    </record>
</odoo>
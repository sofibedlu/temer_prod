<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="group_menu_internal_request" model="res.groups">
            <field name="name">Internal Requests</field>
            <field name="category_id" ref="procurement_management.module_category_procurement_management"/>
        </record>

        <record id="group_menu_department_request" model="res.groups">
            <field name="name">Department Requests</field>
            <field name="category_id" ref="procurement_management.module_category_procurement_management"/>
        </record>

        <record id="group_menu_purchase_department" model="res.groups">
            <field name="name">Purchase Department</field>
            <field name="category_id" ref="procurement_management.module_category_procurement_management"/>
        </record>

        <!-- <record id="group_menu_approved_vendor_bills" model="res.groups">
            <field name="name">Approved Vendor Bills</field>
            <field name="category_id" ref="procurement_management.module_category_procurement_management"/>
        </record> -->

        <!-- APPROVAL GROUPS -->
        <record id="group_internal_request_approver" model="res.groups">
            <field name="name">Internal Request Approver</field>
            <field name="category_id" ref="procurement_management.module_category_procurement_management"/>
        </record>

        <record id="group_department_request_approver" model="res.groups">
            <field name="name">Department Request Approver</field>
            <field name="category_id" ref="procurement_management.module_category_procurement_management"/>
        </record>

        <record id="group_procurement_request_approver" model="res.groups">
            <field name="name">Purchase Request Approver</field>
            <field name="category_id" ref="procurement_management.module_category_procurement_management"/>
        </record>
        
        <record id="procurement_management.group_procurement_manager" model="res.groups">
            <field name="implied_ids" eval="[
                (4, ref('group_menu_internal_request')), 
                (4, ref('group_menu_department_request')), 
                (4, ref('group_menu_purchase_department')),
                (4, ref('group_internal_request_approver')),
                (4, ref('group_department_request_approver')),
                (4, ref('group_procurement_request_approver'))
            ]"/>
        </record>


        <!-- RECORD RULES -->

        <!-- 1. Department Checkers only see records assigned to their Department -->
        <record id="rule_department_request_own_dept" model="ir.rule">
            <field name="name">Department Request: Own Department Only</field>
            <field name="model_id" ref="procurement_management.model_department_request"/>
            <field name="domain_force">[('department_id', '=', user.employee_id.department_id.id)]</field>
            <field name="groups" eval="[(4, ref('procurement_extension.group_menu_department_request'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- 2. Procurement Managers see ALL Department Requests -->
        <record id="rule_department_request_all" model="ir.rule">
            <field name="name">Department Request: All Records (Managers)</field>
            <field name="model_id" ref="procurement_management.model_department_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('procurement_management.group_procurement_manager'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- 3. Internal Users only see Internal Requests for their own Department -->
        <record id="rule_internal_request_own_dept" model="ir.rule">
            <field name="name">Internal Request: Own Department Only</field>
            <field name="model_id" ref="procurement_management.model_internal_request"/>
            <field name="domain_force">[('department_id', '=', user.employee_id.department_id.id)]</field>
            <field name="groups" eval="[(4, ref('procurement_extension.group_menu_internal_request'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- 4. Procurement Managers see ALL Internal Requests -->
        <record id="rule_internal_request_all" model="ir.rule">
            <field name="name">Internal Request: All Records (Managers)</field>
            <field name="model_id" ref="procurement_management.model_internal_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('procurement_management.group_procurement_manager')), (4, ref('procurement_extension.group_menu_purchase_department')), (4, ref('procurement_extension.group_menu_department_request'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>
    </data>
</odoo>
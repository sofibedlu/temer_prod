<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ============================================================
         Inherit the extension form view to:
         1. Show "Pending Final Approval" in the statusbar
         2. Replace the Approve button behaviour (now sends to pending_final_approval)
         3. Add Final Approve / Final Reject buttons for the CEO role
    ============================================================ -->
    <record id="view_reservation_extend_form_final_approve_inherit" model="ir.ui.view">
        <field name="name">property.reservation.extend.history.form.final.approve</field>
        <field name="model">property.reservation.extend.history</field>
        <field name="inherit_id" ref="ahadubit_property_reservation.property_reservation_extend_view_form"/>
        <field name="arch" type="xml">

            <!-- Replace the statusbar to include the new state -->
            <xpath expr="//field[@name='status'][@widget='statusbar']" position="replace">
                <field name="status" widget="statusbar"
                       statusbar_visible="pending,pending_final_approval,approved"/>
            </xpath>

            <!-- Replace the existing Approve button so it now sends to pending_final_approval -->
            <xpath expr="//button[@name='approve_extension']" position="replace">
                <button name="approve_extension"
                        string="Approve"
                        type="object"
                        class="btn-primary"
                        invisible="status != 'pending'"/>
            </xpath>

            <!-- Add Final Approve / Final Reject buttons after the existing Reject button -->
            <xpath expr="//button[@name='reject_extension']" position="after">
                <button name="action_final_approve_extension"
                        string="Final Approve"
                        type="object"
                        class="btn-success"
                        invisible="status != 'pending_final_approval'"
                        groups="extension_final_approve.group_extension_final_approver"/>
                <button name="action_final_reject_extension"
                        string="Final Reject"
                        type="object"
                        class="btn-danger"
                        invisible="status != 'pending_final_approval'"
                        groups="extension_final_approve.group_extension_final_approver"/>
            </xpath>

        </field>
    </record>

    <!-- ============================================================
         Inherit the extension tree view to show the new state
    ============================================================ -->
    <record id="view_reservation_extend_tree_final_approve_inherit" model="ir.ui.view">
        <field name="name">property.reservation.extend.history.tree.final.approve</field>
        <field name="model">property.reservation.extend.history</field>
        <field name="inherit_id" ref="ahadubit_property_reservation.property_reservation_extend_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="decoration-warning">status == 'pending_final_approval'</attribute>
            </xpath>
        </field>
    </record>

    <!-- ============================================================
         Dedicated action for the CEO / Final Approver menu:
         shows only extensions that are pending final approval
    ============================================================ -->
    <record id="action_extension_pending_final_approval" model="ir.actions.act_window">
        <field name="name">Pending Extension Approvals</field>
        <field name="res_model">property.reservation.extend.history</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('status', '=', 'pending_final_approval')]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No extension requests are pending final approval.
            </p>
        </field>
    </record>

    <record id="action_extension_approved" model="ir.actions.act_window">
        <field name="name">Approved Extensions</field>
        <field name="res_model">property.reservation.extend.history</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('status', '=', 'approved')]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No extension requests have been approved.
            </p>
        </field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Editable Tree View -->
    <record id="commercial_gross_range_view_tree" model="ir.ui.view">
        <field name="name">commercial.gross.range.tree</field>
        <field name="model">commercial.gross.range</field>
        <field name="arch" type="xml">
            <tree string="Commercial Gross Ranges" editable="bottom">
                <field name="gross_min" string="Min (m²)" width="150"/>
                <field name="gross_max" string="Max (m²)" width="150"/>
            </tree>
        </field>
    </record>

    <!-- Action: tree only, no form -->
    <record id="action_commercial_gross_range" model="ir.actions.act_window">
        <field name="name">Commercial Gross Range</field>
        <field name="res_model">commercial.gross.range</field>
        <field name="view_mode">tree</field>
    </record>

    <!-- Menu under Configuration -->
    <menuitem
        id="menu_commercial_gross_range"
        name="Commercial Gross Range"
        parent="advanced_property_management.property_configuration_menu"
        action="action_commercial_gross_range"
        sequence="26"/>

</odoo>

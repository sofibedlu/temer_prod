<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_sale_form_reset_inherit" model="ir.ui.view">
        <field name="name">property.sale.form.reset.inherit</field>
        <field name="model">property.sale</field>
        <field name="inherit_id" ref="advanced_property_management.property_sale_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_set_to_request_for_confirm" 
                        string="Request For Confirmation" 
                        type="object"
                        groups="property_sale_reset.group_property_sale_reset_action"
                        invisible="state in ('draft', 'void', 'request_for_confirm')"/>
            </xpath>
        </field>
    </record>
</odoo>
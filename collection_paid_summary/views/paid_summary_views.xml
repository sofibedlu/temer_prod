<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1. The Custom 2-Column Tree View -->
    <record id="view_collection_paid_summary_tree" model="ir.ui.view">
        <field name="name">collection.paid.summary.tree</field>
        <field name="model">collection.installment</field>
        <field name="arch" type="xml">
            <!-- create, edit, and delete are set to 0 to make it a pure reporting view -->
            <tree string="Paid Installments" create="0" edit="0" delete="0">
                <field name="name" string="Installment"/>
                <!-- sum="Total" automatically calculates the total at the bottom of the list -->
                <field name="amount_paid" string="Amount" sum="Total Paid"/>
            </tree>
        </field>
    </record>

    <!-- 2. The Custom Search View for Filtering -->
    <record id="view_collection_paid_summary_search" model="ir.ui.view">
        <field name="name">collection.paid.summary.search</field>
        <field name="model">collection.installment</field>
        <field name="arch" type="xml">
            <search string="Search Paid Installments">
                <!-- Allows the user to type and filter by Site or Installment Name -->
                <field name="site_id" string="Site"/>
                <field name="name" string="Installment Name"/>
                
                <!-- Quick Group-By options for better reporting -->
                <group expand="0" string="Group By">
                    <filter string="Site" name="group_site" context="{'group_by':'site_id'}"/>
                    <filter string="Installment Name" name="group_name" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- 3. The Window Action -->
    <record id="action_collection_paid_summary" model="ir.actions.act_window">
        <field name="name">Paid Installments Summary</field>
        <field name="res_model">collection.installment</field>
        <field name="view_mode">tree</field>
        <!-- Magic Domain: Only pulls records where state is 'paid' -->
        <field name="domain">[('state', '=', 'paid')]</field>
        
        <!-- Force Odoo to use OUR custom views, not the standard collection views -->
        <field name="view_id" ref="view_collection_paid_summary_tree"/>
        <field name="search_view_id" ref="view_collection_paid_summary_search"/>
    </record>

    <!-- 4. The Menu Item -->
    <menuitem id="menu_collection_paid_summary"
              name="Paid Installments Summary"
              parent="collection_management.menu_collection_root" 
              action="action_collection_paid_summary"
              groups="collection_paid_summary.group_collection_paid_summary_viewer"
              sequence="90"/>

</odoo>
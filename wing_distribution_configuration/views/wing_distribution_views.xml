<odoo>
    <!-- Extend Reception form: use crm_custom_menu existing UI; hide Send SMS to Existing button (SMS is Wing-only, auto-sent); Customer Phones tab -->
    <record id="view_crm_reception_form_wing_distribution" model="ir.ui.view">
        <field name="name">crm.reception.form.wing.distribution</field>
        <field name="model">crm.reception</field>
        <field name="inherit_id" ref="crm_custom_menu.view_crm_reception_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='customer_name']" position="after">
                <field name="source_id" string="🎯 Source"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <field name="phone_number_message" invisible="not phone_number_message"
                       class="bg-warning p-2 rounded" readonly="1"/>
                <field name="existing_salesperson_id" readonly="1"
                       invisible="not existing_salesperson_id" string="Original Salesperson"/>
                <field name="existing_temer_lead_id" invisible="1"/>
                <field name="wing_duplicate_popup_pending" invisible="1"/>
            </xpath>
            <xpath expr="//button[@name='action_send_sms_to_existing_customer']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='assigned_salesperson_id']" position="before">
                <field name="assigned_salesperson_name" string="Assigned Sales Person" readonly="1"/>
                <field name="assigned_salesperson_phone" string="Assigned Sales Person Phone" readonly="1"/>
                <field name="assigned_supervisor_name" string="Assigned Salesperson Supervisor" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='new_phone']" position="after">
                <button name="action_add_phone_and_save" type="object" string="Save" class="oe_highlight oe_inline" icon="fa-save" invisible="state_crm == 'draft'"/>
            </xpath>
            <xpath expr="//field[@name='assigned_salesperson_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='full_phone'][@invisible='1']" position="before">
                <notebook>
                    <page string="Customer Phones">
                        <field name="full_phone" nolabel="1" mode="tree" class="o_customer_phones_no_add" context="{'default_reception_record_id': active_id}">
                            <tree string="Phone Numbers" create="false" delete="false" editable="false">
                                <field name="country_id" string="Country"/>
                                <field name="name" string="Phone Number"/>
                                <field name="create_date" string="Datetime"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <!-- Extend Reception tree: remove Phone no column, show Phones (all) and assigned phone -->
    <record id="view_crm_reception_tree_wing_distribution" model="ir.ui.view">
        <field name="name">crm.reception.tree.wing.distribution</field>
        <field name="model">crm.reception</field>
        <field name="inherit_id" ref="crm_custom_menu.view_crm_reception_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='new_phone']" position="replace">
                <field name="full_phone" string="Phones" widget="many2many_tags" optional="show"/>
                <field name="source_id" string="Source" widget="badge" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='assigned_salesperson_id']" position="after">
                <field name="assigned_salesperson_phone" string="Assigned Phone" optional="show"/>
            </xpath>
        </field>
    </record>


    <record id="view_wing_distribution_line_tree" model="ir.ui.view">
        <field name="name">wing.distribution.line.tree</field>
        <field name="model">wing.distribution.line</field>
        <field name="arch" type="xml">
            <tree editable="bottom" create="1" delete="1" multi_edit="1">
                <field name="user_id" domain="[('id', 'in', user_domain_ids)]"/>
                <field name="user_domain_ids" column_invisible="1"/>
                <field name="wing_id" readonly="1"/>
                <field name="distribution_type_ids" widget="many2many_tags" domain="[('id', 'not in', type_ids_already_used_by_user)]"/>
                <field name="type_ids_already_used_by_user" column_invisible="1"/>
                <field name="status"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_wing_distribution_line_form" model="ir.ui.view">
        <field name="name">wing.distribution.line.form</field>
        <field name="model">wing.distribution.line</field>
        <field name="arch" type="xml">
            <form string="Wing Distribution">
                <sheet>
                    <group>
                        <field name="user_id" domain="[('id', 'in', user_domain_ids)]"/>
                        <field name="wing_id" readonly="1"/>
                        <field name="distribution_type_ids" widget="many2many_tags" domain="[('id', 'not in', type_ids_already_used_by_user)]"/>
                        <field name="type_ids_already_used_by_user" invisible="1"/>
                        <field name="status"/>
                        <field name="active"/>
                    </group>
                    <field name="user_domain_ids" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_wing_distribution_line_search" model="ir.ui.view">
        <field name="name">wing.distribution.line.search</field>
        <field name="model">wing.distribution.line</field>
        <field name="arch" type="xml">
            <search string="Wing Distribution">
                <field name="user_id"/>
                <field name="wing_id"/>
                <field name="distribution_type_ids"/>
                <field name="status"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Inactive" domain="[('active', '=', False)]"/>
                <filter name="served" string="Served" domain="[('status', '=', 'served')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_by_wing" string="Wing" context="{'group_by': 'wing_id'}"/>
                    <filter name="group_by_type" string="Distribution Type" context="{'group_by': 'distribution_type_ids'}"/>
                    <filter name="group_by_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_wing_distribution_line" model="ir.actions.act_window">
        <field name="name">Wing Distribution</field>
        <field name="res_model">wing.distribution.line</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_wing_distribution_line_tree"/>
        <field name="context">{'active_test': False, 'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add distribution users to control reception assignment. Use Action → Archive / Unarchive to activate or deactivate lines.
            </p>
        </field>
    </record>

    <!-- Round model: no menu for wing distribution users (config/admin only). Views/action kept for system use. -->
    <record id="view_wing_distribution_round_tree" model="ir.ui.view">
        <field name="name">wing.distribution.round.tree</field>
        <field name="model">wing.distribution.round</field>
        <field name="arch" type="xml">
            <tree string="Rounds" create="0" delete="0">
                <field name="name"/>
                <field name="distribution_type_id"/>
                <field name="status"/>
                <field name="date_started"/>
                <field name="date_served"/>
            </tree>
        </field>
    </record>

    <record id="action_wing_distribution_round" model="ir.actions.act_window">
        <field name="name">Distribution Rounds</field>
        <field name="res_model">wing.distribution.round</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p>Round 1 started when first assignment runs; when all in round are served, round finishes and Round 2 starts. (Config only – not shown to wing distribution users.)</p>
        </field>
    </record>

    <menuitem
        id="menu_wing_distribution_root"
        name="Wing Distribution"
        sequence="15"
        groups="wing_distribution_configuration.group_wing_distribution_user"
    />

    <menuitem

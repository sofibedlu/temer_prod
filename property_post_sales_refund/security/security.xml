<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="category_refund_management" model="ir.module.category">
        <field name="name">Refund Management</field>
        <field name="sequence">15</field>
    </record>

    <record id="group_refund_collection_user" model="res.groups">
        <field name="name">Collection User</field>
        <field name="category_id" ref="category_refund_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_refund_collection_manager" model="res.groups">
        <field name="name">Collection Manager</field>
        <field name="category_id" ref="category_refund_management"/>
        <field name="implied_ids" eval="[(4, ref('property_post_sales_refund.group_refund_collection_user'))]"/>
    </record>

    <record id="group_refund_after_sales_director" model="res.groups">
        <field name="name">After Sales Director</field>
        <field name="category_id" ref="category_refund_management"/>
    </record>

    <record id="group_refund_finance_approver" model="res.groups">
        <field name="name">Finance Approver</field>
        <field name="category_id" ref="category_refund_management"/>
    </record>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ethiopian_calendar_config_form" model="ir.ui.view">
        <field name="name">property.ethiopian.calendar.config.form</field>
        <field name="model">property.ethiopian.calendar.config</field>
        <field name="arch" type="xml">
            <form string="Ethiopian Calendar Configuration">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" nolabel="1"/></h1>
                    </div>
                    <group>
                        <field name="format_string" placeholder="e.g. እስከ {month} {day_num} ቀን {year_num} ዓ.ም"/>
                    </group>
                    <notebook>
                        <page string="Months Mapping">
                            <field name="month_ids">
                                <tree editable="bottom">
                                    <field name="month_number"/>
                                    <field name="name"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Numbers Mapping">
                            <field name="number_ids">
                                <tree editable="bottom">
                                    <field name="category"/>
                                    <field name="value" invisible="category == 'special'"/>
                                    <field name="special_key" invisible="category != 'special'"/>
                                    <field name="name"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ethiopian_calendar_config" model="ir.actions.act_window">
        <field name="name">Ethiopian Date Configuration</field>
        <field name="res_model">property.ethiopian.calendar.config</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_ethiopian_calendar_config"
              name="Ethiopian Date Format"
              parent="advanced_property_management.property_configuration_menu"
              action="action_ethiopian_calendar_config"
              sequence="100"/>
</odoo>
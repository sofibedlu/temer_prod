<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1. Product Segmentation Tree -->
    <record id="view_collection_report_product_tree" model="ir.ui.view">
        <field name="name">collection.report.product.tree</field>
        <field name="model">collection.segmentation.report</field>
        <field name="arch" type="xml">
            <tree string="Product Segmentation" create="0" edit="0" delete="0">
                <field name="collection_id" string="Collection Order"/>
                <field name="property_type"/>
                <field name="site_id"/>
                <field name="unit_type"/>
                <field name="floor_number"/>
                <field name="unit_number"/>
                <field name="gross_area"/>
                <field name="net_area"/>
            </tree>
        </field>
    </record>

    <!-- 2. Sales-force Segmentation Tree -->
    <record id="view_collection_report_sales_tree" model="ir.ui.view">
        <field name="name">collection.report.sales.tree</field>
        <field name="model">collection.salesforce.report</field>
        <field name="arch" type="xml">
            <tree string="Sales-force Segmentation" create="0" edit="0" delete="0">
                <!-- <field name="collection_id" string="Collection Order"/> -->
                <field name="supervisor_id"/>
                <field name="officer_id"/>
            </tree>
        </field>
    </record>

    <!-- 3. Customer Segmentation Tree -->
    <record id="view_collection_report_customer_tree" model="ir.ui.view">
        <field name="name">collection.report.customer.tree</field>
        <field name="model">collection.segmentation.report</field>
        <field name="arch" type="xml">
            <tree string="Customer Segmentation" create="0" edit="0" delete="0">
                <field name="customer_name"/>
                <field name="agreement_number"/>
                <field name="contact_number"/>
            </tree>
        </field>
    </record>

    <!-- 4. Periodical Segmentation Tree -->
    <record id="view_collection_report_periodical_tree" model="ir.ui.view">
        <field name="name">collection.report.periodical.tree</field>
        <field name="model">collection.segmentation.report</field>
        <field name="arch" type="xml">
            <tree string="Periodical Segmentation" create="0" edit="0" delete="0">
                <field name="collection_id" string="Collection Order"/>
                <field name="contract_date"/>
                <field name="payment_round_number" string="Last Paid Round"/>
                <field name="paid_date" string="Last Paid Date"/>
            </tree>
        </field>
    </record>

    <!-- 5. Result Metrics Tree -->
    <record id="view_collection_report_result_metrics_tree" model="ir.ui.view">
        <field name="name">collection.report.result.metrics.tree</field>
        <field name="model">collection.segmentation.report</field>
        <field name="arch" type="xml">
            <tree string="Result Metrics" create="0" edit="0" delete="0">
                <field name="collection_id" string="Collection Order"/>
                <field name="reg_collection"/>
                <field name="penalty_recovery"/>
                <field name="termination_recovery"/>
                <field name="other_collection"/>
            </tree>
        </field>
    </record>

    <!-- 6. Quality Metrics Tree -->
    <record id="view_collection_report_quality_metrics_tree" model="ir.ui.view">
        <field name="name">collection.report.quality.metrics.tree</field>
        <field name="model">collection.segmentation.report</field>
        <field name="arch" type="xml">
            <tree string="Quality Metrics" create="0" edit="0" delete="0">
                <field name="collection_id" string="Collection Order"/>
                <field name="collection_rec_rate"/>
                <field name="due_rec_rate"/>
                <field name="payment_extensions"/>
                <field name="advance_remaining"/>
                <field name="void_customers"/>
                <field name="term_customers"/>
                <field name="fully_paid"/>
                <field name="installments_paid"/>
            </tree>
        </field>
    </record>


    <!-- Window Actions -->
    
    <record id="action_report_product" model="ir.actions.act_window">
        <field name="name">Product Segmentation</field>
        <field name="res_model">collection.segmentation.report</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_collection_report_product_tree"/>
    </record>
    
    <record id="action_report_sales" model="ir.actions.act_window">
        <field name="name">Sales-force Segmentation</field>
        <field name="res_model">collection.salesforce.report</field>
        <field name="view_mode">tree</field>
        <!-- <field name="domain">[('supervisor_id', '!=', False)]</field> -->
        <field name="view_id" ref="view_collection_report_sales_tree"/>
    </record>

    <record id="action_report_customer" model="ir.actions.act_window">
        <field name="name">Customer Segmentation</field>
        <field name="res_model">collection.segmentation.report</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_collection_report_customer_tree"/>
    </record>

    <record id="action_report_periodical" model="ir.actions.act_window">
        <field name="name">Periodical Segmentation</field>
        <field name="res_model">collection.segmentation.report</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_collection_report_periodical_tree"/>
    </record>

    <record id="action_report_result_metrics" model="ir.actions.act_window">
        <field name="name">Result Metrics</field>
        <field name="res_model">collection.segmentation.report</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_collection_report_result_metrics_tree"/>
    </record>

    <record id="action_report_quality_metrics" model="ir.actions.act_window">
        <field name="name">Quality Metrics</field>
        <field name="res_model">collection.segmentation.report</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_collection_report_quality_metrics_tree"/>
    </record>

    <!-- Menu Hierarchy -->
    <menuitem id="menu_collection_reporting_root"
              name="Collection Reports"
              web_icon="fa fa-bar-chart,#ffffff,#1E88E5"
              groups="collection_segmentation_report.group_collection_reporting_access"
              sequence="85"/>

    <menuitem id="menu_report_product" name="Product Segmentation" parent="menu_collection_reporting_root" action="action_report_product" sequence="10"/>
    <menuitem id="menu_report_sales" name="Sales-force Segmentation" parent="menu_collection_reporting_root" action="action_report_sales" sequence="20"/>
    <menuitem id="menu_report_customer" name="Customer Segmentation" parent="menu_collection_reporting_root" action="action_report_customer" sequence="30"/>
    <menuitem id="menu_report_periodical" name="Periodical Segmentation" parent="menu_collection_reporting_root" action="action_report_periodical" sequence="40"/>
    <menuitem id="menu_report_result_metrics" 
              name="Result Metrics" 
              parent="menu_collection_reporting_root" 
              action="action_report_result_metrics" 
              sequence="50"/>

    <menuitem id="menu_report_quality_metrics" 
              name="Quality Metrics" 
              parent="menu_collection_reporting_root" 
              action="action_report_quality_metrics" 
              sequence="60"/>
</odoo>
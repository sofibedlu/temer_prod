                    <!-- Buttons -->
                    <div style="display:flex;gap:18px;justify-content:flex-end;">
                        <!-- <button string="Save Signature" type="object" name="action_save_signatures" class="btn btn-info"/> -->
                        <button string="Submit" type="object" name="action_submit" class="btn btn-primary" invisible="state != 'draft'"/>
                        <!-- <button string="Supervisor Approve" type="object" name="action_supervisor_approve" class="btn btn-info" invisible="state != 'submitted'" groups="special_reservation.group_supervisor"/> -->
                        <button string="Supervisor Approve" type="object" name="action_manager_approve" class="btn btn-warning" invisible="state != 'submitted'" groups="special_reservation.group_supervisor"/>
                        <!-- <button string="Manager Approve" type="object" name="action_ceo_approve" class="btn btn-success" invisible="state != 'manager'" groups="special_reservation.group_manager"/> -->
                        <button string="Return to Draft" type="object" name="action_return_to_draft" class="btn btn-secondary" invisible="state != 'ceo'" groups="special_reservation.group_ceo"/>
                        <button string="Final Approve" type="object" name="action_final_approve" class="btn btn-success" invisible="state != 'ceo'" groups="special_reservation.group_ceo"/>
                        <button string="Reject" type="object" name="action_reject" class="btn btn-danger" invisible="state in ('approved','rejected')"/>
                        <button string="Cancel" special="cancel" class="btn btn-secondary"/>

                        <!-- <button string="Download PDF" type="object" name="action_download_pdf" class="btn btn-secondary fa fa-download" invisible="not state in ('approved','ceo','manager','supervisor','submitted')"/> -->
                    </div>
                </div>

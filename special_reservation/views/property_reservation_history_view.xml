<record id="action_special_approval_submitted_requests" model="ir.actions.act_window">
    <field name="name">Submitted Requests</field>
    <field name="res_model">property.reservation</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[('state', '=', 'submitted')]</field>
</record>

<record id="action_special_approval_supervisor_requests" model="ir.actions.act_window">
    <field name="name">Supervisor Requests</field>
    <field name="res_model">property.reservation</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[('state', '=', 'supervisor')]</field>
</record>
<record id="action_special_approval_manager_requests" model="ir.actions.act_window">
    <field name="name">Manager Requests</field>
    <field name="res_model">property.reservation</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[('state', '=', 'manager')]</field>
</record>

<record id="action_special_approval_ceo_requests" model="ir.actions.act_window">
    <field name="name">CEO Requests</field>
    <field name="res_model">property.reservation</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[('state', '=', 'ceo')]</field>
</record>
<record id="action_special_approval_ceo_approved_requests" model="ir.actions.act_window">
    <field name="name">Approved Requests</field>
    <field name="res_model">property.reservation</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[('state', '=', 'approved')]</field>
</record>
<record id="action_special_approval_ceo_rejected_requests" model="ir.actions.act_window">
    <field name="name">Rejected Requests</field>
    <field name="res_model">property.reservation</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[('state', '=', 'rejected')]</field>
</record>

<menuitem id="menu_special_approval_supervisor_requests_action"
          name="Special Reservation  Requests"
          action="action_special_approval_submitted_requests"
          groups="special_reservation.group_supervisor"
          sequence="-100"/>

<menuitem id="menu_special_approval_ceo_requests_action"
          name="Special Reservation  Requests"
          groups="special_reservation.group_ceo"
          sequence="-100"/>

<menuitem id="menu_special_approval_ceo_requests_action_first_one"
           name="Special Reservation Requests"
          parent="menu_special_approval_ceo_requests_action"
          action="action_special_approval_ceo_requests" 
          groups="special_reservation.group_ceo"
          sequence="-50"/>

<menuitem id="menu_special_approval_ceo_approved_requests_action"
          name="Approved Requests"
          parent="menu_special_approval_ceo_requests_action"
          action="action_special_approval_ceo_approved_requests"
          groups="special_reservation.group_ceo"/>

<menuitem id="menu_special_approval_ceo_rejected_requests_action"
          name="Rejected Requests"
          parent="menu_special_approval_ceo_requests_action"
          action="action_special_approval_ceo_rejected_requests"
          groups="special_reservation.group_ceo"/>


</odoo>






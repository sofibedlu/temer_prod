<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_collection_order_form_extra_installments" model="ir.ui.view">
        <field name="name">collection.order.form.extra.installments</field>
        <field name="model">collection.order</field>
        <field name="inherit_id" ref="collection_management.view_collection_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Others">
                    <group>
                        <group>
                            <field name="previous_installment_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="warning_installment_id" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
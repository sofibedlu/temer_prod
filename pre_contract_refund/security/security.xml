<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_pre_contract_refund" model="ir.module.category">
        <field name="name">Pre Contract Refund</field>
        <field name="sequence">55</field>
    </record>

    <record id="group_pre_contract_refund_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_pre_contract_refund"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_pre_contract_refund_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_pre_contract_refund"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <record id="group_pre_contract_refund_deputy_head_pmca" model="res.groups">
        <field name="name">Deputy Head of PMCA</field>
        <field name="category_id" ref="module_category_pre_contract_refund"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_pre_contract_refund_head_pmca" model="res.groups">
        <field name="name">Head of PMCA</field>
        <field name="category_id" ref="module_category_pre_contract_refund"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_pre_contract_refund_auditor" model="res.groups">
        <field name="name">Auditor</field>
        <field name="category_id" ref="module_category_pre_contract_refund"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_pre_contract_refund_payment_viewer" model="res.groups">
        <field name="name">Refund Payment Viewer</field>
        <field name="category_id" ref="module_category_pre_contract_refund"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_pre_contract_refund_manager_all" model="ir.rule">
        <field name="name">Pre Contract Refund Manager: All Refunds</field>
        <field name="model_id" ref="model_property_pre_contract_refund"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('pre_contract_refund.group_pre_contract_refund_manager'))]"/>
    </record>

    <record id="rule_pre_contract_refund_user_own" model="ir.rule">
        <field name="name">Pre Contract Refund User: Own Refunds</field>
        <field name="model_id" ref="model_property_pre_contract_refund"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('pre_contract_refund.group_pre_contract_refund_user'))]"/>
    </record>

    <record id="rule_pre_contract_refund_deputy_amount" model="ir.rule">
        <field name="name">Deputy Head PMCA: Full Cancellation Refunds up to 500,000</field>
        <field name="model_id" ref="model_property_pre_contract_refund"/>
        <field name="domain_force">[('refund_amount', '&lt;=', 500000), ('refund_type_code', '=', 'full_cancellation')]</field>
        <field name="groups" eval="[(4, ref('pre_contract_refund.group_pre_contract_refund_deputy_head_pmca'))]"/>
    </record>

    <record id="rule_pre_contract_refund_head_amount" model="ir.rule">
        <field name="name">Head PMCA: Final Approval and High Value Refunds</field>
        <field name="model_id" ref="model_property_pre_contract_refund"/>
        <field name="domain_force">['|', '|', '|', '|', ('refund_amount', '&gt;', 500000), ('state', '=', 'pending_approval'), ('state', '=', 'approved'), ('state', '=', 'retained'), ('state', '=', 'paid')]</field>
        <field name="groups" eval="[(4, ref('pre_contract_refund.group_pre_contract_refund_head_pmca'))]"/>
    </record>

    <record id="rule_pre_contract_refund_payment_viewer" model="ir.rule">
        <field name="name">Payment Viewer: Approved and Paid Refunds</field>
        <field name="model_id" ref="model_property_pre_contract_refund"/>
        <field name="domain_force">[('state', 'in', ['approved', 'paid'])]</field>
        <field name="groups" eval="[(4, ref('pre_contract_refund.group_pre_contract_refund_payment_viewer'))]"/>
    </record>

    <record id="rule_pre_contract_refund_auditor" model="ir.rule">
        <field name="name">Pre Contract Refund Auditor: Approved Refunds</field>
        <field name="model_id" ref="model_property_pre_contract_refund"/>
        <field name="domain_force">[('state', '=', 'approved'), ('is_paid', '=', False)]</field>
        <field name="groups" eval="[(4, ref('pre_contract_refund.group_pre_contract_refund_auditor'))]"/>
    </record>

    <record id="rule_pre_contract_refund_attachment_read" model="ir.rule">
        <field name="name">Pre Contract Refund: Read Linked Attachments</field>
        <field name="model_id" ref="base.model_ir_attachment"/>
        <field name="domain_force">[('res_model', '=', 'property.pre.contract.refund')]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="groups" eval="[
            (4, ref('pre_contract_refund.group_pre_contract_refund_user')),
            (4, ref('pre_contract_refund.group_pre_contract_refund_manager')),
            (4, ref('pre_contract_refund.group_pre_contract_refund_deputy_head_pmca')),
            (4, ref('pre_contract_refund.group_pre_contract_refund_head_pmca')),
            (4, ref('pre_contract_refund.group_pre_contract_refund_auditor')),
            (4, ref('pre_contract_refund.group_pre_contract_refund_payment_viewer'))
        ]"/>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pre_contract_refund_type_tree" model="ir.ui.view">
        <field name="name">property.pre.contract.refund.type.tree</field>
        <field name="model">property.pre.contract.refund.type</field>
        <field name="arch" type="xml">
            <tree string="Refund Types" delete="0">
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_pre_contract_refund_type_form" model="ir.ui.view">
        <field name="name">property.pre.contract.refund.type.form</field>
        <field name="model">property.pre.contract.refund.type</field>
        <field name="arch" type="xml">
            <form string="Refund Type" delete="0">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="active"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_pre_contract_refund_type_search" model="ir.ui.view">
        <field name="name">property.pre.contract.refund.type.search</field>
        <field name="model">property.pre.contract.refund.type</field>
        <field name="arch" type="xml">
            <search string="Refund Types">
                <field name="name"/>
                <field name="code"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_pre_contract_refund_type" model="ir.actions.act_window">
        <field name="name">Refund Types</field>
        <field name="res_model">property.pre.contract.refund.type</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>
</odoo>

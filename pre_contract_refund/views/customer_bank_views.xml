<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_customer_bank_form" model="ir.ui.view">
        <field name="name">property.customer.bank.form</field>
        <field name="model">property.customer.bank</field>
        <field name="arch" type="xml">
            <form string="Bank">
                <sheet>
                    <group>
                        <field name="bank_name" placeholder="e.g. Awash Bank"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_property_customer_bank_search" model="ir.ui.view">
        <field name="name">property.customer.bank.search</field>
        <field name="model">property.customer.bank</field>
        <field name="arch" type="xml">
            <search string="Bank">
                <field name="bank_name"/>
            </search>
        </field>
    </record>
</odoo>

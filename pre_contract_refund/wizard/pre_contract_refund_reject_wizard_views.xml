<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pre_contract_refund_reject_wizard_form" model="ir.ui.view">
        <field name="name">property.pre.contract.refund.reject.wizard.form</field>
        <field name="model">property.pre.contract.refund.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Refund Request">
                <group>
                    <field name="refund_id" invisible="1"/>
                    <field name="reason" placeholder="Enter rejection reason..."/>
                </group>
                <footer>
                    <button name="action_confirm_reject" type="object" string="Reject" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_crm_lead_quota_tree" model="ir.ui.view">
        <field name="name">crm.lead.quota.tree</field>
        <field name="model">crm.lead.quota</field>
        <field name="arch" type="xml">
            <tree string="Lead Quota">
                <field name="team_id" options="{'no_create': True}"/>
                <field name="quota"/>
                <field name="assigned_count" readonly="1"/>
                <field name="remaining" readonly="1"/>
                <field name="type"/>
                <field name="active"/>
                <field name="ratio" readonly="1" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_crm_lead_quota_search" model="ir.ui.view">
        <field name="name">crm.lead.quota.search</field>
        <field name="model">crm.lead.quota</field>
        <field name="arch" type="xml">
            <search string="Lead Quota">
                <field name="team_id" string="Team"/>
                <field name="type" string="Channel"/>
                <separator/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Inactive"
                    domain="[('active', '=', False)]"
                    context="{'active_test': False}"/>
                <separator/>
                <filter name="walkin" string="Walk-in" domain="[('type', '=', 'walkin')]"/>
                <filter name="call_center" string="Call Center" domain="[('type', '=', 'call_center')]"/>
                <filter name="website" string="Website" domain="[('type', '=', 'website')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_team" string="Team" context="{'group_by': 'team_id'}"/>
                    <filter name="group_type" string="Channel Type" context="{'group_by': 'type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_crm_lead_quota_form" model="ir.ui.view">
        <field name="name">crm.lead.quota.form</field>
        <field name="model">crm.lead.quota</field>
        <field name="arch" type="xml">
            <form string="Lead Quota">
                <header>
                    <button name="action_reset_quota" type="object" string="Reset"
                        confirm="Reset assigned count to zero?"
                        invisible="not id"/>
                </header>
                <sheet>
                    <group>
                        <field name="team_id" options="{'no_create': True}"/>
                        <field name="quota"/>
                        <field name="assigned_count" readonly="1"/>
                        <field name="remaining" readonly="1"/>
                        <field name="type"/>
                        <field name="active"/>
                        <field name="ratio" readonly="1" optional="hide"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_crm_lead_quota" model="ir.actions.act_window">
        <field name="name">Lead_Qouta</field>
        <field name="res_model">crm.lead.quota</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <record id="menu_crm_lead_quota" model="ir.ui.menu">
        <field name="name">Lead_Qouta</field>
        <field name="parent_id" ref="menu_lead_distribution_group"/>
        <field name="action" ref="action_crm_lead_quota"/>
        <field name="sequence">10</field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_crm_lead_duplicate_message_wizard_form" model="ir.ui.view">
        <field name="name">crm.lead.duplicate.message.wizard.form</field>
        <field name="model">crm.lead.duplicate.message.wizard</field>
        <field name="arch" type="xml">
            <form string="Existing customer">
                <sheet>
                    <div class="alert alert-danger mb-0" role="alert"
                        invisible="not is_inactive_salesperson">
                        <p class="mb-0 fw-bold">Inactive salesperson — use Reassign</p>
                    </div>
                    <div class="alert alert-warning mb-3" role="alert"
                        invisible="is_inactive_salesperson">
                        <field name="message_html" nolabel="1" readonly="1"/>
                    </div>
                    <group string="Existing registration" col="2"
                        invisible="not existing_salesperson_id">
                        <field name="existing_salesperson_id"/>
                        <field name="existing_salesperson_phone"/>
                        <field name="existing_supervisor_id" colspan="2"/>
                    </group>
                    <field name="message" invisible="1"/>
                    <field name="title" invisible="1"/>
                    <field name="lead_model" invisible="1"/>
                    <field name="lead_res_id" invisible="1"/>
                    <field name="is_inactive_salesperson" invisible="1"/>
                </sheet>
                <footer>
                    <button name="action_close" string="OK" type="object"
                        class="btn-primary" data-hotkey="q"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>

<odoo>
    <data>
        <record id="view_collection_progress_shift_config_tree" model="ir.ui.view">
            <field name="name">collection.progress.shift.config.tree</field>
            <field name="model">collection.progress.shift.config</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="site_id"/>
                    <field name="enabled"/>
                    <field name="shift_days"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <record id="view_collection_progress_shift_config_form" model="ir.ui.view">
            <field name="name">collection.progress.shift.config.form</field>
            <field name="model">collection.progress.shift.config</field>
            <field name="arch" type="xml">
                <form string="Progress Due Date Shift">
                    <sheet>
                        <group>
                            <field name="site_id"/>
                            <field name="enabled"/>
                            <field name="shift_days" invisible="not enabled"/>
                            <field name="active"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_collection_progress_shift_config" model="ir.actions.act_window">
            <field name="name">Progress Due Date Shift</field>
            <field name="res_model">collection.progress.shift.config</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="menu_collection_progress_shift_config"
                  name="Progress Due Date Shift"
                  parent="collection_management.menu_collection_configuration"
                  action="action_collection_progress_shift_config"
                  sequence="30"
                  groups="collection_management.group_collection_manager"/>
    </data>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_sale_form_workflow_update" model="ir.ui.view">
        <field name="name">property.sale.form.workflow.update</field>
        <field name="model">property.sale</field>
        <field name="inherit_id" ref="advanced_property_management.property_sale_view_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//field[@name='order_date']" position="after">
                <field name="approval_date" 
                       invisible="state not in ['approve', 'done', 'void']" 
                       decoration-bf="1" 
                       decoration-success="1"/>
            </xpath>

        </field>
    </record>
</odoo>
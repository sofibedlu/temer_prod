<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Tree ─────────────────────────────────────────────────────────── -->
    <record id="view_letter_type_tree" model="ir.ui.view">
        <field name="name">letter.type.tree</field>
        <field name="model">letter.type</field>
        <field name="arch" type="xml">
            <tree string="Letter Types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="description"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- ── Form ─────────────────────────────────────────────────────────── -->
    <record id="view_letter_type_form" model="ir.ui.view">
        <field name="name">letter.type.form</field>
        <field name="model">letter.type</field>
        <field name="arch" type="xml">
            <form string="Letter Type">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Letter Type Name…"/></h1>
                    </div>
                    <group>
                        <field name="sequence"/>
                        <field name="active" widget="boolean_toggle"/>
                        <field name="description"/>
                    </group>
                    <notebook>
                        <page name="templates" string="Templates">
                            <field name="template_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="subject"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Action ───────────────────────────────────────────────────────── -->
    <record id="action_letter_type" model="ir.actions.act_window">
        <field name="name">Letter Types</field>
        <field name="res_model">letter.type</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first Letter Type</p>
        </field>
    </record>

</odoo>

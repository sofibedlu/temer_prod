<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Tree ─────────────────────────────────────────────────────────── -->
    <record id="view_letter_saved_tree" model="ir.ui.view">
        <field name="name">letter.saved.tree</field>
        <field name="model">letter.saved</field>
        <field name="arch" type="xml">
            <tree string="Saved Letters" default_order="create_date desc">
                <field name="letter_number"/>
                <field name="letter_type_id"/>
                <field name="letter_template_id"/>
                <field name="letter_date"/>
                <field name="action" widget="badge"
                       decoration-info="action == 'pdf'"
                       decoration-success="action == 'docx'"/>
                <field name="printed_by"/>
                <field name="create_date" string="Saved On"/>
            </tree>
        </field>
    </record>

    <!-- ── Form ─────────────────────────────────────────────────────────── -->
    <record id="view_letter_saved_form" model="ir.ui.view">
        <field name="name">letter.saved.form</field>
        <field name="model">letter.saved</field>
        <field name="arch" type="xml">
            <form string="Saved Letter">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="letter_number" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Letter Info">
                            <field name="letter_type_id" readonly="1"/>
                            <field name="letter_template_id" readonly="1"/>
                            <field name="letter_date" readonly="1"/>
                            <field name="letter_number" readonly="1"/>
                            <field name="action" readonly="1"/>
                        </group>
                        <group string="Context">
                            <field name="collection_id" readonly="1"
                                   options="{'no_open': False}"/>
                            <field name="installment_id" readonly="1"/>
                            <field name="printed_by" readonly="1"/>
                            <field name="create_date" readonly="1"
                                   string="Saved On"/>
                        </group>
                    </group>

                    <separator string="Letter Content"/>
                    <div style="border:1px solid #dee2e6;
                                border-radius:4px;
                                background:#fff;
                                padding:24px 32px;
                                min-height:400px;
                                font-family:'Noto Sans Ethiopic','Nyala',Arial,sans-serif;
                                font-size:12pt;
                                line-height:1.8;">
                        <field name="content_html"
                               widget="html"
                               readonly="1"
                               nolabel="1"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Action ───────────────────────────────────────────────────────── -->
    <record id="action_letter_saved" model="ir.actions.act_window">
        <field name="name">Saved Letters</field>
        <field name="res_model">letter.saved</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ── Inherit collection.order form — add stat button ──────────────── -->
    <record id="view_collection_order_form_inherit_letters"
            model="ir.ui.view">
        <field name="name">collection.order.form.inherit.letters</field>
        <field name="model">collection.order</field>
        <field name="inherit_id"
               ref="collection_management.view_collection_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_open_sale']" position="after">
                <button name="action_open_request_letters" type="object" class="oe_stat_button" icon="fa-envelope-o">
                    <field name="request_letter_count" widget="statinfo"/>
                </button>
                <button name="action_open_penalty_letters" type="object" class="oe_stat_button" icon="fa-exclamation-circle">
                    <field name="penalty_letter_count" widget="statinfo"/>
                </button>
                <button name="action_open_termination_letters" type="object" class="oe_stat_button" icon="fa-times-circle">
                    <field name="termination_letter_count" widget="statinfo"/>
                </button>
                <button name="action_open_other_letters" type="object" class="oe_stat_button" icon="fa-file-text-o">
                    <field name="other_letter_count" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>

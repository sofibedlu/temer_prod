<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_letter_director_tree" model="ir.ui.view">
        <field name="name">letter.director.tree</field>
        <field name="model">letter.director</field>
        <field name="arch" type="xml">
            <tree string="Directors" editable="bottom">
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="action_letter_director" model="ir.actions.act_window">
        <field name="name">Directors</field>
        <field name="res_model">letter.director</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a Director Name</p>
        </field>
    </record>

</odoo>

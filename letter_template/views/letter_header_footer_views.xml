<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════════
         TREE VIEW
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="view_letter_header_footer_tree" model="ir.ui.view">
        <field name="name">letter.header.footer.tree</field>
        <field name="model">letter.header.footer</field>
        <field name="arch" type="xml">
            <tree string="Letters Header &amp; Footer">
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════════
         FORM VIEW
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="view_letter_header_footer_form" model="ir.ui.view">
        <field name="name">letter.header.footer.form</field>
        <field name="model">letter.header.footer</field>
        <field name="arch" type="xml">
            <form string="Letter Header &amp; Footer">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Header/Footer Name…"/>
                        </h1>
                    </div>

                    <group>
                        <group string="General">
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Notes">
                            <field name="notes" nolabel="1" colspan="2"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- ── Header tab ─────────────────────────────── -->
                        <page name="header" string="Header">
                            <group>
                                <field name="header_logo"
                                       widget="image"
                                       string="Header Logo"
                                       options="{'size': [200, 80]}"/>
                                <field name="header_logo_filename" invisible="1"/>
                            </group>
                            <separator string="Header HTML Content"/>
                            <field name="header_html"
                                   widget="html"
                                   style="min-height:150px;"/>
                        </page>

                        <!-- ── Footer tab ─────────────────────────────── -->
                        <page name="footer" string="Footer">
                            <group>
                                <field name="footer_stamp"
                                       widget="image"
                                       string="Stamp / Signature"
                                       options="{'size': [150, 150]}"/>
                                <field name="footer_stamp_filename" invisible="1"/>
                            </group>
                            <separator string="Footer HTML Content"/>
                            <field name="footer_html"
                                   widget="html"
                                   style="min-height:120px;"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════════
         ACTION
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="action_letter_header_footer" model="ir.actions.act_window">
        <field name="name">Letters Header &amp; Footer</field>
        <field name="res_model">letter.header.footer</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Header &amp; Footer configuration
            </p>
        </field>
    </record>

</odoo>

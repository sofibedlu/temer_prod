    <!-- ── Letters Body ─────────────────────────────────────────────────── -->
    <menuitem
        id="menu_letter_body"
        name="Letters Body"
        parent="collection_management.menu_collection_configuration"
        action="letter_template.action_letter_body"
        sequence="25"
        groups="collection_management.group_collection_manager"/>

    <!-- ── Full Letter Templates (combines header/footer + bodies) ───────── -->
    <menuitem
        id="menu_letter_template"
        name="Letter Templates"
        parent="collection_management.menu_collection_configuration"
        action="letter_template.action_letter_template"
        sequence="30"
        groups="collection_management.group_collection_manager"/>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Fields added by property_type_details -->
    <record id="inherit_property_form_sales_protection_type_details" model="ir.ui.view">
        <field name="name">property.property.form.inherit.sales.protection.type.details</field>
        <field name="model">property.property</field>
        <field name="inherit_id" ref="property_type_details.inherit_property_form_property_type_details"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='property_type_bedroom']" position="before">
                <field name="is_sales_person_only" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='property_type_bedroom']" position="attributes">
                <attribute name="readonly">is_sales_person_only</attribute>
            </xpath>
            <xpath expr="//field[@name='property_type_bathroom']" position="attributes">
                <attribute name="readonly">is_sales_person_only</attribute>
            </xpath>
            <xpath expr="//field[@name='property_type_has_maid_room']" position="attributes">
                <attribute name="readonly">is_sales_person_only</attribute>
            </xpath>
            <xpath expr="//field[@name='property_type_no_kitchen']" position="attributes">
                <attribute name="readonly">is_sales_person_only</attribute>
            </xpath>
            <xpath expr="//field[@name='property_type_gross_area']" position="attributes">
                <attribute name="readonly">is_sales_person_only</attribute>
            </xpath>
            <xpath expr="//field[@name='property_type_net_area']" position="attributes">
                <attribute name="readonly">is_sales_person_only</attribute>
            </xpath>
            <xpath expr="//field[@name='property_type_floor_plan']" position="attributes">
                <attribute name="readonly">is_sales_person_only</attribute>
            </xpath>
        </field>
    </record>

    <!-- Fields on the base property form -->
    <record id="inherit_property_form_sales_protection_base_form" model="ir.ui.view">
        <field name="name">property.property.form.inherit.sales.protection.base.form</field>
        <field name="model">property.property</field>
        <field name="inherit_id" ref="advanced_property_management.property_property_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='unit_price']" position="attributes">
                <attribute name="readonly">is_sales_person_only</attribute>
            </xpath>
            <xpath expr="//field[@name='usage']" position="attributes">
                <attribute name="readonly">is_sales_person_only</attribute>
            </xpath>
        </field>
    </record>


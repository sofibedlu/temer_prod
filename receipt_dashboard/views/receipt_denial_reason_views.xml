<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_receipt_denial_reason_tree" model="ir.ui.view">
        <field name="name">receipt.denial.reason.tree</field>
        <field name="model">receipt.denial.reason</field>
        <field name="arch" type="xml">
            <tree string="Denial Reasons" create="0" edit="0" delete="0">
                <field name="receipt_record_id" string="Receipt Record"/>
                <field name="reason_type_id" string="Reason Type"/>
                <field name="customer_id" string="Customer"/>
                <field name="property_id" string="Property"/>
                <field name="amount" string="Amount"/>
                <field name="denied_date" string="Denied Date"/>
                <field name="denied_by" string="Denied By"/>
            </tree>
        </field>
    </record>
    
    <record id="view_receipt_denial_reason_form" model="ir.ui.view">
        <field name="name">receipt.denial.reason.form</field>
        <field name="model">receipt.denial.reason</field>
        <field name="arch" type="xml">
            <form string="Denial Reason" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="receipt_record_id" string="Receipt Record" readonly="1"/>
                            <field name="reason_type_id" string="Reason Type" readonly="1"/>
                        </group>
                        <group>
                            <field name="customer_id" string="Customer" readonly="1"/>
                            <field name="property_id" string="Property" readonly="1"/>
                            <field name="amount" string="Amount" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" string="Description" readonly="1"/>
                    </group>
                    <group>
                        <field name="denied_date" string="Denied Date" readonly="1"/>
                        <field name="denied_by" string="Denied By" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    
    <record id="action_receipt_denial_reason" model="ir.actions.act_window">
        <field name="name">Denial Reasons</field>
        <field name="res_model">receipt.denial.reason</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>


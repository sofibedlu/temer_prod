<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Record Rule: Receipt Dashboard users can read all receipts (out_receipt) -->
        <record id="account_move_receipt_dashboard_rule" model="ir.rule">
            <field name="name">Receipt Dashboard: Read Receipts</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="domain_force">[('move_type', '=', 'out_receipt')]</field>
            <field name="groups" eval="[(4, ref('group_receipt_dashboard_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <!-- Record Rule: Receipt Dashboard users can read receipt lines (out_receipt) -->
        <record id="account_move_line_receipt_dashboard_rule" model="ir.rule">
            <field name="name">Receipt Dashboard: Read Receipt Lines</field>
            <field name="model_id" ref="account.model_account_move_line"/>
            <field name="domain_force">[('move_id.move_type', '=', 'out_receipt')]</field>
            <field name="groups" eval="[(4, ref('group_receipt_dashboard_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>


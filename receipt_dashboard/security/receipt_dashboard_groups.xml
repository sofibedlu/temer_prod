<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Receipt Dashboard User Group -->
        <record id="group_receipt_dashboard_user" model="res.groups">
            <field name="name">Receipt Dashboard</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="comment">Users with this group can access the Receipt Dashboard menu and approve/deny receipts.</field>
        </record>
        
        <!-- Receipt Dashboard Manager Group -->
        <record id="group_receipt_dashboard_manager" model="res.groups">
            <field name="name">Receipt Dashboard Manager</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('group_receipt_dashboard_user'))]"/>
            <field name="comment">Managers can access all Receipt Dashboard features including denial reason management.</field>
        </record>
    </data>
</odoo>


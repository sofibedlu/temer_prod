<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="view_early_settlement_request_form" model="ir.ui.view">
        <field name="name">early.settlement.request.form</field>
        <field name="model">early.settlement.request</field>
        <field name="arch" type="xml">
            <form string="Early Settlement Request" create="0" delete="0">
                <header>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight" invisible="state != 'pending'"/>
                    <button name="action_reject" string="Reject" type="object" class="btn-danger" invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending,approved,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="collection_id"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="total_remaining" widget="monetary"/>
                            <field name="overdue_amount" widget="monetary"/>
                            <field name="eligible_amount" widget="monetary"/>
                        </group>
                        <group>
                            <field name="discount_percentage"/>
                            <field name="discount_amount" widget="monetary"/>
                            <field name="final_payoff_amount" widget="monetary" style="font-weight: bold;"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason" placeholder="Reason for the discount/settlement request..."/>
                        <field name="rejection_reason" invisible="state != 'rejected'"/>
                    </group>
                    
                    <separator string="Additional Information"/>
                    
                    <group>
                        <field name="attachment_ids" widget="many2many_binary" readonly="state in ['approved', 'rejected']"/>
                    </group>
                    <notebook>
                        <page string="Installments to Settle">
                            <field name="history_line_ids">
                                <!-- <tree decoration-danger="state == 'overdue'" decoration-success="state == 'paid'" decoration-warning="state == 'partial'"> -->
                                <tree>
                                    <field name="name"/>
                                    <!-- <field name="due_date"/> -->
                                    <field name="amount_total" widget="monetary" sum="Total Expected"/>
                                    <field name="amount_paid" widget="monetary" sum="Total Paid"/>
                                    <field name="amount_residual" widget="monetary" sum="Total Remaining"/>
                                    <!-- <field name="state"/> -->
                                    <field name="currency_id" column_invisible="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_early_settlement_request_tree" model="ir.ui.view">
        <field name="name">early.settlement.request.tree</field>
        <field name="model">early.settlement.request</field>
        <field name="arch" type="xml">
            <tree string="Early Settlement Requests" decoration-info="state == 'draft'" decoration-warning="state == 'pending'" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'" create="0" delete="0">
                <field name="name"/>
                <field name="collection_id"/>
                <field name="total_remaining"/>
                <field name="discount_percentage"/>
                <field name="final_payoff_amount"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'pending'" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'"/>
            </tree>
        </field>
    </record>

    <!-- Action & Menu -->
    <record id="action_early_settlement_request" model="ir.actions.act_window">
        <field name="name">Early Settlement Requests</field>
        <field name="res_model">early.settlement.request</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No early settlement requests found.
            </p>
        </field>
    </record>

    <menuitem id="menu_early_settlement_request"
              name="Full Early Settlement"
              parent="collection_discount_request.menu_discount_request_root"
              action="action_early_settlement_request"
              sequence="30"
              groups="collection_early_settlement_request.group_early_settlement_approver"/>
</odoo>
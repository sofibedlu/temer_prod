<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_settlement_reject_wizard_form" model="ir.ui.view">
        <field name="name">settlement.reject.wizard.form</field>
        <field name="model">settlement.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Settlement Request">
                <group>
                    <field name="request_id" invisible="1"/>
                    <field name="reason" placeholder="Please provide a reason for rejecting this request..." required="1"/>
                </group>
                <footer>
                    <button name="action_confirm_reject" string="Confirm Reject" type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
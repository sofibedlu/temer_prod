<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_temer_lead_form_extra_fields" model="ir.ui.view">
        <field name="name">temer.lead.form.extra.fields</field>
        <field name="model">temer.lead</field>
        <field name="inherit_id" ref="temer_crm.view_temer_lead_form"/>
        <field name="arch" type="xml">

            <!-- "For Whom to Buy" after New Phone Number (left group), before Save button -->
            <xpath expr="//field[@name='phone_no']" position="after">
                <field name="for_whom"
                       required="1"
                       string="For Whom to Buy"/>
            </xpath>

            <!-- "Previously Contacted by Temer Team" after Salesperson (right group) -->
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="previously_contacted"
                       widget="boolean_toggle"
                       string="Previously Contacted by Temer Team"/>
            </xpath>

            <!-- "Client Response" directly after Previously Contacted -->
            <xpath expr="//field[@name='previously_contacted']" position="after">
                <field name="client_response"
                       required="1"
                       string="Client Response"/>
            </xpath>

        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_collection_order_form_inherit_site_shift" model="ir.ui.view">
        <field name="name">collection.order.form.inherit.site.shift</field>
        <field name="model">collection.order</field>
        <field name="inherit_id" ref="collection_management.view_collection_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='contract_number']" position="after">
                <field name="is_site_shifted" widget="boolean_toggle" readonly="1" invisible="not is_site_shifted"/>
            </xpath>
        </field>
    </record>
</odoo>
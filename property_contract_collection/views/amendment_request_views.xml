<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard View -->
    <record id="view_amendment_request_wizard_form" model="ir.ui.view">
        <field name="name">amendment.request.wizard.form</field>
        <field name="model">amendment.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Request Schedule Amendment">
                <group>
                    <field name="collection_id" invisible="1"/>
                    <field name="current_partner_id"/>
                    <field name="new_partner_name"/>
                    <field name="is_schedule_change" widget="boolean_toggle"/>
                    <field name="reason" placeholder="Why is this amendment needed?"/>
                </group>
                <group invisible="not is_schedule_change">
                    <field name="proposed_changes" 
                           placeholder="e.g. Change upfront payment to 20%, push 2nd installment to Dec 2024..."
                           required="is_schedule_change"/>
                </group>
                <footer>
                    <button name="action_submit_request" string="Submit Request" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_amendment_request_reject_wizard_form" model="ir.ui.view">
        <field name="name">amendment.request.reject.wizard.form</field>
        <field name="model">amendment.request.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Amendment Request">
                <group>
                    <field name="request_id" invisible="1"/>
                    <field name="reason" placeholder="Enter the reason for rejecting this amendment request..." />
                </group>
                <footer>
                    <button name="action_confirm_reject" string="Reject Request" type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_property_schedule_amendment_request_tree" model="ir.ui.view">
        <field name="name">property.schedule.amendment.request.tree</field>
        <field name="model">property.schedule.amendment.request</field>
        <field name="arch" type="xml">
            <tree string="Amendment Requests" create="0" delete="0" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'">
                <field name="name"/>
                <field name="contract_number"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'"/>
            </tree>
        </field>
    </record>

    <!-- Request Form View -->
    <record id="view_property_schedule_amendment_request_form" model="ir.ui.view">
        <field name="name">property.schedule.amendment.request.form</field>
        <field name="model">property.schedule.amendment.request</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-success" invisible="state != 'draft'"/>
                    <button name="action_reject" type="object" string="Reject" class="btn-danger" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="collection_id"/>
                            <field name="sale_id"/>
                            <field name="contract_number" readonly="1"/>
                        </group>
                        <group>
                            <field name="current_partner_id"/>
                            <field name="new_partner_name" readonly="1"/>
                            <field name="is_schedule_change" widget="boolean_toggle" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason" readonly="1"/>
                    </group>
                    <separator string="Instructions for Contract Team" invisible="not is_schedule_change"/>
                    <field name="proposed_changes" readonly="1" invisible="not is_schedule_change"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_amendment_request" model="ir.actions.act_window">
        <field name="name">Amendment Requests</field>
        <field name="res_model">property.schedule.amendment.request</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_amendment_requests"
              name="Amendment Requests"
              action="action_amendment_request"
              sequence="53"
              groups="property_contract_extension.group_property_void_request_menu"/>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_collection_reactivate_wizard_form" model="ir.ui.view">
        <field name="name">collection.reactivate.wizard.form</field>
        <field name="model">collection.reactivate.wizard</field>
        <field name="arch" type="xml">
            <form string="Reactivate Collection Order">
                <group>
                    <field name="collection_id" invisible="1"/>
                    <field name="reason" placeholder="Please provide the reason for reactivating this collection order..."/>
                </group>
                <footer>
                    <button name="action_confirm_reactivate" 
                            string="Confirm Reactivation" 
                            type="object" 
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="ir_cron_collection_termination_check" model="ir.cron">
            <field name="name">Collection: Auto-Terminate Overdue Orders</field>
            <field name="model_id" ref="collection_management.model_collection_order"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_termination()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>

        <record id="seq_property_schedule_amdt_request" model="ir.sequence">
            <field name="name">Amendment Request</field>
            <field name="code">property.schedule.amendment.request</field>
            <field name="prefix">AMDT/%(year)s/</field>
            <field name="padding">4</field>
        </record>
    </data>
</odoo>
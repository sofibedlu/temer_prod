<odoo>
    <data noupdate="0">
        <record id="module_category_cancel_reservation_request" model="ir.module.category">
            <field name="name">Cancel Reservation Request</field>
            <field name="description">Reservation cancellation request permissions</field>
            <field name="sequence">30</field>
        </record>

        <record id="group_cancel_reservation_request_manager" model="res.groups">
            <field name="name">Cancel Reservation Manager</field>
            <field name="category_id" ref="module_category_cancel_reservation_request"/>
            <field name="implied_ids" eval="[(4, ref('temer_structure.access_property_sales_person_group'))]"/>
        </record>

        <record id="group_cancel_reservation_request_approver" model="res.groups">
            <field name="name">Cancel Reservation Approver</field>
            <field name="category_id" ref="module_category_cancel_reservation_request"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_cancel_request_manager_own_team" model="ir.rule">
            <field name="name">Cancel request manager own salespeople</field>
            <field name="model_id" ref="model_property_reservation_cancel_request"/>
            <field name="domain_force">[
                '|', '|', '|',
                ('salesperson_id', '=', user.id),
                ('supervisor_user_id', '=', user.id),
                ('team_manager_id', '=', user.id),
                ('wing_manager_id', '=', user.id)
            ]</field>
            <field name="groups" eval="[(4, ref('group_cancel_reservation_request_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_cancel_request_reservation_manager_own_team" model="ir.rule">
            <field name="name">Reservation manager own cancel requests disabled</field>
            <field name="model_id" ref="model_property_reservation_cancel_request"/>
            <field name="domain_force">[(0, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('temer_structure.access_property_reservation_manager_group'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="active" eval="False"/>
        </record>

        <record id="rule_cancel_request_approver_all" model="ir.rule">
            <field name="name">Cancel request approver all requests</field>
            <field name="model_id" ref="model_property_reservation_cancel_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_cancel_reservation_request_approver'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>

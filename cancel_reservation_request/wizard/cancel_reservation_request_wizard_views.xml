<odoo>
    <record id="view_cancel_reservation_request_wizard_form" model="ir.ui.view">
        <field name="name">cancel.reservation.request.wizard.form</field>
        <field name="model">cancel.reservation.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Reservation Request">
                <group string="Cancellation Reason">
                    <field name="reservation_id" invisible="1"/>
                    <group>
                        <field name="reason_id"
                               options="{'no_create': True, 'no_open': True}"
                               invisible="other == True"
                               required="other != True"/>
                        <field name="reason"
                               invisible="other != True"
                               required="other == True"/>
                    </group>
                    <group>
                        <field name="other"/>
                    </group>
                </group>
                <footer>
                    <button string="Create Cancel Request"
                            name="action_create_request"
                            type="object"
                            class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_cancel_reservation_request_wizard" model="ir.actions.act_window">
        <field name="name">Cancel Reservation Request</field>
        <field name="res_model">cancel.reservation.request.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

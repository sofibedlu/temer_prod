<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Property site form view - Add Project Number and Company after Site name (order: Site name, Project Number, Company) -->
    <record id="property_site_view_form_id" model="ir.ui.view">
        <field name="name">property.site.form</field>
        <field name="model">property.site</field>
        <field name="inherit_id" ref="ahadubit_property_base.property_site_view_form_id"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="project_number" string="Project Number" placeholder="Unique project identifier/number"/>
                <field name="company_id" widget="many2one" options="{'no_create': False}"
                       context="{'search_default_name': 1, 'search_default_abbreviation': 1}"/>
            </xpath>
        </field>
    </record>

    <!-- Property site tree view - Add Project Number and Company (base tree has name, area, site_type, state; we add project_number and company after name) -->
    <record id="property_site_view_tree_id" model="ir.ui.view">
        <field name="name">property.site.tree</field>
        <field name="model">property.site</field>
        <field name="inherit_id" ref="ahadubit_property_base.property_site_view_tree_id"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="project_number" string="Project Number"/>
                <field name="company_id"/>
            </xpath>
        </field>
    </record>
</odoo>


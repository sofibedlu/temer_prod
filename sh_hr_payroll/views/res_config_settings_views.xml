<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Action: Open Payroll Localization Modules -->
    <record id="open_payroll_modules" model="ir.actions.act_window">
        <field name="name">Payroll</field>
        <field name="res_model">ir.module.module</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{}</field>
        <field name="domain">[('name', '=like', 'l10n_%_hr_payroll')]</field>
        <field name="search_view_id" ref="base.view_module_filter"/>
    </record>


    <!-- Settings App Block (Odoo 17 supports <app> tags exactly like Odoo 16) -->
    <record id="res_config_settings_view_form_inherit_hr_payroll" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hr.payroll</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="priority" eval="45"/>

        <field name="arch" type="xml">

            <!-- Insert inside the main Settings form (stable XPath) -->
            <xpath expr="//form" position="inside">

    <app name="sh_hr_payroll"
         string="Payroll"
         groups="sh_hr_payroll.group_hr_payroll_manager">

        <block title="Payroll">

            <!-- Payroll Localization -->
            <setting string="Payroll Localization"
                invisible="module_l10n_fr_hr_payroll or module_l10n_be_hr_payroll or module_l10n_in_hr_payroll">

                <field name="module_l10n_fr_hr_payroll" invisible="1"/>
                <field name="module_l10n_be_hr_payroll" invisible="1"/>
                <field name="module_l10n_in_hr_payroll" invisible="1"/>

                <div class="text-muted">
                    Payroll rules that apply to your country
                </div>

                <button name="%(open_payroll_modules)d"
                        type="action"
                        class="btn-link"
                        icon="fa-arrow-right"
                        string="Choose a Payroll Localization"/>
            </setting>


            <!-- Payroll Accounting -->
            <setting string="Payroll Accounting">

                <field name="module_account_accountant"/>

                <div class="text-muted">
                    Post payroll slips in accounting
                </div>

            </setting>

        </block>

    </app>

</xpath>


        </field>
    </record>


    <!-- Action & Menu for direct access to these settings -->
    <record id="action_hr_payroll_configuration" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'sh_hr_payroll'}</field>
    </record>

    <menuitem id="menu_hr_payroll_global_settings"
              name="Settings"
              parent="menu_hr_payroll_configuration"
              sequence="0"
              action="action_hr_payroll_configuration"
              groups="base.group_system"/>

</odoo>

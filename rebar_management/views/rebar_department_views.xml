<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rebar_department_tree" model="ir.ui.view">
        <field name="name">rebar.department.tree</field>
        <field name="model">rebar.department</field>
        <field name="arch" type="xml">
            <tree string="Departments" editable="bottom">
                <field name="name"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="action_rebar_department" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">rebar.department</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sales_dashboard.supervisor_dashboard_jjokacha" owl="1">
        <div class="container-fluid p-3" style="overflow-y:auto; max-height:90vh;">
            <t t-if="state.loading">
                <div class="text-center p-5">
                    <i class="fa fa-refresh fa-spin fa-3x"/>
                    <p>Loading dashboard data...</p>
                </div>
            </t>
            <t t-else="">
                <!-- Six Status Cards (4 per row) -->
                <div class="row mb-3 colorful-row">
                    <div class="col-md-3 mb-3">
                        <div class="card text-center shadow-sm dashboard-card" style="background: linear-gradient(135deg, #e0e7ff 60%, #f7fae5 100%); border-left: 5px solid #007bff;">
                            <div class="card-body" style="color: #007bff;">
                                <h6 class="card-title" style="color: #007bff;">Prospect</h6>
                                <h3 class="fw-bold" style="color: #007bff;">
                                    <t t-esc="state.combinedStatusCounts.prospect"/>
                                </h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <div class="card text-center shadow-sm dashboard-card" style="background: linear-gradient(135deg, #fffbe6 60%, #f6c23e 100%); border-left: 5px solid #f6c23e;">
                            <div class="card-body" style="color: #f6c23e;">
                                <h6 class="card-title" style="color: #f6c23e;">Follow Up</h6>
                                <h3 class="fw-bold" style="color: #f6c23e;">
                                    <t t-esc="state.combinedStatusCounts.followUp"/>
                                </h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <div class="card text-center shadow-sm dashboard-card" style="background: linear-gradient(135deg, #e0f7fa 60%, #17a2b8 100%); border-left: 5px solid #17a2b8;">
                            <div class="card-body" style="color: #17a2b8;">
                                <h6 class="card-title" style="color: #17a2b8;">Reservation</h6>
                                <h3 class="fw-bold" style="color: #17a2b8;">
                                    <t t-esc="state.combinedStatusCounts.reservation"/>
                                </h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <div class="card text-center shadow-sm dashboard-card" style="background: linear-gradient(135deg, #e6f9f0 60%, #28a745 100%); border-left: 5px solid #28a745;">
                            <div class="card-body" style="color: #28a745;">
                                <h6 class="card-title" style="color: #28a745;">Sold</h6>
                                <h3 class="fw-bold" style="color: #28a745;">
                                    <t t-esc="state.combinedStatusCounts.won"/>
                                </h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <div class="card text-center shadow-sm dashboard-card" style="background: linear-gradient(135deg, #ffeaea 60%, #dc3545 100%); border-left: 5px solid #dc3545;">
                            <div class="card-body" style="color: #dc3545;">
                                <h6 class="card-title" style="color: #dc3545;">Lost</h6>
                                <h3 class="fw-bold" style="color: #dc3545;">
                                    <t t-esc="state.combinedStatusCounts.lost"/>
                                </h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <div class="card text-center shadow-sm dashboard-card" style="background: linear-gradient(135deg, #f7e6e6 60%, #6c757d 100%); border-left: 5px solid #6c757d;">
                            <div class="card-body" style="color: #6c757d;">
                                <h6 class="card-title" style="color: #6c757d;">Expired</h6>
                                <h3 class="fw-bold" style="color: #6c757d;">
                                    <t t-esc="state.combinedStatusCounts.expired"/>
                                </h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <div class="card text-center shadow-sm dashboard-card" style="background: linear-gradient(135deg, #f6c23e 60%, #007bff 100%); border-left: 5px solid #007bff;">
                            <div class="card-body" style="color: #007bff;">
                                <h6 class="card-title" style="color: #007bff;">Total Lead</h6>
                                <h3 class="fw-bold" style="color: #007bff;">
                                    <t t-esc="state.combinedStatusCounts.total"/>
                                </h3>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card mb-3" style="background: linear-gradient(90deg, #d7e7c2 0%, #a8af94 100%); border: 2px solid #a8af94;">
                    <div class="card-header" style="background: linear-gradient(90deg, #a8af94 0%, #89af31 100%); color: #333;">
                        <h5 style="font-weight: bold; letter-spacing: 1px;">Filters</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <!-- Date From -->
                            <div class="col-md-4">
                                <label style="color: #000;">Date From</label>
                                <input
                                    type="date"
                                    class="form-control border-success"
                                    t-model="state.filters.date_from"
                                    t-on-change="setDateFrom"
                                    style="background: #f7faef; color: #000;"
                                />
                            </div>
                            <!-- Date To -->
                            <div class="col-md-4">
                                <label style="color: #000;">Date To</label>
                                <input
                                    type="date"
                                    class="form-control border-warning"
                                    t-model="state.filters.date_to"
                                    t-on-change="setDateTo"
                                    style="background: #fffbe6; color: #000;"
                                />
                            </div>
                            <!-- Supervisor (readonly) -->
                            <div class="col-md-4">
                                <label style="color: #000;">Supervisor</label>
                                <input
                                    type="text"
                                    class="form-control border-primary"
                                    t-att-value="state.filters.supervisor_name"
                                    readonly="readonly"
                                    tabindex="-1"
                                    style="pointer-events: none; background-color: #e9ecef; color: #000;"
                                />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card" style="background: linear-gradient(90deg, #d7e7c2 0%, #a8af94 100%); border: 2px solid #a8af94;">
                    <div class="card-header" style="background: linear-gradient(90deg, #a8af94 0%, #89af31 100%); color: #333;">
                        <h5 style="font-weight: bold; letter-spacing: 1px;">Activities Sales Performance</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover table-animated" style="background: #fff;">
                                <thead class="table-primary" style="background: linear-gradient(90deg, #a8af94 0%, #89af31 100%) !important;">
                                    <tr>
                                        <th style="color: #000;">Sales Person</th>
                                        <th style="color: #000;">Office Visit</th>
                                        <th style="color: #000;">Site Visit</th>
                                        <th style="color: #000;">Email</th>
                                        <th style="color: #000;">SMS</th>
                                        <th style="color: #000;">Call</th>
                                        <th style="color: #000;">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.detailedSalesPerformance" t-as="row" t-key="row.sales_person">
                                        <tr class="table-row-animated" style="cursor: pointer;">
                                            <td t-esc="row.sales_person"/>
                                            <td t-esc="row.office_visit_count"/>
                                            <td t-esc="row.site_visit_count"/>
                                            <td t-esc="row.email_count"/>
                                            <td t-esc="row.sms_count"/>
                                            <td t-esc="row.call_count"/>
                                            <td>
                                                <b t-esc="row.total_key_events || 0"/>
                                            </td>
                                        </tr>
                                    </t>
                                    <!-- Sum row -->
                                    <tr style="background:linear-gradient(90deg,#d7e7c2,#a8af94); font-weight: bold;">
                                        <td class="text-end"><b>Total</b></td>
                                        <td><b><t t-esc="state.detailedSalesPerformance.reduce((s,r)=> s + (r.office_visit_count||0), 0)"/></b></td>
                                        <td><b><t t-esc="state.detailedSalesPerformance.reduce((s,r)=> s + (r.site_visit_count||0), 0)"/></b></td>
                                        <td><b><t t-esc="state.detailedSalesPerformance.reduce((s,r)=> s + (r.email_count||0), 0)"/></b></td>
                                        <td><b><t t-esc="state.detailedSalesPerformance.reduce((s,r)=> s + (r.sms_count||0), 0)"/></b></td>
                                        <td><b><t t-esc="state.detailedSalesPerformance.reduce((s,r)=> s + (r.call_count||0), 0)"/></b></td>
                                        <td>
                                            <b><t t-esc="state.detailedSalesPerformance.reduce((s,r)=> s + (r.total_key_events||0), 0)"/></b>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <!-- Lead Status Breakdown Table -->
                <div class="card mt-3" style="background: linear-gradient(90deg, var(--main-green-light) 0%, var(--secondary-green)O 100%); border: 2px solid var(--secondary-green);">
                    <div class="card-header" style="background: linear-gradient(90deg, var(--secondary-green) 0%, var(--main-green) 100%); color: #333;">
                        <h5 style="font-weight: bold; letter-spacing: 1px;">Lead Status Breakdown Per Sales Person</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped mb-0">
                                <thead>
                                    <tr>
                                        <th style="color: #000;">Sales Person</th>
                                        <th style="color: #000;">Prospect</th>
                                        <th style="color: #000;">Follow Up</th>
                                        <th style="color: #000;">Reservation</th>
                                        <th style="color: #000;">Sold</th>
                                        <th style="color: #000;">Expired</th>
                                        <th style="color: #000;">Lost</th>
                                        <th style="color: #000;">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.detailedSalesPerformance" t-as="row" t-key="'breakdown-' + row.sales_person">
                                        <tr>
                                            <td><t t-esc="row.sales_person"/></td>
                                            <td><t t-esc="row.prospect_count || row.prospect || 0"/></td>
                                            <td><t t-esc="row.follow_up_count || row.follow_up || 0"/></td>
                                            <td><t t-esc="row.reservation_count || row.reservation || 0"/></td>
                                            <td><t t-esc="row.won_count || row.won || 0"/></td>
                                            <td><t t-esc="row.expired_count || row.expired || 0"/></td>
                                            <td><t t-esc="row.lost_count || row.lost || 0"/></td>
                                            <td>
                                                <b>
                                                <t t-esc="
                                                    (row.prospect_count || row.prospect || 0)
                                                    + (row.follow_up_count || row.follow_up || 0)
                                                    + (row.reservation_count || row.reservation || 0)
                                                    + (row.won_count || row.won || 0)
                                                    + (row.expired_count || row.expired || 0)
                                                    + (row.lost_count || row.lost || 0)
                                                "/>
                                                </b>
                                            </td>
                                        </tr>
                                    </t>
                                    <!-- Sum row for columns -->
                                    <tr style="font-weight:bold; background:linear-gradient(90deg,var(--main-green-light),var(--secondary-green));">
                                        <td class="text-end" style="color:#000;"><b>Total</b></td>
                                        <td style="color:#000;"><b><t t-esc="state.detailedSalesPerformance.reduce((s,r)=>s+(r.prospect_count||r.prospect||0),0)"/></b></td>
                                        <td style="color:#000;"><b><t t-esc="state.detailedSalesPerformance.reduce((s,r)=>s+(r.follow_up_count||r.follow_up||0),0)"/></b></td>
                                        <td style="color:#000;"><b><t t-esc="state.detailedSalesPerformance.reduce((s,r)=>s+(r.reservation_count||r.reservation||0),0)"/></b></td>
                                        <td style="color:#000;"><b><t t-esc="state.detailedSalesPerformance.reduce((s,r)=>s+(r.won_count||r.won||0),0)"/></b></td>
                                        <td style="color:#000;"><b><t t-esc="state.detailedSalesPerformance.reduce((s,r)=>s+(r.expired_count||r.expired||0),0)"/></b></td>
                                        <td style="color:#000;"><b><t t-esc="state.detailedSalesPerformance.reduce((s,r)=>s+(r.lost_count||r.lost||0),0)"/></b></td>
                                        <td style="color:#000;">
                                            <b>
                                            <t t-esc="state.detailedSalesPerformance.reduce((s,r)=>
                                                s
                                                + (r.prospect_count||r.prospect||0)
                                                + (r.follow_up_count||r.follow_up||0)
                                                + (r.reservation_count||r.reservation||0)
                                                + (r.won_count||r.won||0)
                                                + (r.expired_count||r.expired||0)
                                                + (r.lost_count||r.lost||0)
                                            ,0)"/>
                                            </b>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </t>
        </div>
        <style>
            .dashboard-card {
                height: 80px;
            }
            .total-leads-card-bg {
                background: #d1fae5 !important;
                border-radius: 0 0 0.375rem 0.375rem;
            }
            .key-events-card-bg {
                background: #ecfccb !important;
                border-radius: 0 0 0.375rem 0.375rem;
            }
            .sales-persons-card-bg {
                background: #ffedd5 !important;
                border-radius: 0 0 0.375rem 0.375rem;
            }
            .supervisors-card-bg {
                background: #e0e7ff !important;
                border-radius: 0 0 0.375rem 0.375rem;
            }
            .table-responsive {
                overflow-x: auto;
                overflow-y: auto;
                max-height: 60vh;
            }
            .combined-status-card {
                height: 140px;
            }
            .status-badges {
                flex-wrap: wrap;
                gap: 5px;
            }
            .status-badges .badge {
                font-size: 0.8rem;
                padding: 0.35em 0.65em;
            }
            .table-hover tbody tr:hover {
                background: linear-gradient(90deg, #f0fdfa 0%, #e0e7ff 100%) !important;
                transition: background 0.3s;
                cursor: pointer;
                box-shadow: 0 2px 8px 0 rgba(0,0,0,0.07);
                transform: scale(1.01);
            }
            .table-animated tbody tr {
                transition: background 0.3s, box-shadow 0.3s, transform 0.2s;
            }
            .table-animated tbody tr.table-row-animated {
                animation: fadeInRow 0.7s;
            }
            @keyframes fadeInRow {
                from { opacity: 0; transform: translateY(10px);}
                to { opacity: 1; transform: translateY(0);}
            }
            :root {
                --main-green: rgb(137, 175, 49);
                --secondary-green: rgb(168, 175, 148);
                --main-green-light: #f7faef;
            }
            .colorful-row {
                background: linear-gradient(90deg, var(--main-green-light) 0%, var(--secondary-green) 100%);
                border-radius: 0.5rem;
                box-shadow: 0 4px 24px 0 rgba(137,175,49,0.07);
                padding: 10px 0 10px 0;
                margin-bottom: 1.5rem;
                animation: fadeInRow 0.7s;
            }
            .dashboard-card,
            .dashboard-card.total-leads-card-adv,
            .dashboard-card.key-events-card-adv,
            .dashboard-card.sales-persons-card-adv,
            .dashboard-card.supervisors-card-adv {
                background: linear-gradient(135deg, var(--main-green-light) 60%, var(--secondary-green) 100%) !important;
                border: none;
                box-shadow: 0 2px 12px 0 rgba(137,175,49,0.08);
                transition: transform 0.2s;
            }
            .dashboard-card:hover {
                transform: scale(1.03);
                box-shadow: 0 6px 24px 0 rgba(137,175,49,0.12);
                z-index: 2;
            }
            .dashboard-card .card-body {
                border-radius: 0.5rem;
                transition: background 0.3s;
                color: rgb(137, 175, 49) !important;
            }
            .combined-status-card {
                background: linear-gradient(135deg, var(--main-green-light) 60%, var(--secondary-green) 100%) !important;
                border: none;
                box-shadow: 0 2px 12px 0 rgba(137,175,49,0.07);
                height: 140px;
            }
            .table-primary th {
                background: var(--secondary-green) !important;
                color: rgb(137, 175, 49);
                border: none;
                letter-spacing: 0.5px;
                font-weight: 600;
                font-size: 1rem;
            }
            .table-hover tbody tr:hover {
                background: linear-gradient(90deg, var(--main-green-light) 0%, var(--secondary-green) 100%) !important;
                transition: background 0.3s;
                cursor: pointer;
                box-shadow: 0 2px 8px 0 rgba(168,175,148,0.10);
                transform: scale(1.01);
            }
            .table-striped > tbody > tr:nth-of-type(odd) {
                background: linear-gradient(90deg, var(--main-green-light) 0%, var(--secondary-green) 100%) !important;
            }
            .table-striped > tbody > tr:nth-of-type(even) {
                background: linear-gradient(90deg, var(--secondary-green) 0%, var(--main-green-light) 100%) !important;
            }
            .table-striped > tbody > tr:last-child {
                background: linear-gradient(90deg, #e8f5c8, var(--secondary-green)) !important;
            }
        </style>
    </t>
</templates>
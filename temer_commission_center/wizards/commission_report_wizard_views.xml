<odoo>
    <record id="view_temer_commission_report_wizard_form" model="ir.ui.view">
        <field name="name">temer.commission.report.wizard.form</field>
        <field name="model">temer.commission.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Commission Report">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="tax_percentage"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate_xlsx" string="Generate Excel" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_temer_commission_report_wizard" model="ir.actions.act_window">
        <field name="name">Commission Report</field>
        <field name="res_model">temer.commission.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
<odoo>
    <record id="view_temer_commission_policy_tree" model="ir.ui.view">
        <field name="name">temer.commission.policy.tree</field>
        <field name="model">temer.commission.policy</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="view_temer_commission_policy_form" model="ir.ui.view">
        <field name="name">temer.commission.policy.form</field>
        <field name="model">temer.commission.policy</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <notebook>
                        <page string="Rules">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="sequence"/>
                                    <field name="role"/>
                                    <field name="percentage"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
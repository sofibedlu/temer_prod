<odoo>
    <record id="view_temer_commission_sheet_line_form" model="ir.ui.view">
        <field name="name">temer.commission.sheet.line.form</field>
        <field name="model">temer.commission.sheet.line</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_payment_wizard"
                            type="object"
                            string="Register Payment"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="unpaid,partial,paid"/>
                </header>

                <sheet>
                    <group>
                        <group>
                            <field name="sheet_id" readonly="1"/>
                            <field name="partner_id"/>
                            <field name="role"/>
                        </group>
                        <group>
                            <field name="percentage"/>
                            <field name="total_commission_amount"/>
                            <field name="paid_amount" readonly="1"/>
                            <field name="balance_amount" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Payment History">
                            <field name="payment_ids" readonly="1">
                                <tree create="0" delete="0" edit="0"
                                      decoration-success="status == 'paid'">
                                    <field name="currency_id" invisible="1" column_invisible="1"></field>
                                    <field name="payment_date"/>
                                    <field name="amount" sum="Amount" widget="monetary"/>
                                    <field name="payment_id" widget="many2one_clickable"/>
                                    <field name="payment_state"/>
                                    <field name="status" widget="badge" decoration-success="status == 'paid'"/>
                                    <field name="note"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="collection_reports.CustomerServiceReportClient" owl="1">
        <div class="collection-report-container">
            <div class="report-header">
                <h1 class="report-title">Customer Service Report</h1>
                <div class="filter-section">
                    <div class="filters-row">
                        <div class="filter-group">
                            <label>
                                <input type="checkbox" t-model="state.show_all_dates" t-on-change="onShowAllDatesChange"/>
                                Show All
                            </label>
                        </div>
                        <div class="filter-group">
                            <label>From:</label>
                            <input type="date" t-model="state.date_from" class="date-input" t-att-disabled="state.show_all_dates"/>
                        </div>
                        <div class="filter-group">
                            <label>To:</label>
                            <input type="date" t-model="state.date_to" class="date-input" t-att-disabled="state.show_all_dates"/>
                        </div>
                        <div class="filter-group">
                            <label>Search:</label>
                            <input type="text" t-model="state.search_text" class="search-input" placeholder="Search..." t-on-input="onSearchChange"/>
                        </div>
                        <button class="btn-show" t-on-click="loadData">Show</button>
                        <div class="export-buttons" style="margin-left: auto;">
                            <button class="btn-export btn-export-excel" t-on-click="exportExcel">Export Excel</button>
                            <button class="btn-export btn-export-pdf" t-on-click="exportPDF">Export PDF</button>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="report-table-container" t-if="!state.loading">
                <table class="report-table">
                    <thead>
                        <tr>
                            <th>S.NO</th>
                            <th>DATE</th>
                            <th>CUSTOMER</th>
                            <th>COLLECTION ORDER</th>
                            <th>TOTAL NUMBER OF CUSTOMERS OBTAINED SERVICE</th>
                            <th>SATISFACTION LEVEL</th>
                            <th>REMARK</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-if="state.filtered_data.length === 0">
                            <td colspan="7" style="text-align:center;padding:20px;">No data available</td>
                        </tr>
                        <tr t-foreach="state.filtered_data" t-as="row" t-key="row.sno">
                            <td><t t-esc="row.sno"/></td>
                            <td><t t-esc="row.date or ''"/></td>
                            <td style="text-align:left;padding-left:10px;"><t t-esc="row.customer or ''"/></td>
                            <td style="text-align:left;padding-left:10px;"><t t-esc="row.collection_order or ''"/></td>
                            <td><t t-esc="row.total_customers or 0"/></td>
                            <td><t t-esc="row.satisfaction_level or ''"/></td>
                            <td style="text-align:left;padding-left:10px;"><t t-esc="row.remark or ''"/></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            
            <div class="loading-spinner" t-if="state.loading">Loading report data...</div>
        </div>
    </t>
</templates>


<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- 1. Hide Timezone in the Tree View -->
    <record id="biometric_device_config_inherit_tree" model="ir.ui.view">
        <field name="name">biometric.config.tree.inherit</field>
        <field name="model">biometric.config</field>
        <field name="inherit_id" ref="tis_hr_biometric_attendance.biometric_device_config_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='time_zone']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- 2. Kanban View -->
    <record id="biometric_device_config_view_kanban" model="ir.ui.view">
        <field name="name">biometric.config.kanban</field>
        <field name="model">biometric.config</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="device_ip"/>
                <field name="port"/>
                <field name="last_read_time"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <i class="fa fa-server me-2"/> <field name="name"/>
                                </strong>
                                <div class="mt-2">
                                    <span><strong>IP:</strong> <field name="device_ip"/></span><br/>
                                    <span><strong>Port:</strong> <field name="port"/></span><br/>
                                    <span class="text-muted">
                                        <i class="fa fa-clock-o me-1"/>
                                        <t t-if="record.last_read_time.value">
                                            Last Read: <field name="last_read_time"/>
                                        </t>
                                        <t t-else="">
                                            Last Read: Never
                                        </t>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- 3. Update the Form View -->
    <record id="biometric_device_config_inherit_form" model="ir.ui.view">
        <field name="name">biometric.config.form.inherit</field>
        <field name="model">biometric.config</field>
        <field name="inherit_id" ref="tis_hr_biometric_attendance.biometric_device_config_view_form"/>
        <field name="arch" type="xml">
            
            <!-- Hide Unwanted Fields -->
            <xpath expr="//field[@name='time_zone']" position="attributes">
                <attribute name="invisible">0</attribute>
            </xpath>
            <xpath expr="//field[@name='company_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='used_for']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Hide the Sync and Download Buttons -->
            <xpath expr="//button[@name='sync_employees']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='download_attendance_log']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Add Connection Type and Serial Number -->
            <xpath expr="//field[@name='device_ip']" position="before">
                <field name="connection_type"/>
                <field name="serial_number" required="connection_type == 'adms'"/>
            </xpath>

            <!-- Hide TCP fields if ADMS is selected -->
            <xpath expr="//field[@name='device_ip']" position="attributes">
                <attribute name="invisible">connection_type == 'adms'</attribute>
            </xpath>
            <xpath expr="//field[@name='port']" position="attributes">
                <attribute name="invisible">connection_type == 'adms'</attribute>
            </xpath>
            <xpath expr="//field[@name='is_password_set']" position="attributes">
                <attribute name="invisible">connection_type == 'adms'</attribute>
            </xpath>
            <xpath expr="//field[@name='device_password']" position="attributes">
                <attribute name="invisible">connection_type == 'adms' or not is_password_set</attribute>
            </xpath>

            <!-- Add Last Read Time below the Port -->
            <xpath expr="//field[@name='port']" position="after">
                <field name="last_read_time" readonly="1"/>
            </xpath>

            <!-- Add the Users Stat Button -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_users" type="object" class="oe_stat_button" icon="fa-users">
                    <field name="user_count" widget="statinfo" string="Users"/>
                </button>
            </xpath>

        </field>
    </record>

    <!-- 4. Update the Window Action to include the Kanban view by default -->
    <record id="tis_hr_biometric_attendance.action_biometric_device_config_view" model="ir.actions.act_window">
        <field name="view_mode">kanban,tree,form</field>
    </record>

</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Disable the old base module cronjobs -->
        <record id="tis_hr_biometric_attendance.ir_cron_scheduler_action_new_download" model="ir.cron">
            <field name="active" eval="False"/>
        </record>
        <record id="tis_hr_biometric_attendance.ir_cron_scheduler_action" model="ir.cron">
            <field name="active" eval="False"/>
        </record>

        <!-- New Truth Cronjob -->
        <record forcecreate="True" id="ir_cron_fetch_raw_biometric_logs" model="ir.cron">
            <field name="name">Biometric: Fetch Raw Logs (Source of Truth)</field>
            <field name="model_id" ref="model_attendance_log_analysis"/>
            <field name="state">code</field>
            <field name="code">model._cron_fetch_raw_logs()</field>
            <field eval="True" name="active"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
        </record>
    </data>
</odoo>
<odoo>
    <data noupdate="0">
        <!-- Application Category -->
        <record id="module_category_property_reservation_management" model="ir.module.category">
            <field name="name">Property Reservation Management</field>
            <field name="description">User access levels for Property Reservation Management</field>
            <field name="sequence">10</field>
        </record>

        <!-- Group for Canceling Reservations -->
        <record id="group_property_reservation_cancel" model="res.groups">
            <field name="name">Property Reservations Cancel</field>
            <field name="category_id" ref="module_category_property_reservation_management"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>
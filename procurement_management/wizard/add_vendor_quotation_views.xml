<odoo>
    <record id="view_add_vendor_quotation_wizard_form" model="ir.ui.view">
        <field name="name">add.vendor.quotation.wizard.form</field>
        <field name="model">add.vendor.quotation.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Vendor Quotation">
                <group>
                    <group>
                        <field name="vendor_id" options="{'no_create': True}"/>
                        <field name="consolidate_lines"/>
                    </group>
                    <group>
                        <field name="attachment_name" invisible="1"/>
                        <field name="attachment_file" widget="binary" filename="attachment_name"/>
                    </group>
                </group>
                <group invisible="not consolidate_lines">
                    <div class="alert alert-info" role="alert" colspan="2">
                        <strong>Smart Mode:</strong> Products will be summed up and converted to the standard Purchase Unit of Measure.
                    </div>
                </group>
                <group invisible="consolidate_lines">
                    <div class="alert alert-warning" role="alert" colspan="2">
                        <strong>Detailed Mode:</strong> Every request line will be copied exactly as it is.
                    </div>
                </group>
                <footer>
                    <button name="action_apply" string="Add Quotation Lines" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
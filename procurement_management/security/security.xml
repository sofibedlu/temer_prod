<odoo>
    <record id="module_category_procurement_management" model="ir.module.category">
        <field name="name">Procurement</field>
        <field name="description">Helps you manage procurement workflow</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_department_user" model="res.groups">
        <field name="name">Department User</field>
        <field name="category_id" ref="module_category_procurement_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_procurement_manager" model="res.groups">
        <field name="name">Procurement Manager</field>
        <field name="category_id" ref="module_category_procurement_management"/>
        <field name="implied_ids" eval="[(4, ref('group_department_user'))]"/>
    </record>
</odoo>
<odoo>
    <record id="view_department_request_tree" model="ir.ui.view">
        <field name="name">department.request.tree</field>
        <field name="model">department.request</field>
        <field name="arch" type="xml">
            <tree string="Department Requests">
                <field name="name"/>
                <field name="department_id"/>
                <field name="state" widget="badge" 
                       decoration-success="state == 'approved'" 
                       decoration-info="state == 'requested'" 
                       decoration-warning="state == 'checked'" 
                       decoration-danger="state == 'rejected'" 
                       decoration-muted="state == 'draft'"/>
            </tree>
        </field>
    </record>

    <record id="view_department_request_form" model="ir.ui.view">
        <field name="name">department.request.form</field>
        <field name="model">department.request</field>
        <field name="arch" type="xml">
            <form string="Department Request">
                <header>
                    <button name="action_request" string="Request" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_check" string="Check" type="object" class="oe_highlight" invisible="state != 'requested'"/>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight" invisible="state != 'checked'"/>
                    <button name="action_reject" string="Reject" type="object" invisible="state in ['draft', 'approved', 'rejected']" class="btn-danger"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,requested,checked,approved,rejected"/>
                </header>
                <sheet>
                    <field name="state" invisible="1"/>
                    <div class="oe_title">
                        <h1>
                            <field name="priority" widget="priority" class="mr-3"/>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="department_id" readonly="state in ['approved', 'rejected']"/>
                            <field name="date" readonly="state in ['approved', 'rejected']"/>
                            <field name="expected_date" readonly="state in ['approved', 'rejected']"/>
                            <field name="origin" invisible="not origin"/>
                        </group>
                        <group>
                            <field name="requestor_id"/>
                            <field name="checked_by_id" invisible="state in ['draft', 'requested']"/>
                            <field name="approved_by_id" invisible="state in ['draft', 'requested', 'checked', 'rejected']"/>
                            <field name="rejected_by_id" invisible="state != 'rejected'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Requested Materials">
                            <field name="line_ids" readonly="state in ['approved', 'rejected']">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="purpose"/>
                                    <field name="technical"/>
                                    <field name="financial"/>
                                    <field name="quantity"/>
                                    <field name="product_uom_category_id" column_invisible="True"/>
                                    <field name="product_uom_id" 
                                        domain="[('category_id', '=', product_uom_category_id)]" 
                                        options="{'no_create': True, 'no_open': True}"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Specifications" name="specifications">
                            <field name="line_ids" readonly="state in ['approved', 'rejected']">
                                <tree create="0" delete="0">
                                    <field name="product_id" readonly="1"/>
                                    <field name="specifications" widget="html"/>
                                </tree>

                                <form>
                                    <sheet>
                                        <group>
                                            <field name="product_id" readonly="1"/>
                                        </group>
                                        <separator string="Specifications"/>
                                        <field name="specifications" 
                                            widget="html" 
                                            nolabel="1" 
                                            placeholder="e.g. 16GB RAM, Core i7 CPU..."/>
                                    </sheet>
                                </form>

                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_department_request" model="ir.actions.act_window">
        <field name="name">Department Requests</field>
        <field name="res_model">department.request</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_dept_req_list" name="Requests" parent="menu_department_requests" action="action_department_request" sequence="10"/>
</odoo>
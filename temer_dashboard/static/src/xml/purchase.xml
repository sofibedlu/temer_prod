<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="temer_dashboard.my_sales_summary" owl="1">
        <div class="container-fluid mt-4">
            <!-- Date filter section -->
            <div class="row mb-3">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-body p-2">
                            <div class="row">
                                <div class="col-md-5">
                                    <label class="form-label">From Date:</label>
                                    <input type="date" class="form-control"
                                        t-att-value="state.dateFilters.date_from"
                                        t-on-change="onDateFilterChange"
                                        name="date_from"/>
                                </div>
                                <div class="col-md-5">
                                    <label class="form-label">To Date:</label>
                                    <input type="date" class="form-control"
                                        t-att-value="state.dateFilters.date_to"
                                        t-on-change="onDateFilterChange"
                                        name="date_to"/>
                                </div>
                                <div class="col-md-2 d-flex align-items-end">
                                    <button class="btn btn-primary w-100" t-on-click="loadSalesData">
                                        <i class="fa fa-refresh"/> Apply
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <t t-if="state.errorMessage">
                <div class="alert alert-danger" role="alert">
                    <t t-esc="state.errorMessage"/>
                </div>
            </t>
            
            <div class="row">
                <t t-if="state.loading">
                    <div class="text-center">
                        <i class="fa fa-refresh fa-spin fa-2x"/>
                        <div>Loading sales summary...</div>
                    </div>
                </t>
                <t t-else="">
                    <div class="col-md-12">
                        <div class="row mb-4">
                            <!-- Prospect Card -->
                            <div class="col-md-2 col-6 mb-2">
                                <div class="card text-center p-2 bg-info-light" style="background-color: #e6f7ff; border-left: 4px solid #17a2b8;">
                                    <div class="text-muted">Prospects</div>
                                    <h3 class="text-info" t-esc="summary.prospect"/>
                                </div>
                            </div>
                            
                            <!-- Follow Up Card -->
                            <div class="col-md-2 col-6 mb-2">
                                <div class="card text-center p-2 bg-warning-light" style="background-color: #fff8e6; border-left: 4px solid #ffc107;">
                                    <div class="text-muted">Follow Up</div>
                                    <h3 class="text-warning" t-esc="summary.follow_up"/>
                                </div>
                            </div>
                            
                            <!-- Reservations Card -->
                            <div class="col-md-2 col-6 mb-2">
                                <div class="card text-center p-2 bg-primary-light" style="background-color: #f0f7ff; border-left: 4px solid #007bff;">
                                    <div class="text-muted">Reservations</div>
                                    <h3 class="text-primary" t-esc="summary.reservation_count"/>
                                </div>
                            </div>
                            
                            <!-- Sold Reservations Card -->
                            <div class="col-md-2 col-6 mb-2">
                                <div class="card text-center p-2 bg-purple-light" style="background-color: #f3e5ff; border-left: 4px solid #6f42c1;">
                                    <div class="text-muted">Sold</div>
                                    <h3 class="text-purple" t-esc="summary.sold_reservation_count"/>
                                </div>
                            </div>

                            <!-- Expired Card -->
                            <div class="col-md-2 col-6 mb-2">
                                <div class="card text-center p-2 bg-danger-light" style="background-color: #ffebee; border-left: 4px solid #dc3545;">
                                    <div class="text-muted">Expired</div>
                                    <h3 class="text-danger" t-esc="summary.expired"/>
                                </div>
                            </div>

                            <!-- Total Sum Card -->
                            <div class="col-md-2 col-6 mb-2">
                                <div class="card text-center p-2 bg-success-light" style="background-color: #e6ffed; border-left: 4px solid #28a745;">
                                    <div class="text-muted">Total</div>
                                    <h3 class="text-success" t-esc="summary.prospect + summary.follow_up + summary.reservation_count + summary.sold_reservation_count + summary.expired"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
            
            <style>
                /* Mobile specific styles */
                @media (max-width: 768px) {
                    .container-fluid {
                        overflow-y: auto;
                        max-height: 100vh;
                    }
                    
                    .card-body {
                        overflow-y: auto;
                        max-height: 40vh;
                    }
                    
                    .table-responsive {
                        display: block;
                        overflow-y: auto;
                        overflow-x: auto;
                        -webkit-overflow-scrolling: touch;
                        height: calc(100vh - 200px);
                        position: relative;
                    }
                    
                    .table-responsive table {
                        width: 100%;
                        min-width: 100%;
                        table-layout: fixed;
                    }
                    
                    .table-responsive table td {
                        word-wrap: break-word;
                    }
                    
                    .row.mb-4 > div[class^="col-"] {
                        margin-bottom: 0.5rem !important;
                        overflow-y: auto;
                        max-height: 20vh;
                    }
                    .container-fluid.mt-4 {
                        padding-left: 0.5rem !important;
                        padding-right: 0.5rem !important;
                        height: auto !important;
                    }
                    
                    .row.mb-4 > div[class^="col-"] {
                        margin-bottom: 0.5rem !important;
                    }
                    
                    .card-body {
                        padding: 0.5rem !important;
                        max-height: 50vh !important;
                        overflow-y: auto !important;
                        overflow-x: auto !important;
                        -webkit-overflow-scrolling: touch;
                    }
                    
                    .table-responsive {
                        width: 100%;
                        -webkit-overflow-scrolling: touch;
                    }
                    
                    /* Ensure table fits within container */
                    .table {
                        width: 100%;
                        min-width: 0 !important;
                    }
                }
                
                /* Desktop specific styles */
                @media (min-width: 769px) {
                    .container-fluid.mt-4 {
                        padding-left: 1rem !important;
                        padding-right: 1rem !important;
                    }
                    
                    .card-body {
                        max-height: 50vh !important;
                        overflow-y: auto !important;
                        overflow-x: auto !important;
                    }
                }
            </style>
        </div>
    </t>
</templates>
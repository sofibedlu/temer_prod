<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_print_letter_wizard_form" model="ir.ui.view">
        <field name="name">property.print.letter.wizard.form</field>
        <field name="model">property.print.letter.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Collection Letter">
                <group>
                    <group>
                        <field name="collection_id" invisible="1"/>
                        <field name="letter_type" widget="radio" options="{'horizontal': true}"/>
                        <field name="installment_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="letterhead_id" options="{'no_create': True, 'no_open': True}"/>
                    </group>
                    <group>
                        <field name="letter_date"/>
                        <field name="letter_number"/>
                    </group>           
                </group>
                <p class="text-muted">
                    Select the letter type and the unpaid milestone.
                </p>
                <footer>
                    <button name="action_print_letter" string="Print Letter" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Add to Action Menu -->
    <record id="action_print_letter_wizard" model="ir.actions.act_window">
        <field name="name">Payment Request Letter</field>
        <field name="res_model">property.print.letter.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_collection_order"/>
        <field name="binding_view_types">form</field>
        <field name="context">{'default_collection_id': active_id}</field>
    </record>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_collection_send_sms_wizard_form" model="ir.ui.view">
        <field name="name">collection.send.sms.wizard.form</field>
        <field name="model">collection.send.sms.wizard</field>
        <field name="arch" type="xml">
            <form string="Send SMS">
                <sheet>
                    <group>
                        <field name="collection_id" invisible="1"/>
                        <field name="installment_id" options="{'no_create': True}"/>
                        <field name="mobile_no" placeholder="+251..."/>
                        <field name="template_selection"/>
                    </group>
                    <group>
                        <field name="message" widget="text" placeholder="Type your message here..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_send_sms" string="Send SMS" type="object" class="btn-primary" icon="fa-mobile"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_collection_send_sms_wizard" model="ir.actions.act_window">
        <field name="name">Send SMS</field>
        <field name="res_model">collection.send.sms.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="collection_management.model_collection_order"/>
        <field name="binding_view_types">form</field>
    </record>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_payment_register_wizard_form" model="ir.ui.view">
        <field name="name">property.payment.register.wizard.form</field>
        <field name="model">property.payment.register.wizard</field>
        <field name="arch" type="xml">
            <form string="Register Payment">
                <group>
                    <group>
                        <field name="installment_id"/>
                        <field name="can_apply_discount" invisible="1"/>

                        <field name="apply_discount" widget="boolean_toggle" readonly="not can_apply_discount"/>
                        <label for="discount_percentage" invisible="not apply_discount"/>
                        <div class="o_row" invisible="not apply_discount">
                            <field name="discount_percentage" class="oe_inline"/>
                            <span>%</span>
                        </div>
                        <field name="discount_amount" invisible="not apply_discount" readonly="1" force_save="1"/>
                        <field name="amount" force_save="1"/>
                        <field name="reference"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="payment_date"/>
                        <field name="document_type_id"/>
                        <field name="bank_id"/>
                        <field name="reference_number"/>
                        <field name="payment_receipt" widget="binary_preview"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm_payment" string="Create Payment" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
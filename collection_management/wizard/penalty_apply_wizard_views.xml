<odoo>
    <record id="view_property_penalty_apply_wizard_form" model="ir.ui.view">
        <field name="name">property.penalty.apply.wizard.form</field>
        <field name="model">property.penalty.apply.wizard</field>
        <field name="arch" type="xml">
            <form string="Apply Penalty">
                <group>
                    <field name="collection_id" invisible="1"/>
                    <field name="installment_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="percent"/>
                    <field name="preview_amount" readonly="1" />
                    <field name="reason"/>
                </group>
                <footer>
                    <button name="action_confirm_apply" string="Apply Penalty" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_property_penalty_apply_wizard" model="ir.actions.act_window">
        <field name="name">Apply Penalty</field>
        <field name="res_model">property.penalty.apply.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" eval="False"/>
        <field name="context">{'default_collection_id': active_id}</field>
    </record>
</odoo>
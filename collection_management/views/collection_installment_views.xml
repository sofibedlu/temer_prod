<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Search View -->
    <record id="view_collection_installment_search" model="ir.ui.view">
        <field name="name">collection.installment.search</field>
        <field name="model">collection.installment</field>
        <field name="arch" type="xml">
            <search string="Search Installments">
                <field name="name" string="Installment Name"/>
                <field name="collection_id"/>
                <field name="partner_id"/>
                <field name="property_id"/>
                <field name="site_id"/>

                <separator/>
                <filter string="Overdue" name="overdue" domain="[('state', '=', 'overdue')]"/>
                <filter string="Unpaid" name="unpaid" domain="[('state', '=', 'unpaid')]"/>
                <filter string="Partial" name="partial" domain="[('state', '=', 'partial')]"/>
                <filter string="Paid" name="paid" domain="[('state', '=', 'paid')]"/>
                
                <separator/>
                <filter string="Due This Month" name="due_this_month" domain="[('due_date', '&gt;=', context_today().strftime('%Y-%m-01')), ('due_date', '&lt;', (context_today() + relativedelta(months=1)).strftime('%Y-%m-01'))]"/>

                <group expand="0" string="Group By">
                    <filter string="Installment Name" name="group_name" context="{'group_by': 'name'}"/>
                    <filter string="Site / Project" name="group_site" context="{'group_by': 'site_id'}"/>
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Property" name="group_property" context="{'group_by': 'property_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Due Date" name="group_due_date" context="{'group_by': 'due_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- 2. Analysis Tree View -->
    <record id="view_collection_installment_analysis_tree" model="ir.ui.view">
        <field name="name">collection.installment.analysis.tree</field>
        <field name="model">collection.installment</field>
        <field name="arch" type="xml">
            <tree string="Collection Details" decoration-success="state == 'paid'" decoration-danger="state == 'overdue'" decoration-warning="state == 'partial'" create="0" delete="0">
                <field name="collection_id" widget="many2one_clickable" string="Contract Ref"/>
                <field name="partner_id"/>
                <field name="site_id" optional="show"/>
                <field name="property_id" optional="hide"/>
                <field name="name" string="Installment"/>
                <field name="due_date"/>
                <field name="amount_total" sum="Total Expected" optional="hide"/>
                <field name="amount_paid" sum="Total Paid" optional="hide"/>
                <field name="amount_residual" sum="Total Pending"/>
                <field name="discount_amount" sum="Total Discount" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'paid'" decoration-danger="state == 'overdue'" decoration-info="state == 'unpaid'"/>
            </tree>
        </field>
    </record>

    <record id="view_collection_installment_form" model="ir.ui.view">
        <field name="name">collection.installment.form</field>
        <field name="model">collection.installment</field>
        <field name="arch" type="xml">
            <form string="Installment">
                <header>
                    <button name="action_open_payment_wizard"
                            string="Pay"
                            type="object"
                            class="btn-primary"
                            invisible="state == 'paid'"
                            groups="collection_management.group_collection_payment_initiator"/>
                    <button name="action_reset_penalty"
                            string="Reset Penalty"
                            type="object"
                            class="btn-secondary"
                            invisible="not penalty_applied"
                            groups="collection_management.group_collection_penalty_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="payment_schedule_type" invisible="1"/>
                            <field name="can_edit_due_date" invisible="1"/>

                            <field name="due_date"
                                readonly="not can_edit_due_date"
                                required="payment_schedule_type == 'time'"/>
                        </group>
                        <group>
                            <field name="amount_total" readonly="1"/>
                            <field name="amount_paid"/>
                            <field name="amount_residual"/>
                        </group>
                        <group string="Penalty" invisible="not penalty_applied">
                            <field name="penalty_amount"/>
                            <field name="penalty_applied" invisible="1"/>
                        </group>
                    </group>

                    <!-- Payment History Notebook -->
                    <notebook>
                        <page string="Payment History">
                            <field name="payment_ids" readonly="1">
                                <tree string="Payments" create="0" delete="0" edit="0">
                                    <field name="payment_date"/>
                                    <field name="amount"/>
                                    <field name="journal_type"/>
                                    <field name="fs_number" string="FS Number"/>
                                    <field name="reference"/>
                                    <field name="status"/>
                                    <field name="invoice_id" widget="many2one_clickable"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 4. Action -->
    <record id="action_collection_details" model="ir.actions.act_window">
        <field name="name">Collection Details</field>
        <field name="res_model">collection.installment</field>
        <field name="view_mode">tree,form,pivot,graph</field>
        <field name="view_id" ref="view_collection_installment_analysis_tree"/>
        <field name="search_view_id" ref="view_collection_installment_search"/>
        <field name="context">{'search_default_group_site': 1, 'search_default_unpaid': 1, 'search_default_overdue': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No installments found.
            </p>
            <p>
                Use this view to analyze pending payments, overdue installments, and group by Site or Customer.
            </p>
        </field>
    </record>

    <!-- 5. Menu Item -->
    <menuitem id="menu_collection_details"
              name="Collection Details"
              parent="collection_management.menu_collection_root"
              action="action_collection_details"
              sequence="20"/>
</odoo>

<odoo>
    <record id="view_collection_letterhead_tree" model="ir.ui.view">
        <field name="name">collection.letterhead.tree</field>
        <field name="model">collection.letterhead</field>
        <field name="arch" type="xml">
            <tree>
                <field name="header_title"/>
            </tree>
        </field>
    </record>

    <record id="view_collection_letterhead_form" model="ir.ui.view">
        <field name="name">collection.letterhead.form</field>
        <field name="model">collection.letterhead</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="header_title"/>
                        <field name="stamp_image" widget="image"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_collection_letterhead" model="ir.actions.act_window">
        <field name="name">Letter Heads</field>
        <field name="res_model">collection.letterhead</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Configuration Menu -->
    <record id="menu_collection_configuration" model="ir.ui.menu">
        <field name="name">Configuration</field>
        <field name="parent_id" ref="collection_management.menu_collection_root"/>
        <field name="sequence">90</field>
        <field name="groups_id" eval="[(6, 0, [ref('collection_management.group_collection_manager')])]"/>
    </record>

    <!-- Letter Heads Menu -->
    <menuitem id="menu_collection_letterhead"
              name="Letter Heads"
              parent="menu_collection_configuration"
              action="action_collection_letterhead"
              sequence="10"/>
</odoo>
<odoo>
    <record id="view_users_form_inherit_collection" model="ir.ui.view">
        <field name="name">res.users.form.inherit.collection</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Collection Access">
                    <group>
                        <field name="collection_site_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 1. Payment Request Template -->
        <record id="email_template_payment_request" model="mail.template">
            <field name="name">Collection: Payment Request</field>
            <field name="model_id" ref="collection_management.model_collection_installment"/>
            <field name="subject">Payment Request: {{ object.name }} - {{ object.collection_id.name }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>Dear <t t-out="object.partner_id.name"/>,</p>
                    <p>This is a reminder regarding the installment <strong><t t-out="object.name"/></strong> 
                    for contract <strong><t t-out="object.collection_id.name"/></strong>.</p>
                    <p>Please find the Payment Request Letter attached.</p>
                    <p>Regards,<br/>Collection Team</p>
                </div>
            </field>
        </record>

        <!-- 2. Warning Letter Template -->
        <record id="email_template_warning_letter" model="mail.template">
            <field name="name">Collection: Warning Letter</field>
            <field name="model_id" ref="collection_management.model_collection_installment"/>
            <field name="subject">URGENT: Warning Letter - {{ object.collection_id.name }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>Dear <t t-out="object.partner_id.name"/>,</p>
                    <p>We have not received payment for <strong><t t-out="object.name"/></strong>.</p>
                    <p>Please find the formal Warning Letter attached.</p>
                    <p>Regards,<br/>Collection Team</p>
                </div>
            </field>
        </record>

        <!-- 3. Termination Letter Template -->
        <record id="email_template_termination_letter" model="mail.template">
            <field name="name">Collection: Termination Letter</field>
            <field name="model_id" ref="collection_management.model_collection_installment"/>
            <field name="subject">NOTICE OF TERMINATION - {{ object.collection_id.name }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>Dear <t t-out="object.partner_id.name"/>,</p>
                    <p>Please find the attached Notice of Contract Termination regarding <strong><t t-out="object.collection_id.name"/></strong>.</p>
                    <p>Regards,<br/>Collection Team</p>
                </div>
            </field>
        </record>
    </data>
</odoo>
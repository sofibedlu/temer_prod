<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_site_construction_progress_form_inherit_custom" model="ir.ui.view">
        <field name="name">property.site.construction.progress.form.inherit.custom</field>
        <field name="model">property.site.construction.progress</field>
        <field name="inherit_id" ref="collection_progress_date_override.view_property_site_construction_progress_form_inherit_custom_date"/>
        <field name="arch" type="xml">

            <xpath expr="//button[@name='action_approve']" position="after">
                <button name="action_deny" 
                        type="object" 
                        string="Deny Progress" 
                        class="btn-danger" 
                        invisible="state != 'checked'"
                        groups="collection_management_customization.group_collection_progress_denier"/>
            </xpath>

            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="statusbar_visible">draft,checked,done,denied</attribute>
            </xpath>

            <xpath expr="//field[@name='progress_percentage']" position="attributes">
                <attribute name="readonly">state != 'draft'</attribute>
            </xpath>

            <xpath expr="//field[@name='site_id']" position="attributes">
                <attribute name="readonly">state in ['checked', 'done', 'denied']</attribute>
            </xpath>
            <xpath expr="//field[@name='payment_term_line_id']" position="attributes">
                <attribute name="readonly">state in ['checked', 'done', 'denied']</attribute>
            </xpath>
            <xpath expr="//field[@name='date']" position="attributes">
                <attribute name="readonly">state in ['done', 'denied']</attribute>
            </xpath>
            <xpath expr="//field[@name='description']" position="attributes">
                <attribute name="readonly">state in ['done', 'denied']</attribute>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Updated Installments" invisible="not installment_ids">
                    <field name="installment_ids">
                        <tree string="Updated Collections" create="0" edit="0" delete="0">
                            <field name="collection_id"/>
                            <field name="payment_term_line_id"/>
                            <field name="due_date"/>
                            <field name="due_date_ethiopian" optional="show"/>
                            <field name="amount_total" sum="Total"/>
                            <field name="amount_residual" sum="Total"/>
                            <field name="state" widget="badge" decoration-success="state == 'paid'"/>
                        </tree>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

    <record id="view_property_site_construction_progress_tree_inherit_custom" model="ir.ui.view">
        <field name="name">property.site.construction.progress.tree.inherit.custom</field>
        <field name="model">property.site.construction.progress</field>
        <field name="inherit_id" ref="collection_progress_integration.view_property_site_construction_progress_tree_inherit"/>
        <field name="arch" type="xml">

            <xpath expr="//tree" position="attributes">
                <attribute name="decoration-warning">state == 'checked'</attribute>
                <attribute name="decoration-danger">state == 'denied'</attribute>
            </xpath>

            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="column_invisible">False</attribute>
                <attribute name="widget">badge</attribute>
                <attribute name="decoration-success">state == 'done'</attribute>
                <attribute name="decoration-warning">state == 'checked'</attribute>
                <attribute name="decoration-danger">state == 'denied'</attribute>
                <attribute name="decoration-info">state == 'draft'</attribute>
            </xpath>

        </field>
    </record>
</odoo>
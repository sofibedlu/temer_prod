<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Editable Tree View only -->
    <record id="commercial_rate_range_view_tree" model="ir.ui.view">
        <field name="name">commercial.rate.range.tree</field>
        <field name="model">commercial.rate.range</field>
        <field name="arch" type="xml">
            <tree string="Commercial Rate Ranges" editable="bottom">
                <field name="rate_min" string="Min" width="150"/>
                <field name="rate_max" string="Max" width="150"/>
            </tree>
        </field>
    </record>

    <!-- Action: tree only, no form -->
    <record id="action_commercial_rate_range" model="ir.actions.act_window">
        <field name="name">Commercial Rate Range</field>
        <field name="res_model">commercial.rate.range</field>
        <field name="view_mode">tree</field>
    </record>

    <!-- Menu under Configuration -->
    <menuitem
        id="menu_commercial_rate_range"
        name="Commercial Rate Range"
        parent="advanced_property_management.property_configuration_menu"
        action="action_commercial_rate_range"
        sequence="25"/>

</odoo>

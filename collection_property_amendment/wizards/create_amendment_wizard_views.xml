<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_amendment_create_wizard" model="ir.ui.view">
        <field name="name">property.amendment.create.wizard.form</field>
        <field name="model">property.amendment.create.wizard</field>
        <field name="arch" type="xml">
            <form string="Request Property Amendment">
                <group>
                    <field name="site_id" invisible="1"/>
                    <field name="collection_order_id" readonly="1"/>
                    <field name="old_property_id" readonly="1"/>
                    <field name="new_property_id"/>
                </group>
                <group>
                    <field name="reason" placeholder="Explain the reason for changing the property..." required="1"/>
                </group>
                <group>
                    <field name="attachment_ids" widget="many2many_binary" string="Attach Documents"/>               
                </group>
                <footer>
                    <button name="action_create_request" string="Submit Request" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
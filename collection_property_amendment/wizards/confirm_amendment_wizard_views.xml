<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_amendment_confirm_wizard" model="ir.ui.view">
        <field name="name">property.amendment.confirm.wizard.form</field>
        <field name="model">property.amendment.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Property Amendment Transfer">
                <field name="amendment_request_id" invisible="1"/>

                <div class="oe_title w-100">
                    <field name="summary" readonly="1" nolabel="1" widget="html"/>
                </div>
                
                <footer>
                    <button name="action_confirm_transfer" string="Confirm Transfer" type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_amendment_reject_wizard" model="ir.ui.view">
        <field name="name">property.amendment.reject.wizard.form</field>
        <field name="model">property.amendment.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Amendment">
                <group>
                    <field name="amendment_request_id" invisible="1"/>
                    <field name="reason" placeholder="Please provide a reason for rejecting..." required="1"/>
                </group>
                <footer>
                    <button name="action_reject" string="Reject" type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="property_state_change_confirm_wizard_form" model="ir.ui.view">
        <field name="name">property.state.change.confirm.wizard.form</field>
        <field name="model">property.state.change.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm">
                <field name="property_ids" invisible="1"/>
                <field name="target_state" invisible="1"/>
                <div class="alert alert-warning mb-0" role="alert">
                    <field name="message" nolabel="1" readonly="1" widget="text"/>
                </div>
                <footer>
                    <button name="action_confirm" string="OK" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

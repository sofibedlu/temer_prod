<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Lead Distribution Manager Group -->
    <record id="group_lead_distribution_manager" model="res.groups">
        <field name="name">Lead Distribution Manager</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <!-- Record Rule: Managers see all records -->
    <record id="lead_distribution_manager_rule" model="ir.rule">
        <field name="name">Lead Distribution: Manager sees all</field>
        <field name="model_id" ref="model_lead_distribution"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('lead_distribution.group_lead_distribution_manager'))]"/>
    </record>

    <!-- Record Rule: Salesperson sees only own leads -->
    <record id="lead_distribution_salesperson_rule" model="ir.rule">
        <field name="name">Lead Distribution: Salesperson sees own leads</field>
        <field name="model_id" ref="model_lead_distribution"/>
        <field name="domain_force">[('assigned_salesperson_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>
</odoo>

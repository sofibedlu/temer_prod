<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Inherit Reservation Form to add Confirm Sales and assignment info -->
    <record id="view_property_reservation_form_inherit_contact_team" model="ir.ui.view">
        <field name="name">property.reservation.form.contact.team.inherit</field>
        <field name="model">property.reservation</field>
        <field name="inherit_id" ref="ahadubit_property_reservation.property_reservation_history_view_form_id"/>
        <field name="arch" type="xml">
            <!-- Add Confirm Sales button for supervisor/manager/show-all only, not for quick reservation -->
            <xpath expr="//header/button[@name='sale_property_reserved']" position="before">
                <button name="action_confirm_sales"
                        string="Confirm Sales"
                        type="object"
                        class="btn-primary"
                        invisible="status != 'reserved' or is_quick_reservation == True"
                        groups="temer_structure.access_property_sales_supervisor_group,temer_structure.access_property_sales_team_manager_group,temer_reservation_contact_team.group_assigned_sales_show_all"/>
            </xpath>
            <xpath expr="//header/button[@name='sale_property_reserved']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Allow all users to add payment lines -->
            <xpath expr="//field[@name='payment_line_ids']" position="attributes">
                <attribute name="readonly">0</attribute>
            </xpath>

            <!-- Expose is_quick_reservation for invisible condition -->
            <xpath expr="//field[@name='is_creator']" position="after">
                <field name="is_quick_reservation" invisible="1"/>
            </xpath>

            <!-- Show assigned contract admin on the form -->
            <xpath expr="//group/field[@name='canceled_time']" position="after">
                <group string="Contract Admin Assignment" invisible="not assigned_user_id">
                    <field name="assigned_user_id" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Extend is_verifed toggle visibility to supervisor and sales manager
         (targets temer_structure's payment page replacement) -->
    <record id="view_reservation_payment_verifed_groups_inherit" model="ir.ui.view">
        <field name="name">property.reservation.payment.verifed.groups.inherit</field>
        <field name="model">property.reservation</field>
        <field name="inherit_id" ref="temer_structure.property_reservation_history_view_form_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_verifed']" position="attributes">
                <attribute name="groups">ahadubit_property_reservation.finance_team_approval_group,temer_structure.access_property_sales_supervisor_group,temer_structure.access_property_sales_team_manager_group</attribute>
            </xpath>
            <!-- Allow all users to add payment lines regardless of status -->
            <xpath expr="//field[@name='payment_line_ids']" position="attributes">
                <attribute name="readonly">0</attribute>
            </xpath>
        </field>
    </record>
</odoo>

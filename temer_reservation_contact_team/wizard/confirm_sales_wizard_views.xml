<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_confirm_sales_wizard_form" model="ir.ui.view">
        <field name="name">reservation.confirm.sales.wizard.form</field>
        <field name="model">reservation.confirm.sales.wizard</field>
        <field name="arch" type="xml">
            <form string="Sales Confirmed">
                <sheet>
                    <group>
                        <field name="message" nolabel="1" readonly="1" class="mb-3"/>
                        <field name="reservation_id" invisible="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_ok" string="OK" type="object" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

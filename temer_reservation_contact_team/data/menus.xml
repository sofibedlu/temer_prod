<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Give team groups access to root Property Management app -->
    <record id="advanced_property_management.property_root_menu" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('temer_reservation_contact_team.group_reservation_contact_team')),
                                       (4, ref('temer_reservation_contact_team.group_assigned_sales_show_mine')),
                                       (4, ref('temer_reservation_contact_team.group_assigned_sales_show_all'))]"/>
    </record>

    <!-- Give team groups access to the Configuration menu -->
    <record id="advanced_property_management.property_configuration_menu" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('temer_reservation_contact_team.group_reservation_contact_team')),
                                       (4, ref('temer_reservation_contact_team.group_assigned_sales_show_mine')),
                                       (4, ref('temer_reservation_contact_team.group_assigned_sales_show_all'))]"/>
    </record>

    <!-- Give team groups access to the Reservation submenu only -->
    <record id="ahadubit_property_reservation.property_reserveation_config_menu" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('temer_reservation_contact_team.group_reservation_contact_team')),
                                       (4, ref('temer_reservation_contact_team.group_assigned_sales_show_mine')),
                                       (4, ref('temer_reservation_contact_team.group_assigned_sales_show_all'))]"/>
    </record>

    <!-- Restrict all other direct config submenus to manager groups only -->
    <record id="ahadubit_property_base.property_config_menu" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [
            ref('temer_structure.access_property_reservation_manager_group'),
            ref('temer_structure.access_property_stock_manager_group'),
            ref('temer_structure.access_property_contract_admin_group'),
        ])]"/>
    </record>
    <record id="ahadubit_property_base.property_config_location_menu" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [
            ref('temer_structure.access_property_reservation_manager_group'),
            ref('temer_structure.access_property_stock_manager_group'),
            ref('temer_structure.access_property_contract_admin_group'),
        ])]"/>
    </record>
    <record id="ahadubit_property_base.property_payment_menu" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [
            ref('temer_structure.access_property_reservation_manager_group'),
            ref('temer_structure.access_property_stock_manager_group'),
            ref('temer_structure.access_property_contract_admin_group'),
        ])]"/>
    </record>
    <record id="ahadubit_property_base.menu_property_configuration" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [
            ref('temer_structure.access_property_reservation_manager_group'),
            ref('temer_structure.access_property_stock_manager_group'),
            ref('temer_structure.access_property_contract_admin_group'),
        ])]"/>
    </record>
</odoo>

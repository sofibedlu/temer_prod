<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="team_dashboard.my_sales_summary" owl="1">
        <div class="container mt-4">
            <!-- Date filter (From and To) -->
            <!-- <div class="mb-3">
                <div class="input-group">
                    <span class="input-group-text">From</span>
                    <input type="date" class="form-control"
                        t-att-value="state.dateFilters.startDate"
                        t-on-change="onStartDateChange"/>
                    <span class="input-group-text">To</span>
                    <input type="date" class="form-control"
                        t-att-value="state.dateFilters.endDate"
                        t-on-change="onDateChange"/>
                    <button class="btn btn-primary" t-on-click="applyDateFilter">Apply</button>
                </div>
            </div> -->
            
            <t t-if="state.loading">
                <div class="text-center">
                    <i class="fa fa-refresh fa-spin fa-2x"/>
                    <div>Loading sales summary...</div>
                </div>
            </t>
            <t t-else="">
                <div class="row mb-4">
                    <!-- Prospect Card -->
                    <div class="col-md-2">
                        <div class="card text-center p-2 bg-info-light" style="background-color: #e6f7ff; border-left: 4px solid #17a2b8;">
                            <div class="text-muted">Prospects</div>
                            <h3 class="text-info" t-esc="summary.prospect"/>
                        </div>
                    </div>
                    
                    <!-- Follow Up Card -->
                    <div class="col-md-2">
                        <div class="card text-center p-2 bg-warning-light" style="background-color: #fff8e6; border-left: 4px solid #ffc107;">
                            <div class="text-muted">Follow Up</div>
                            <h3 class="text-warning" t-esc="summary.follow_up"/>
                        </div>
                    </div>
                    
                    <!-- Won Card -->
                    <div class="col-md-2">
                        <div class="card text-center p-2 bg-success-light" style="background-color: #e6ffed; border-left: 4px solid #28a745;">
                            <div class="text-muted">Won</div>
                            <h3 class="text-success" t-esc="summary.won"/>
                        </div>
                    </div>
                    
                    <!-- Expired Card -->
                    <div class="col-md-2">
                        <div class="card text-center p-2 bg-danger-light" style="background-color: #ffebee; border-left: 4px solid #dc3545;">
                            <div class="text-muted">Expired</div>
                            <h3 class="text-danger" t-esc="summary.expired"/>
                        </div>
                    </div>
                    
                    <!-- Reservations Card -->
                    <div class="col-md-2">
                        <div class="card text-center p-2 bg-primary-light" style="background-color: #f0f7ff; border-left: 4px solid #007bff;">
                            <div class="text-muted">Reservations</div>
                            <h3 class="text-primary" t-esc="summary.reservation_count"/>
                        </div>
                    </div>
                    
                    <!-- Sold Reservations Card -->
                    <div class="col-md-2">
                        <div class="card text-center p-2 bg-purple-light" style="background-color: #f3e5ff; border-left: 4px solid #6f42c1;">
                            <div class="text-muted">Sold Reservations</div>
                            <h3 class="text-purple" t-esc="summary.sold_reservation_count"/>
                        </div>
                    </div>
                </div>
                
                <div class="card shadow-sm">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">My Sales Performance</h5>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-hover mb-0">
                            <thead class="thead-light">
                                <tr>
                                    <th>Metric</th>
                                    <th>Count</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Prospects</td>
                                    <td t-esc="summary.prospect"/>
                                    <td><span class="badge badge-info">New Leads</span></td>
                                </tr>
                                <tr>
                                    <td>Follow Up</td>
                                    <td t-esc="summary.follow_up"/>
                                    <td><span class="badge badge-warning">Pending</span></td>
                                </tr>
                                <tr>
                                    <td>Won</td>
                                    <td t-esc="summary.won"/>
                                    <td><span class="badge badge-success">Completed</span></td>
                                </tr>
                                <tr>
                                    <td>Expired</td>
                                    <td t-esc="summary.expired"/>
                                    <td><span class="badge badge-danger">Lost</span></td>
                                </tr>
                                <tr>
                                    <td>Reservations</td>
                                    <td t-esc="summary.reservation_count"/>
                                    <td><span class="badge badge-primary">Held</span></td>
                                </tr>
                                <tr>
                                    <td>Sold Reservations</td>
                                    <td t-esc="summary.sold_reservation_count"/>
                                    <td><span class="badge" style="background-color: #6f42c1; color: white;">Converted</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </t>
            
            <style>
                @media (max-width: 768px) {
                    .row.mb-4 > .col-md-2,
                    .row.mb-4 > .col-md-4,
                    .row.mb-4 > .col-md-3 {
                        margin-bottom: 1rem !important;
                    }
                    .container.mt-4 {
                        padding-left: 0.5rem !important;
                        padding-right: 0.5rem !important;
                        overflow-y: auto !important;
                        max-height: 90vh;
                    }
                }
            </style>
        </div>
    </t>
</templates>
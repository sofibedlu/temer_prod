<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="team_dashboard.wing_dashboard_jjokachabc" owl="1">
        <div class="container-fluid p-3" style="background-color: #f8f9fa; height: 100vh; overflow-y: auto;">
            <!-- Loading Indicator -->
            <t t-if="state.loading">
                <div class="alert alert-info text-center" style="background-color: #e3f2fd; border-color: #90caf9; color: #1565c0;">
                    Loading dashboard data...
                </div>
            </t>

            <!-- Empty State -->
            <t t-if="!state.loading and !state.detailedSalesPerformance.length">
                <div class="alert alert-warning text-center" style="background-color: #fff3e0; border-color: #ffcc80; color: #ef6c00;">
                    No data available for the selected filters. Please try adjusting the wing, supervisor, or date range.
                </div>
            </t>

            <!-- Dashboard Header -->
            <div class="row mb-4" t-if="!state.loading">
                <div class="col-md-12">
                    <div class="card bg-gradient-primary text-white shadow-lg">
                        <div class="card-body py-3">
                            <h2 class="mb-0"><i class="fa fa-chart-line me-2"></i>Team Taj</h2>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-3">


 <DateTimeInput
                        type="'date'"
                        value="state.startDate"
                        placeholder="'Date From'"
                        onChange="(date) => this.set_date_from(date)"

                    />
                    To

                        <DateTimeInput
                    type="'date'"
                     value="state.endDate"
                    placeholder="'Date to'"
                    onChange="(date) => this.set_date_to(date)"

                    
                />
                           



                        <div class="btn-group shadow-sm">
                            
                            <!-- <button t-att-class="'btn btn-sm ' + (state.filters.dateRange === '7days' ? 'btn-info text-white' : 'btn-light')"
                                    t-on-click="() => setFilter('dateRange', '7days')">
                                <i class="fa fa-calendar-week me-1"></i>7 Days
                            </button>
                            <button t-att-class="'btn btn-sm ' + (state.filters.dateRange === '30days' ? 'btn-info text-white' : 'btn-light')"
                                    t-on-click="() => setFilter('dateRange', '30days')">
                                <i class="fa fa-calendar-alt me-1"></i>30 Days
                            </button>
                            <button t-att-class="'btn btn-sm ' + (state.filters.dateRange === '90days' ? 'btn-info text-white' : 'btn-light')"
                                    t-on-click="() => setFilter('dateRange', '90days')">
                                <i class="fa fa-calendar me-1"></i>90 Days
                            </button> -->
                        </div>
                        <div class="d-flex">
                            <!-- Wing Filter -->
                            <!-- <select class="form-select form-select-sm me-2 shadow-sm" style="width: 180px; background-color: #e3f2fd;"
                                    t-on-change="setWingFilter">
                                <option value="">All Wings</option>
                                <t t-foreach="state.wingSummary" t-as="wing" t-key="wing.name">
                                    <option t-att-value="wing.name" t-att-selected="state.filters.wing === wing.name">
                                        <t t-if="wing.has_issue">⚠️ </t>
                                        <t t-esc="wing.name"/>
                                    </option>
                                </t>
                            </select> -->
                            <select
    class="form-select form-select-sm me-2 shadow-sm"
    style="width: 180px; background-color: #e3f2fd;"
    t-att-disabled="state.isManager"
    t-on-change="(ev) => this.setWingFilter(ev)">
    <option value="">All Wings</option>
    <t t-foreach="state.wingSummary" t-as="wing" t-key="wing.name">
        <option t-att-value="wing.name" t-att-selected="state.filters.wing === wing.name">
            <t t-if="wing.has_issue">⚠️ </t><t t-esc="wing.name"/>
        </option>
    </t>
</select>


                            <select class="form-select form-select-sm shadow-sm" style="width: 220px; background-color: #e3f2fd;"
        t-att-disabled="!state.wingSummary.length"
        t-on-change="(ev) => this.setSupervisorFilter(ev)">
    <option value="">All Supervisors</option>
    <t t-foreach="state.supervisorSummary" t-as="supervisor" t-key="supervisor.name">
        <option t-att-value="supervisor.name" t-att-selected="state.filters.supervisor === supervisor.name">
            <t t-esc="supervisor.name"/> (<t t-esc="supervisor.wing_name"/>)
        </option>
    </t>
</select>

                        </div>
                    </div>
                </div>
            </div>

            <!-- Main Content Row -->
            <div class="row" t-if="!state.loading and state.detailedSalesPerformance.length">
                <!-- Wing Summary -->
                <div class="col-lg-4 mb-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-header bg-gradient-success text-white">
                            <h5 class="mb-0"><i class="fa fa-building me-2"></i>Wing Summary</h5>
                        </div>
                        <div class="card-body p-0" style="max-height: 300px; overflow-y: auto;">
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Wing</th>
                                            <th class="text-end">Leads</th>
                                            <th class="text-end">Supervisors</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="state.wingSummary" t-as="wing" t-key="wing.name">
                                            <tr t-on-click="() => setFilter('wing', wing.name)" 
                                                t-att-class="'hover-row ' + (state.filters.wing === wing.name ? 'table-active' : '') + (wing.has_issue ? ' table-warning' : '')">
                                                <td>
                                                    <t t-if="wing.has_issue">⚠️ </t>
                                                    <a href="#" t-on-click.prevent="() => openWingDetails(wing.name)" class="text-decoration-none">
                                                        <t t-esc="wing.name"/>
                                                    </a>
                                                </td>
                                                <td class="text-end fw-bold" t-att-class="wing.totalLeads > 50 ? 'text-success' : 'text-primary'">
                                                    <t t-esc="wing.totalLeads"/>
                                                </td>
                                                <td class="text-end">
                                                    <span class="badge bg-info rounded-pill"><t t-esc="wing.supervisors"/></span>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="card-footer bg-light">
                            <small class="text-muted">Click on a wing to filter</small>
                        </div>
                    </div>
                </div>

                <!-- Performance Overview Table (col-lg-8) -->
                <div class="col-lg-8 mb-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-header bg-gradient-primary text-white">
                            <h5 class="mb-0"><i class="fa fa-table me-2"></i>Performance Overview</h5>
                        </div>
                        <div class="card-body p-2" style="max-height: 300px; overflow-y: auto;">
                            <div class="table-responsive border rounded bg-white p-2">
                                <table class="table table-hover table-striped table-bordered table-sm mb-0 text-center">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Category</th>
                                            <th>Count</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr><td>Won</td>         <td class="fw-bold"><t t-esc="sumByCategory('won_count')"/></td></tr>
                                        <tr><td>Expired</td>     <td class="fw-bold"><t t-esc="sumByCategory('expired_count')"/></td></tr>
                                        <tr><td>Prospect</td>    <td class="fw-bold"><t t-esc="sumByCategory('prospect_count')"/></td></tr>
                                        <tr><td>Reservation</td> <td class="fw-bold"><t t-esc="sumByCategory('reservation_count')"/></td></tr>
                                        <tr><td>Follow Up</td>   <td class="fw-bold"><t t-esc="sumByCategory('follow_up_count')"/></td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="card-footer bg-light">
                            <div class="row text-center">
                                <div class="col">
                                    <span class="badge bg-success me-2">■</span>
                                    <span>Won: <t t-esc="sumByCategory('won_count')"/></span>
                                </div>
                                <div class="col">
                                    <span class="badge bg-danger me-2">■</span>
                                    <span>Expired: <t t-esc="sumByCategory('expired_count')"/></span>
                                </div>
                                <div class="col">
                                    <span class="badge bg-primary me-2">■</span>
                                    <span>Prospect: <t t-esc="sumByCategory('prospect_count')"/></span>
                                </div>
                                <div class="col">
                                    <span class="badge bg-info me-2">■</span>
                                    <span>Reservation: <t t-esc="sumByCategory('reservation_count')"/></span>
                                </div>
                                <div class="col">
                                    <span class="badge bg-warning me-2">■</span>
                                    <span>Follow Up: <t t-esc="sumByCategory('follow_up_count')"/></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Supervisor and Sales Person Tables -->
            <div class="row" t-if="!state.loading and state.detailedSalesPerformance.length">
                <!-- Supervisor Table -->
                <div class="col-md-6 mb-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-header bg-gradient-info text-white d-flex justify-content-between align-items-center">
                            <h5 class="mb-0"><i class="fa fa-user-tie me-2"></i>Supervisor Performance</h5>
                            <span class="badge bg-light text-dark"><t t-esc="state.supervisorSummary.length"/> Supervisors</span>
                        </div>
                        <div class="card-body p-0" style="max-height: 300px; overflow-y: auto;">
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Supervisor</th>
                                            <th class="text-end">Leads</th>
                                            <th class="text-end">Wing</th>
                                            <th class="text-end">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="state.supervisorSummary" t-as="supervisor" t-key="supervisor.name">
                                            <tr class="hover-row">
                                                <td>
                                                    <a href="#" t-on-click.prevent="() => viewSupervisorDetails(supervisor.name)" class="text-decoration-none">
                                                        <i class="fa fa-user-tie text-info me-2"></i><t t-esc="supervisor.name"/>
                                                    </a>
                                                </td>
                                                <td class="text-end">
                                                    <span t-att-class="supervisor.totalLeads > 30 ? 'badge bg-success' : 'badge bg-primary'">
                                                        <t t-esc="supervisor.totalLeads"/>
                                                    </span>
                                                </td>
                                                <td class="text-end">
                                                    <small class="text-muted"><t t-esc="supervisor.wing_name"/></small>
                                                </td>
                                                <td class="text-end">
                                                    <button class="btn btn-sm btn-outline-info" t-on-click="() => setFilter('supervisor', supervisor.name)">
                                                        <i class="fa fa-filter"></i> Filter
                                                    </button>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Sales Person Table -->
                <div class="col-md-6 mb-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-header bg-gradient-warning text-white d-flex justify-content-between align-items-center">
                            <h5 class="mb-0"><i class="fa fa-users me-2"></i>Sales Team</h5>
                            <span class="badge bg-light text-dark"><t t-esc="state.detailedSalesPerformance.length"/> Sales Persons</span>
                        </div>
                        <div class="card-body p-0" style="max-height: 300px; overflow-y: auto;">
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Sales Person</th>
                                            <!-- <th class="text-end">Won</th>
                                            <th class="text-end">Expired</th>
                                            <th class="text-end">Prospect</th>
                                            <th class="text-end">Actions</th> -->
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="state.detailedSalesPerformance" t-as="row" t-key="row.sales_person">
                                            <tr class="hover-row">
                                                <td>
                                                    <a href="#" t-on-click.prevent="() => openRelatedSales(row.sales_person)" class="text-decoration-none">
                                                        <i class="fa fa-user text-warning me-2"></i><t t-esc="row.sales_person"/>
                                                    </a>
                                                </td>
                                                <!-- <td class="text-end">
                                                    <a href="#" t-on-click.prevent="() => openRelatedSales(row.sales_person, 'Won')" 
                                                       class="text-decoration-none" t-att-class="row.won_count > 10 ? 'text-success fw-bold' : 'text-success'">
                                                        <t t-esc="row.won_count || 0"/>
                                                    </a>
                                                </td>
                                                <td class="text-end">
                                                    <a href="#" t-on-click.prevent="() => openRelatedSales(row.sales_person, 'Expired')" 
                                                       class="text-decoration-none" t-att-class="row.expired_count > 5 ? 'text-danger fw-bold' : 'text-danger'">
                                                        <t t-esc="row.expired_count || 0"/>
                                                    </a>
                                                </td>
                                                <td class="text-end">
                                                    <a href="#" t-on-click.prevent="() => openRelatedSales(row.sales_person, 'Prospect')" 
                                                       class="text-decoration-none" t-att-class="row.prospect_count > 20 ? 'text-primary fw-bold' : 'text-primary'">
                                                        <t t-esc="row.prospect_count || 0"/>
                                                    </a>
                                                </td>
                                                <td class="text-end">
                                                    <button class="btn btn-sm btn-outline-warning" t-on-click="() => openRelatedSales(row.sales_person)">
                                                        <i class="fa fa-eye"></i> View
                                                    </button>
                                                </td> -->
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <style>
                .bg-gradient-primary {
                    background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
                }
                .bg-gradient-success {
                    background: linear-gradient(135deg, #1cc88a 0%, #13855c 100%);
                }
                .bg-gradient-info {
                    background: linear-gradient(135deg, #36b9cc 0%, #258391 100%);
                }
                .bg-gradient-warning {
                    background: linear-gradient(135deg, #f6c23e 0%, #daa520 100%);
                }
                .hover-row:hover {
                    background-color: rgba(0, 0, 0, 0.03);
                    cursor: pointer;
                }
                .card {
                    border-radius: 0.5rem;
                    overflow: hidden;
                }
                .card-header {
                    border-bottom: none;
                }
                .table th {
                    border-top: none;
                }
                /* Make compact table cells */
                .table-sm th, .table-sm td { padding: .4rem .6rem; }
                /* Hover and striped backgrounds are already provided by Bootstrap classes */
                /* Table hover highlight */
    .table-hover tbody tr:hover {
        background-color: #e9ecef;
    }
    /* Center text and bold counts */
    .table text-center td { text-align: center; }
    .table .fw-bold { font-weight: 700; }
            </style>
        </div>
    </t>
</templates>
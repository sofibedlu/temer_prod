<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partial_void_wizard_form" model="ir.ui.view">
        <field name="name">partial.void.wizard.form</field>
        <field name="model">partial.void.wizard</field>
        <field name="arch" type="xml">
            <form string="Request Partial Void">
                <div class="alert alert-warning" role="alert">
                    Select the units the customer wishes to drop. This will restore the units to 'Available' inventory and recalculate the merged parent property. <b>Contract financials must be amended manually after approval.</b>
                </div>
                <group>
                    <field name="collection_id" invisible="1"/>
                    <field name="parent_property_id" readonly="1"/>
                    <field name="reason" placeholder="Explanation for unit reduction..."/>
                    <field name="attachment_ids" widget="many2many_binary"/>
                </group>
                <notebook>
                    <page string="Select Units to Drop">
                        <field name="line_ids">
                            <tree editable="bottom">
                                <field name="child_property_id" domain="[('parent_property_id', '=', parent.parent_property_id)]" options="{'no_create': True}"/>
                                <field name="gross_area"/>
                                <field name="unit_price"/>
                                <field name="currency_id" column_invisible="True"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button name="action_create_request" type="object" string="Submit Request" class="btn-danger" icon="fa-cut"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_partial_void_wizard" model="ir.actions.act_window">
        <field name="name">Partial Void Request</field>
        <field name="res_model">partial.void.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partial_void_reject_wizard_form" model="ir.ui.view">
        <field name="name">partial.void.reject.wizard.form</field>
        <field name="model">partial.void.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Partial Void Request">
                <group>
                    <field name="request_id" invisible="1"/>
                    <field name="reason" placeholder="Please provide a reason for rejecting this partial void..."/>
                </group>
                <footer>
                    <button string="Confirm Rejection" name="action_confirm_reject" type="object" class="btn-danger" icon="fa-times"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
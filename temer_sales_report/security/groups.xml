<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_temer_sales_report_user" model="res.groups">
        <field name="name">Sales Report User</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <data noupdate="1">
        <!-- Sales Report User can see ALL leads (overrides the "own leads only" rule) -->
        <record id="temer_lead_report_user_rule" model="ir.rule">
            <field name="name">Temer Lead Report User: All Leads</field>
            <field name="model_id" ref="temer_crm.model_temer_lead"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('temer_sales_report.group_temer_sales_report_user'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- Sales Report User can see ALL followups -->
        <record id="temer_lead_followup_report_user_rule" model="ir.rule">
            <field name="name">Temer Lead Followup Report User: All Followups</field>
            <field name="model_id" ref="temer_crm.model_temer_lead_followup"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('temer_sales_report.group_temer_sales_report_user'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- Reservation report users can read and update reservation history. -->
        <record id="property_reservation_report_user_rule" model="ir.rule">
            <field name="name">Property Reservation Report User: Read/Write All</field>
            <field name="model_id" ref="ahadubit_property_reservation.model_property_reservation"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('temer_sales_report.group_temer_sales_report_user'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="property_reservation_payment_report_user_rule" model="ir.rule">
            <field name="name">Property Reservation Payment Report User: Read All</field>
            <field name="model_id" ref="ahadubit_property_reservation.model_property_reservation_payment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('temer_sales_report.group_temer_sales_report_user'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- All confirmed-and-beyond sales visible for Sales Deal Closed report -->
        <record id="property_sale_report_user_rule" model="ir.rule">
            <field name="name">Property Sale Report User: Read All</field>
            <field name="model_id" ref="advanced_property_management.model_property_sale"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('temer_sales_report.group_temer_sales_report_user'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>
    </data>

    <record id="property_reservation_report_user_write_rule" model="ir.rule">
        <field name="name">Property Reservation Report User: Write All</field>
        <field name="model_id" ref="ahadubit_property_reservation.model_property_reservation"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('temer_sales_report.group_temer_sales_report_user'))]"/>
        <field name="perm_read">0</field>
        <field name="perm_write">1</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>
</odoo>

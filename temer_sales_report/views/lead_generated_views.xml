<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_temer_lead_generated_tree" model="ir.ui.view">
        <field name="name">temer.lead.generated.tree</field>
        <field name="model">temer.lead</field>
        <field name="arch" type="xml">
            <tree string="Lead Generated" create="false" delete="false" edit="false">
                <header>
                    <button string="Export Excel" name="action_temer_export_lead_generated" type="object" display="always"/>
                </header>
                <field name="report_wing_display" string="Wing Name"/>
                <field name="report_supervisor_display" string="Sales Supervisor"/>
                <field name="user_id" string="Sales Consultant"/>
                <field name="report_fiscal_year" string="Fiscal Year"/>
                <field name="report_period" string="Period"/>
                <field name="report_date_display" string="Date"/>
                <field name="source_ids" string="Lead Source"/>
                <field name="name" string="Lead"/>
            </tree>
        </field>
    </record>

    <record id="view_temer_lead_generated_search" model="ir.ui.view">
        <field name="name">temer.lead.generated.search</field>
        <field name="model">temer.lead</field>
        <field name="arch" type="xml">
            <search string="Lead Generated">
                <!-- Search fields -->
                <field name="user_id" string="Sales Consultant"/>
                <field name="source_ids" string="Lead Source"/>
                <field name="create_date" string="Date"/>

                <!-- Filters -->
                <filter string="Prospect" name="filter_prospect" domain="[('state','=','prospect')]"/>
                <filter string="Follow Up" name="filter_follow_up" domain="[('state','=','follow_up')]"/>
                <filter string="Reserved" name="filter_reserved" domain="[('state','=','reservation')]"/>

                <!-- Group By -->
                <separator/>
                <filter string="Sales Consultant" name="group_user" context="{'group_by': 'user_id'}"/>
                <filter string="Lead Source" name="group_source" context="{'group_by': 'source_ids'}"/>
                <filter string="Fiscal Year" name="group_fiscal_year" context="{'group_by': 'create_date:year'}"/>
                <filter string="Period" name="group_period" context="{'group_by': 'create_date:month'}"/>
                <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_temer_lead_generated" model="ir.actions.act_window">
        <field name="name">Lead Generated</field>
        <field name="res_model">temer.lead</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_temer_lead_generated_tree"/>
        <field name="search_view_id" ref="view_temer_lead_generated_search"/>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

</odoo>
